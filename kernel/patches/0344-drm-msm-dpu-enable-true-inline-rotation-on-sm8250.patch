From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Fri, 28 Nov 2026 07:40:00 -0800
Subject: [PATCH] drm/msm/dpu: enable true inline rotation on SM8250

SM8250's DPU (6.0) has the SSPP true inline rotator on its four VIG
pipes as revision v1.0.0, but the catalog does not declare it. msm_sde
(kona) enables it with these limits: UBWC NV12 and UBWC TP10 only, at
most 1088 source lines, and no pre-downscaler (v2.0.0 adds RGB, P010
and the pre-downscaler). It programs the rotation as v2 does, with the
ROT90 bit in SSPP_SRC_FORMAT.

Declare it on VIG0-3 with UBWC NV12, the format iris decodes into on
this SoC, so a 90-degree video plane on a portrait panel can be rotated
by the pipe. TP10 is left out: the rotator's format check matches the
fourcc, which cannot tell UBWC TP10 from UBWC P010. Packed RGB keeps
going to the offline rotator.

Tested on a Retroid Pocket 5 (1080x1920 panel) with atomic commits from a
test client: a frame iris decoded into UBWC NV12 (Q08C, 3153920 bytes at
1920x1080, the same layout) was shown unrotated, at 90 and at 270 degrees
on VIG0 and looked right; UBWC NV12 at 90 and 270 is accepted, linear NV12
and a 1200-line source are refused, and no underrun or fault was logged.

Signed-off-by: sunshineinabox <aqemail@gmail.com>
---
 drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_6_0_sm8250.h | 16 ++++++++--------
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c         | 18 ++++++++++++++++++
 2 files changed, 26 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_6_0_sm8250.h b/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_6_0_sm8250.h
index 0e311d5..b4c02e2 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_6_0_sm8250.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_6_0_sm8250.h
@@ -67,32 +67,32 @@ static const struct dpu_sspp_cfg sm8250_sspp[] = {
 	{
 		.name = "sspp_0", .id = SSPP_VIG0,
 		.base = 0x4000, .len = 0x1f8,
-		.features = VIG_SDM845_MASK_SDMA,
-		.sblk = &dpu_vig_sblk_qseed3_3_0,
+		.features = VIG_SM8550_MASK_SDMA,
+		.sblk = &dpu_vig_sblk_qseed3_3_0_rot_v1,
 		.xin_id = 0,
 		.type = SSPP_TYPE_VIG,
 		.clk_ctrl = DPU_CLK_CTRL_VIG0,
 	}, {
 		.name = "sspp_1", .id = SSPP_VIG1,
 		.base = 0x6000, .len = 0x1f8,
-		.features = VIG_SDM845_MASK_SDMA,
-		.sblk = &dpu_vig_sblk_qseed3_3_0,
+		.features = VIG_SM8550_MASK_SDMA,
+		.sblk = &dpu_vig_sblk_qseed3_3_0_rot_v1,
 		.xin_id = 4,
 		.type = SSPP_TYPE_VIG,
 		.clk_ctrl = DPU_CLK_CTRL_VIG1,
 	}, {
 		.name = "sspp_2", .id = SSPP_VIG2,
 		.base = 0x8000, .len = 0x1f8,
-		.features = VIG_SDM845_MASK_SDMA,
-		.sblk = &dpu_vig_sblk_qseed3_3_0,
+		.features = VIG_SM8550_MASK_SDMA,
+		.sblk = &dpu_vig_sblk_qseed3_3_0_rot_v1,
 		.xin_id = 8,
 		.type = SSPP_TYPE_VIG,
 		.clk_ctrl = DPU_CLK_CTRL_VIG2,
 	}, {
 		.name = "sspp_3", .id = SSPP_VIG3,
 		.base = 0xa000, .len = 0x1f8,
-		.features = VIG_SDM845_MASK_SDMA,
-		.sblk = &dpu_vig_sblk_qseed3_3_0,
+		.features = VIG_SM8550_MASK_SDMA,
+		.sblk = &dpu_vig_sblk_qseed3_3_0_rot_v1,
 		.xin_id = 12,
 		.type = SSPP_TYPE_VIG,
 		.clk_ctrl = DPU_CLK_CTRL_VIG3,
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
index 668a9ce..7c09840 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
@@ -193,6 +193,14 @@ static const u32 rotation_v2_formats[] = {
 	/* TODO add formats after validation */
 };
 
+/*
+ * v1.0.0 (SM8250) rotates UBWC NV12 and TP10 only. TP10 is left out: the
+ * format check below matches the fourcc, which cannot tell it from P010.
+ */
+static const u32 rotation_v1_formats[] = {
+	DRM_FORMAT_NV12,
+};
+
 static const u32 rotation_v201_formats[] = {
 	DRM_FORMAT_NV12,
 	DRM_FORMAT_P010,
@@ -339,6 +347,12 @@ static const struct dpu_rotation_cfg dpu_rot_sc7280_cfg_v2 = {
 	.rot_format_list = rotation_v2_formats,
 };
 
+static const struct dpu_rotation_cfg dpu_rot_sm8250_cfg_v1 = {
+	.rot_maxheight = 1088,
+	.rot_num_formats = ARRAY_SIZE(rotation_v1_formats),
+	.rot_format_list = rotation_v1_formats,
+};
+
 static const struct dpu_rotation_cfg dpu_rot_sm8550_cfg_v201 = {
 	.rot_maxheight = 1088,
 	.rot_num_formats = ARRAY_SIZE(rotation_v201_formats),
@@ -366,6 +380,10 @@ static const struct dpu_sspp_sub_blks dpu_vig_sblk_qseed3_2_4 =
 static const struct dpu_sspp_sub_blks dpu_vig_sblk_qseed3_3_0 =
 				_VIG_SBLK(SSPP_SCALER_VER(3, 0));
 
+static const struct dpu_sspp_sub_blks dpu_vig_sblk_qseed3_3_0_rot_v1 =
+			_VIG_SBLK_ROT(SSPP_SCALER_VER(3, 0),
+				      &dpu_rot_sm8250_cfg_v1);
+
 static const struct dpu_sspp_sub_blks dpu_vig_sblk_qseed3_3_0_rot_v2 =
 			_VIG_SBLK_ROT(SSPP_SCALER_VER(3, 0),
 				      &dpu_rot_sc7280_cfg_v2);
