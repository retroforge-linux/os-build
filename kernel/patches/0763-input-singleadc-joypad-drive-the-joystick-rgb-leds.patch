From: Philippe Simons <simons.philippe@gmail.com>
Subject: [PATCH] input: singleadc-joypad: the stick rings as LED class devices

The RG 55G1's stick rings are driven by the joypad MCU through fields in
the 64-byte request frame the driver already polls it with. The layout
comes from the stock single_mcu_joy.ko (custom_led_setting), as decoded
by Daniel Martin for batocera:

  [7]      mode    1 = one colour, 4 = the MCU's own rainbow,
                   5 = per-segment colours from [11..58]
                   (16 x RGB, 8 segments per stick ring)
  [8]      switch  0 = off, 1 = on
  [9]      level   0..255 (ignored in mode 5)
  [10]     speed   effect speed; also selects the full report (0x32)
  [59]     tag0    always 0
  [60]     tag1    incremented on every commit
  [61..62] CRC-16/XMODEM over [7..60], big endian

batocera exposes those fields under the stock sysfs names. Register the
16 segments as multicolor LED class devices instead, rgb:l1..l8 and
rgb:r1..r8, the names the other rings in the fleet carry, so the rings
are driven like any other LED. The frame always uses mode 5; the switch
is on while any segment is lit.

The frame is now shared by the poller, the LED callbacks and mcu_cmd, so
one mutex covers its contents and the transfer that sends it, and the
SPI client publishes g_smd only once its frame is whole.

As on stock, the rings stay off at boot until something lights them.
---
diff --git a/drivers/input/joystick/Kconfig b/drivers/input/joystick/Kconfig
index 930cbd1fd..bb6e7422e 100644
--- a/drivers/input/joystick/Kconfig
+++ b/drivers/input/joystick/Kconfig
@@ -431,6 +431,8 @@ config JOYSTICK_SINGLEADC_JOYPAD
 	tristate "Single-ADC / MCU SPI handheld gamepad"
 	depends on OF
 	depends on SPI
+	depends on LEDS_CLASS_MULTICOLOR
+	select CRC_ITU_T
 	help
 	  Say Y here to enable support for the handheld gamepad found on
 	  Anbernic SM4450 devices such as the RG 55G1, where the digital
diff --git a/drivers/input/joystick/singleadc-joypad.c b/drivers/input/joystick/singleadc-joypad.c
index 69e026110..065c1c625 100644
--- a/drivers/input/joystick/singleadc-joypad.c
+++ b/drivers/input/joystick/singleadc-joypad.c
@@ -7,11 +7,13 @@
  */
 #define SUPPORT_MCU_SPI_ADC
 
+#include <linux/crc-itu-t.h>
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/firmware/qcom/qcom_scm.h>
 #include <linux/input.h>
 #include <linux/io.h>
+#include <linux/led-class-multicolor.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
@@ -145,15 +147,23 @@ struct spi_mcu_data {
 	int buf_len;
 	u32 crc_ok;
 	u32 crc_err;
+	u8 led_tag;	/* LED commit counter, frame byte [60] */
 };
 
 static struct spi_mcu_data *g_smd;
 
 /*
- * Report request. Byte 10 selects what the MCU sends back: with 0x02 it
- * answers with a partial frame where the two trigger words stay at the idle
- * 0x0800. The stock spidev3.0 test tool shipped in the RG55G1 firmware asks
- * for 0x32 instead.
+ * Serialises the request frame (tx_buf) and the transfer that sends it: the
+ * poller, the LED class callbacks and mcu_cmd all touch the frame.
+ */
+static DEFINE_MUTEX(joypad_frame_lock);
+static void joypad_led_apply(struct spi_mcu_data *smd);
+
+/*
+ * Report request, as sent by the stock spidev3.0 test tool shipped in the
+ * RG55G1 firmware. Bytes [7..13] and [59..62] are the LED fields, tag and CRC
+ * (see the LED block below); joypad_led_apply() rewrites them before the frame
+ * is first used, so only the header [0..6] really matters here.
  */
 static const char joypad_mcu_tx_cmd[64] = {
 	0x5a, 0x3a, 0x66, 0x66, 0x00, 0x0d, 0x0a, 0x04,
@@ -322,8 +332,8 @@ static int joypad_mcu_xfer(struct spi_mcu_data *smd)
 	return -ENODEV;
 }
 
-static int joypad_spi_data_parse(u16 *lx, u16 *ly, u16 *rx, u16 *ry,
-				 u16 *lt, u16 *rt)
+static int joypad_spi_data_parse_locked(u16 *lx, u16 *ly, u16 *rx, u16 *ry,
+					u16 *lt, u16 *rt)
 {
 	char *data;
 	u16 crc16 = 0;
@@ -382,6 +392,17 @@ static int joypad_spi_data_parse(u16 *lx, u16 *ly, u16 *rx, u16 *ry,
 	return 0;
 }
 
+static int joypad_spi_data_parse(u16 *lx, u16 *ly, u16 *rx, u16 *ry,
+				 u16 *lt, u16 *rt)
+{
+	int ret;
+
+	mutex_lock(&joypad_frame_lock);
+	ret = joypad_spi_data_parse_locked(lx, ly, rx, ry, lt, rt);
+	mutex_unlock(&joypad_frame_lock);
+	return ret;
+}
+
 static ssize_t mcu_info_show(struct device *dev,
 			     struct device_attribute *attr, char *buf)
 {
@@ -447,6 +468,7 @@ static ssize_t mcu_cmd_store(struct device *dev,
 	const char *p = buf;
 	int i = 0;
 
+	guard(mutex)(&joypad_frame_lock);
 	if (!g_smd || !g_smd->tx_buf)
 		return -ENODEV;
 
@@ -577,7 +599,10 @@ static int joypad_mmio_spi_init(struct device *dev)
 		return -ENOMEM;
 	}
 	memcpy(smd->tx_buf, joypad_mcu_tx_cmd, 64);
+	mutex_lock(&joypad_frame_lock);
+	joypad_led_apply(smd);
 	g_smd = smd;
+	mutex_unlock(&joypad_frame_lock);
 
 	{
 		u16 lx, ly, rx, ry, lt, rt;
@@ -597,6 +622,131 @@ static int joypad_mmio_spi_init(struct device *dev)
 	return 0;
 }
 
+/*
+ * Joystick RGB rings.
+ *
+ * The MCU drives the stick rings from fields in the 64-byte request frame we
+ * poll it with. Layout recovered from the stock single_mcu_joy.ko
+ * (custom_led_setting), offsets in the frame:
+ *
+ *   [7]  mode     1 = one colour from [11..13], 4 = the MCU's own rainbow,
+ *                 5 = per-segment colours from [11..58] (16 x RGB: slots
+ *                 0..7 the left ring, 8..15 the right)
+ *   [8]  switch   0 = rings off, 1 = on
+ *   [9]  level    0..255; the MCU ignores it in mode 5
+ *   [10] speed    effect speed for the MCU-driven modes, and also what the
+ *                 MCU answers with: 0x02 gets a partial report whose trigger
+ *                 words stay at the idle 0x0800, so keep stock's 0x32
+ *   [59]  tag0    always 0
+ *   [60]  tag1    incremented on every commit so the MCU sees a new command
+ *   [61..62]      CRC-16/XMODEM (poly 0x1021, init 0) over [7..60], big endian
+ *
+ * Only mode 5 is used: each segment is its own multicolor LED class device,
+ * rgb:l1..l8 and rgb:r1..r8, so the rings look like every other ring in the
+ * LED class and the class's brightness scaling gives the levels. The rings
+ * are off at boot until something lights a segment, as on stock.
+ */
+#define JOYPAD_LED_OFF_MODE	7
+#define JOYPAD_LED_OFF_SWITCH	8
+#define JOYPAD_LED_OFF_LEVEL	9
+#define JOYPAD_LED_OFF_SPEED	10
+#define JOYPAD_LED_OFF_SEG	11
+#define JOYPAD_LED_OFF_TAG0	59
+#define JOYPAD_LED_OFF_TAG1	60
+#define JOYPAD_LED_OFF_CRC	61
+#define JOYPAD_LED_CRC_LEN	(JOYPAD_LED_OFF_CRC - JOYPAD_LED_OFF_MODE)
+#define JOYPAD_LED_MODE_SEGMENTS 5
+#define JOYPAD_LED_SPEED	0x32
+#define JOYPAD_LED_PER_RING	8
+#define JOYPAD_LED_COUNT	(2 * JOYPAD_LED_PER_RING)
+
+struct joypad_led {
+	struct led_classdev_mc mc;
+	struct mc_subled subled[3];
+	char name[8];
+	int slot;
+};
+
+/* Segment colours, kept here so they outlive a late or re-probed MCU client. */
+static u8 joypad_led_seg[JOYPAD_LED_COUNT * 3];
+
+/* Write the segment colours into the frame; it goes out on the next poll. */
+static void joypad_led_apply(struct spi_mcu_data *smd)
+{
+	u8 *f = (u8 *)smd->tx_buf;
+	u16 crc;
+
+	lockdep_assert_held(&joypad_frame_lock);
+	if (!f || smd->buf_len < 64)
+		return;
+
+	f[JOYPAD_LED_OFF_MODE] = JOYPAD_LED_MODE_SEGMENTS;
+	f[JOYPAD_LED_OFF_SWITCH] =
+		!!memchr_inv(joypad_led_seg, 0, sizeof(joypad_led_seg));
+	f[JOYPAD_LED_OFF_LEVEL] = 0xff;
+	f[JOYPAD_LED_OFF_SPEED] = JOYPAD_LED_SPEED;
+	memcpy(f + JOYPAD_LED_OFF_SEG, joypad_led_seg, sizeof(joypad_led_seg));
+	f[JOYPAD_LED_OFF_TAG0] = 0;
+	f[JOYPAD_LED_OFF_TAG1] = ++smd->led_tag;
+
+	crc = crc_itu_t(0, f + JOYPAD_LED_OFF_MODE, JOYPAD_LED_CRC_LEN);
+	f[JOYPAD_LED_OFF_CRC] = crc >> 8;
+	f[JOYPAD_LED_OFF_CRC + 1] = crc & 0xff;
+}
+
+static int joypad_led_set(struct led_classdev *cdev,
+			  enum led_brightness brightness)
+{
+	struct led_classdev_mc *mc = lcdev_to_mccdev(cdev);
+	struct joypad_led *led = container_of(mc, struct joypad_led, mc);
+	int i;
+
+	led_mc_calc_color_components(mc, brightness);
+
+	guard(mutex)(&joypad_frame_lock);
+	for (i = 0; i < ARRAY_SIZE(led->subled); i++)
+		joypad_led_seg[led->slot * 3 + i] = led->subled[i].brightness;
+	if (g_smd)
+		joypad_led_apply(g_smd);
+	return 0;
+}
+
+static int joypad_leds_register(struct device *dev)
+{
+	static const int colors[] = {
+		LED_COLOR_ID_RED, LED_COLOR_ID_GREEN, LED_COLOR_ID_BLUE,
+	};
+	struct joypad_led *leds;
+	int i, j, ret;
+
+	leds = devm_kcalloc(dev, JOYPAD_LED_COUNT, sizeof(*leds), GFP_KERNEL);
+	if (!leds)
+		return -ENOMEM;
+
+	for (i = 0; i < JOYPAD_LED_COUNT; i++) {
+		struct joypad_led *led = &leds[i];
+
+		led->slot = i;
+		snprintf(led->name, sizeof(led->name), "rgb:%c%d",
+			 i < JOYPAD_LED_PER_RING ? 'l' : 'r',
+			 i % JOYPAD_LED_PER_RING + 1);
+		for (j = 0; j < ARRAY_SIZE(colors); j++) {
+			led->subled[j].color_index = colors[j];
+			led->subled[j].intensity = LED_FULL;
+		}
+		led->mc.subled_info = led->subled;
+		led->mc.num_colors = ARRAY_SIZE(led->subled);
+		led->mc.led_cdev.name = led->name;
+		led->mc.led_cdev.max_brightness = LED_FULL;
+		led->mc.led_cdev.brightness_set_blocking = joypad_led_set;
+
+		ret = devm_led_classdev_multicolor_register(dev, &led->mc);
+		if (ret)
+			return dev_err_probe(dev, ret, "LED %s\n", led->name);
+	}
+	return 0;
+}
+
 static struct attribute *joypad_attrs[] = {
 	&dev_attr_mcu_info.attr,
 	&dev_attr_mcu_frame.attr,
@@ -1306,6 +1456,12 @@ static int joypad_probe(struct platform_device *pdev)
 	if (error)
 		return error;
 
+#ifdef SUPPORT_MCU_SPI_ADC
+	error = joypad_leds_register(dev);
+	if (error)
+		return error;
+#endif
+
 	joypad_open_enable(joypad);
 
 	dev_info(dev, "singleadc-joypad probe success (%s)\n",
@@ -1345,12 +1501,10 @@ static int sprd_spi_mcu_probe(struct spi_device *spi)
 
 	smd->spi = spi;
 	smd->dev = &spi->dev;
-	g_smd = smd;
 
 	ret = spi_setup(spi);
 	if (ret < 0) {
 		kfree(smd);
-		g_smd = NULL;
 		return ret;
 	}
 
@@ -1363,10 +1517,14 @@ static int sprd_spi_mcu_probe(struct spi_device *spi)
 		kfree(smd->rx_buf);
 		kfree(smd->tx_buf);
 		kfree(smd);
-		g_smd = NULL;
 		return -ENOMEM;
 	}
 	memcpy(smd->tx_buf, joypad_mcu_tx_cmd, min_t(int, smd->buf_len, 64));
+	/* Published only once its frame is whole: the LED callbacks use it. */
+	mutex_lock(&joypad_frame_lock);
+	joypad_led_apply(smd);
+	g_smd = smd;
+	mutex_unlock(&joypad_frame_lock);
 
 	spi_set_drvdata(spi, smd);
 
@@ -1381,8 +1539,10 @@ static void sprd_spi_mcu_remove(struct spi_device *spi)
 {
 	struct spi_mcu_data *smd = spi_get_drvdata(spi);
 
+	mutex_lock(&joypad_frame_lock);
 	if (smd == g_smd)
 		g_smd = NULL;
+	mutex_unlock(&joypad_frame_lock);
 	if (smd) {
 		kfree(smd->rx_buf);
 		kfree(smd->tx_buf);
