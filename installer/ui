UI_MODE = os.environ.get("RETROFORGE_UI_MODE", "install")
RESET_LEVEL = os.environ.get("RETROFORGE_RESET_LEVEL", "")
# Wrong sequences before the reset consent gives up and goes back: retroforge-install's CONFIRM_TRIES.
RESET_CONFIRM_TRIES = 5

SOCK_PATH = os.environ.get("RETROFORGE_UI_SOCK", "/run/retroforge/installer-ui.sock")
# Read by `leave`, which the unit runs on stop.
POWEROFF_MARK = os.environ.get("RETROFORGE_INSTALL_POWEROFF", "/run/retroforge/install-poweroff")
