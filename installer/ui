def build_io():
    """
    The view and the input source come as a pair: scripted events mean no window at all.

    installer/uiview.py is loaded HERE and nowhere else — it is the only file that imports pygame, and
    reaching it requires having decided to open a display. Everything above this line runs on a
    build host with no SDL.
    """
    if EVENTS_FILE:
        return NullView(), ScriptedInput(EVENTS_FILE)
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import uiview

    view = uiview.PygameView()
    return view, PadInput(view.pygame)


def ask_for_poweroff():
    """Leave the mark `leave` reads. Without it the device reboots, into internal storage."""
    try:
        with open(POWEROFF_MARK, "w"):
            pass
    except OSError as exc:
        log("could not leave the power-off mark: %s" % exc)


def run(server, view, source, base, deadline=0):
    """
    Returns when the scripted source runs out (tests) or the window goes away.

    `deadline` is a wall-clock bound in seconds, for the headless runs only: a UI that is waiting
    for a request that never comes must fail the suite rather than hang it. 0 means no bound.
    """
    # A STACK, not a variable. The consent request arrives while the progress screen is up and has
    # to hand the screen back when it is answered -- the install is still running underneath it.
    stack = [base]
    spine = None
    verify = None      # verify-install.sh, once an install has succeeded (#66)
    started = time.monotonic()
    # §4d's input check, throttled: it reads the kernel's device list, which is cheap but not free
    # at frame rate, and the answer only changes when somebody plugs something in.
    no_input = NoInputScreen()
    have_input, input_checked = source.present(), time.monotonic()
    if not have_input:
        log("no controller and no keyboard -- consent cannot be taken on this machine (§4d)")
    while True:
        if time.monotonic() - input_checked > 2:
            was, have_input = have_input, source.present()
            input_checked = time.monotonic()
            if was != have_input:
                log("input devices: %s" % ("present again" if have_input else "gone"))

        top = stack[-1]

        screen = no_input if not have_input else stack[-1]

        # The install, if one is running. Read before drawing so a frame shows the newest step.
        if spine is not None:
            progress = next((s for s in stack if s.name == "progress"), None)
            for line in spine.poll():
                log("spine: %s" % line)
                if progress is not None:
                    progress.feed(line)
            rc = spine.returncode()
            if rc is not None and not spine.buf:
                if progress is not None:
                    progress.finish(rc)
                log("the spine exited %d" % rc)
                spine = None
                # A SUCCESSFUL INSTALL IS NOT A VERIFIED ONE, and until now nothing ever read back
                # what was written (#66). verify-install.sh is launched from HERE rather than from
                # the spine on purpose -- "the spine writes; this reads" -- and it has to happen
                # while the card is still in, which is the window its own header asks for and the
                # one the done screen was about to tell the operator to close.
                if rc == 0 and progress is not None:
                    try:
                        verify = VerifyRun(progress.disk)
                        progress.begin_verify()
                    except OSError as e:
                        # A verifier that will not start is reported, never fatal: the install
                        # itself succeeded and the operator still needs the screen that says so.
                        log("could not start the check: %s" % e)
                        progress.finish_verify(1)

        # The check, once the install has won. Same non-blocking read as the spine.
        if verify is not None:
            progress = next((s for s in stack if s.name == "progress"), None)
            for line in verify.poll():
                log("verify: %s" % line)
                if progress is not None:
                    progress.feed_verify(line)
            vrc = verify.returncode()
            if vrc is not None and not verify.buf:
                if progress is not None:
                    progress.finish_verify(vrc)
                log("the check exited %d" % vrc)
                verify = None

        req = server.poll()
        if req is not None and not have_input:
            # THE REFUSAL THAT MAKES THE SCREEN MORE THAN A MESSAGE. Drawing a consent screen on a
            # machine with nothing to press it with would leave the spine blocked on an answer that
            # can never come; answering with an error makes the shim exit non-zero, which the spine
            # reads as an abort and stops on. It fails closed, and it fails at once.
            log("refusing a consent request: there is no input device to take consent on (§4d)")
            server.answer({"error": "no controller or keyboard is attached"})
            req = None
        if req is not None:
            try:
                facts = read_facts(req["facts"])
                consent = ConsentScreen(facts, req["sequence"])
                consent.describe()       # raises on a screen this renderer does not know
                stack.append(consent)
                screen = consent
                # Logged deliberately, and it is safe to log: the sequence is not a secret, it is
                # on the panel. What it proves in the journal is WHICH screen was shown and what
                # was asked for, next to the spine's own record of what came back.
                log("consent requested for %s (%s), sequence %s"
                    % (facts.get("DISK", "?"), facts.get("SCREEN", "?"), req["sequence"]))
            except (KeyError, OSError, ValueError) as e:
                log("refusing a consent request: %s" % e)
                server.answer({"error": str(e)})

        view.draw(screen.describe())

        for token in source.poll(screen):
            if token == TOKEN_QUIT and server.pending is None and screen.name != "consent":
                # The window went away with nothing pending. During a consent request QUIT is an
                # abort instead, which the screen turns into one -- an answer, not a silent exit.
                return 0
            screen.handle(token)
            result = getattr(screen, "result", None)
            if result is None:
                continue
            if screen.name == "consent" and getattr(screen, "local", False):
                # The factory reset's own consent: nothing on the socket asked, so this decides --
                # the same policy as the spine's (right sequence: go; wrong: re-randomise; give up
                # after RESET_CONFIRM_TRIES; SELECT: back).
                reset = stack[-2]
                if result[0] == "abort":
                    stack.pop()
                elif result[1] == screen.sequence:
                    try:
                        write_reset_request(reset.level)
                    except (OSError, ValueError) as e:
                        log("could not write the reset request: %s" % e)
                        reset.error = str(e)
                        stack.pop()
                        break
                    log("factory reset (%s) requested: restarting" % reset.level)
                    return 0                         # the unit's `leave` reboots into the reset
                elif screen.tries + 1 >= RESET_CONFIRM_TRIES:
                    log("factory reset: %d wrong sequences, back to the reset screen" % RESET_CONFIRM_TRIES)
                    stack.pop()
                else:
                    again = ConsentScreen(screen.facts, random_sequence())
                    again.local, again.tries = True, screen.tries + 1
                    stack[-1] = again
            elif screen.name == "consent":
                server.answer({"abort": True} if result[0] == "abort" else {"answer": result[1]})
                stack.pop()                          # back to whatever asked -- usually progress
            elif result[0] == "reset-consent":
                # Consumed here: the reset screen stays under the consent and is shown again after
                # an abort, five wrong sequences or a request that could not be written, and a result
                # left on it would push a new consent at the next key, whatever was pressed.
                top.result = None
                consent = ConsentScreen({"SCREEN": "factory-reset", "LEVEL": top.level}, random_sequence())
                consent.local, consent.tries = True, 0
                consent.describe()
                stack.append(consent)
                log("factory reset (%s): consent asked, sequence %s" % (top.level, consent.sequence))
            elif result[0] == "recheck":
                # The pre-flight screen could not say what it would install. Ask the update server
                # again -- and ONLY that: the disk was already read, and rebuilding the screen from
                # scratch would throw away the size the operator had dialled in, which is the one
                # thing on it they chose. release-info caches nothing it failed to resolve, so this
                # really does re-ask.
                log("re-asking the update server what there is to install")
                stack[-1] = PreflightScreen(dict(top.facts, **release_facts()), top.gib)
            elif result[0] == "start":
                # `fresh`, ALWAYS, because it is the only thing this UI can honestly promise. On a
                # disk of ours the pre-flight screen says the install "will be erased and replaced,
                # INCLUDING /home", and plan_carve() showed the operator exactly that carve --
                # carve.sh handles `plan` in the same branch as `fresh`. The spine's other intent,
                # `reinstall`, keeps /home and is not reachable from any screen here yet, so naming
                # it would be a promise nothing behind it keeps.
                spine = SpineRun(result[1], server.path,
                                 top.facts["bundle"], "fresh")
                # The disk travels WITH the screen: when the spine finishes, the pre-flight that
                # knew which disk this is has long been off the stack, and the checker must not
                # go looking for it a second time.
                stack.append(ProgressScreen(spine, top.facts["disk"]))
            elif result[0] == "retry":
                # A failed install, from the top. Re-running IS the recovery -- the installer keeps
                # no backups precisely because it has to be -- and the facts are re-gathered rather
                # than reused, since a partial carve has changed the very disk they describe.
                log("retrying after a failed install")
                spine = None
                if verify is not None:
                    verify.stop()
                    verify = None
                stack.pop()
                facts, why = gather_preflight()
                stack[-1] = PreflightScreen(facts) if facts else IdleScreen(why)
            elif result[0] == "poweroff":
                ask_for_poweroff()
                return 0
            elif result[0] == "quit":
                # Cancel and Restart are this: retroforge-installer.service reboots on a stop with
                # no mark, so leaving is what brings the device back.
                return 0
            break

        # A scripted run is over when its tokens are spent and nothing is still owed an answer.
        # Deliberately NOT keyed on which screen is up: a screen this condition forgot to name is a
        # suite that hangs until the deadline, which is how adding the network screen announced
        # itself.
        if isinstance(source, ScriptedInput) and source.i >= len(source.tokens) \
                and server.pending is None and spine is None:
            return 0
        if deadline and time.monotonic() - started > deadline:
            log("gave up waiting after %ds" % deadline)
            return 1
        time.sleep(1 / 60)


def main(argv):
    global SOCK_PATH
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--socket" and args:
            SOCK_PATH = args.pop(0)
        else:
            log("unknown argument %s" % a)
            return 2

    server = ConfirmServer(SOCK_PATH)
    view, source = build_io()
    if UI_MODE == "reset":
        # Nothing to gather: the reset screen says what it does, and only consent writes anything.
        base = ResetScreen(RESET_LEVEL) if RESET_LEVEL in RESET_LEVELS \
            else IdleScreen("no factory reset level (soft or hard) was given: %r" % RESET_LEVEL)
    else:
        # OGUI started this, so the network was up a moment ago: there is no network screen. If it
        # has gone, the pre-flight screen says the download could not be resolved and offers Check again.
        facts, why = gather_preflight()
        base = PreflightScreen(facts) if facts else IdleScreen(why)
    try:
        return run(server, view, source, base,
                   deadline=float(os.environ.get("RETROFORGE_UI_DEADLINE", "0")))
    finally:
        source.close()
        view.close()
        server.close()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
