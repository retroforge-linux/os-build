# the consent screen — §4d, the gamepad half of the contract
# =================================================================================================
def read_facts(path):
    """The key=value file the spine derived. Unknown keys are kept; missing ones are absent."""
    facts = {}
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            facts[k] = v
    return facts


class ConsentScreen:
    """
    The four face buttons, drawn by position, pressed in the order shown.

    IT KNOWS THE ANSWER AND STILL CANNOT GIVE IT. The sequence is an argument — it has to be, the
    screen draws it — so the policy of what counts as consent stays in the spine, which generates
    the sequence, compares what comes back and re-randomises. This class collects presses and hands
    them over. Nothing here decides that consent was given.

    A WRONG PRESS ENDS THE ATTEMPT IMMEDIATELY rather than collecting three more that cannot matter.
    What is returned is what was pressed, which is not the sequence, so the spine re-randomises and
    asks again — §4d's "a wrong press re-randomises and redraws", with the redraw arriving on the
    press instead of three presses later. It is not a lockout and it costs the user nothing but the
    slip itself.

    ABORT IS THE BACK BUTTON, NOT A FACE BUTTON, and it cannot be anything else: all four face
    buttons are in every sequence, so a face button that also meant "cancel" would be ambiguous on
    the one screen where ambiguity erases an Android install. (The plan said `B`-then-abort; that
    predates the positional alphabet and was never implementable for this reason.)
    """

    name = "consent"

    def __init__(self, facts, sequence):
        self.facts = facts
        self.sequence = sequence
        self.pressed = ""
        self.result = None      # ("answer", str) | ("abort",)

    def handle(self, token):
        if token in (TOKEN_BACK, TOKEN_QUIT):
            self.result = ("abort",)
            return
        if token not in CARDINALS:
            return
        self.pressed += token
        want = self.sequence[: len(self.pressed)]
        if self.pressed != want:
            self.result = ("answer", self.pressed)      # wrong, and deliberately returned as such
        elif len(self.pressed) == len(self.sequence):
            self.result = ("answer", self.pressed)

    def diamonds(self):
        """One diamond per press: its position, and whether it has been pressed yet."""
        return [
            {"pos": p, "name": CARDINAL_NAME[p], "done": i < len(self.pressed)}
            for i, p in enumerate(self.sequence)
        ]

    def describe(self):
        f = self.facts
        screen = f.get("SCREEN", "")
        if screen == "android-wipe":
            body = self._android_wipe(f)
        elif screen == "reinstall":
            body = self._reinstall(f)
        elif screen == "factory-reset":
            body = self._factory_reset(f)
        else:
            # The renderer must not invent a screen for facts it does not understand. Failing here
            # is an abort, which is the safe direction.
            raise ValueError("the facts file names no screen I know how to render (%r)" % screen)
        return {
            "screen": "consent",
            "kind": screen,
            "title": body["title"],
            "blocks": body["blocks"],
            "diamonds": self.diamonds(),
            "prompt": "Press these four buttons in this order",
            # The sentence that does the work the letters used to do badly. It is on screen, not in
            # a manual: the person holding the device is the one who has to know that the drawing
            # means a position and not the letter under their thumb.
            "note": "It is the POSITION on the pad, not the letter printed on the button.",
            "abort": "Press SELECT to cancel. Nothing has been written yet.",
        }

    # The two screens are written out separately and share no text, for the same reason
    # confirm-tty's are: §4d requires that an Android disk cannot produce the reinstall wording or
    # the reverse, and a single template with conditionals inside it is the shape that lets it.
    def _factory_reset(self, f):
        level = f.get("LEVEL", "?")
        if level == "soft":
            return {"title": "Reset settings, keep games", "blocks": [
                ("This erases every setting and sign-in",
                 "Wi-Fi, Bluetooth, Steam and store sign-ins, emulators, ROM art and installed PC games "
                 "go. Your ROMs, BIOS files, saves and save states stay."),
            ]}
        return {"title": "Erase everything", "blocks": [
            ("This erases everything you put on this device",
             "ROMs, BIOS files, saves, save states, settings and sign-ins. It is NOT recoverable, by "
             "you or by us."),
        ]}

    def _android_wipe(self, f):
        blocks = [
            ("Target", "%s  (%s)" % (f.get("DISK", "?"), f.get("WWID", "?"))),
            (
                "This deletes Android's data",
                "Everything stored in Android -- apps, saves, photos, downloads and signed-in "
                "accounts -- will be deleted. It is NOT recoverable, by you or by us.",
            ),
            (
                "The numbers",
                "Android's data partition is %s GiB today. It will be recreated at %s GiB, and %s"
                % (
                    f.get("UD_GIB_NOW", "?"),
                    f.get("UD_GIB_AFTER", "?"),
                    "RetroForge will use the rest of the disk."
                    if f.get("RETROFORGE_GIB", "unknown") == "unknown"
                    else "RetroForge will use the remaining %s GiB." % f.get("RETROFORGE_GIB"),
                ),
            ),
        ]
        # `fresh` on a disk that is ALREADY ours is a supported mode, and it destroys the retroforge
        # /home holding the games. The tty screen learned this on hardware on 2026-08-21 while
        # reassuring the operator that their game library was safe. Do not let this renderer repeat
        # it: the reassurance below is true only when the games are on the SD card.
        if f.get("REPLACES_OURS") == "1":
            home = f.get("HOME_GIB", "unknown")
            blocks.append((
                "This also deletes the RetroForge install already here",
                "A fresh install replaces all of it, /home included -- your installed games, saves "
                "and settings. %s It is NOT recoverable. To keep them, cancel and choose Repair."
                % ("Its size could not be read."
                   if home in ("", "unknown") else "It is using %s GiB today." % home),
            ))
            blocks.append((
                "What survives",
                "Android itself still boots, factory-reset; its system is untouched. Your SD card "
                "is never written to -- but anything on the INTERNAL disk is a different matter, "
                "see above.",
            ))
        else:
            blocks.append((
                "What survives",
                "Android itself still boots, factory-reset; its system is untouched. Your SD card "
                "is never written to: nothing on it is read, moved or erased -- your game library "
                "is safe.",
            ))
        blocks.append((
            "Afterwards",
            "The device boots RetroForge from internal storage by default. Hold Volume Up at startup "
            "to reach the bootloader menu and choose Android, at any time.",
        ))
        return {"title": "Install RetroForge on this device's internal storage", "blocks": blocks}

    def _reinstall(self, f):
        home = f.get("HOME_GIB", "unknown")
        blocks = [
            ("Target", "%s  (%s)" % (f.get("DISK", "?"), f.get("WWID", "?"))),
            (
                "Android is not touched",
                "This rewrites RetroForge's system partitions. Android's data was already resized "
                "when RetroForge was first installed, and nothing here changes it.",
            ),
        ]
        if f.get("HOME_ACTION") == "erase":
            blocks.append((
                "You asked to erase /home",
                "Your games, saves, screenshots and settings will be deleted. %s GiB is in use "
                "there today. It is NOT recoverable. Games can be downloaded again; saves that are "
                "not backed up somewhere else cannot." % home,
            ))
        else:
            blocks.append((
                "Your games and saves are kept",
                "/home is left exactly as it is -- %s GiB in use. Only the system partitions are "
                "rewritten." % home,
            ))
        return {"title": "Repair the RetroForge install on this device", "blocks": blocks}


class NoInputScreen:
    """
    §4d: no controller and no keyboard means the installer STOPS and says so.

    It is a dead end on purpose — it handles nothing, because there is nothing to handle it with.
    What makes it more than a message is the refusal in the loop: while this screen is up, a
    consent request is answered with an error instead of being drawn, so the spine stops rather
    than waiting forever on a screen nobody can answer. An installer that cannot take consent
    cannot install, and it should say which of those two it is.

    It re-checks, so plugging a keyboard in recovers without a reboot.
    """

    name = "no-input"
    # There is nothing to press it with, by definition -- so a scripted run must not spend a press
    # here either.
    interactive = False

    def handle(self, token):
        pass

    def describe(self):
        return {
            "screen": "no-input",
            "title": "No controller or keyboard",
            "blocks": [
                ("Nothing to answer with",
                 "This installer asks you to confirm before it erases anything, and it cannot "
                 "find a game controller or a USB keyboard to take that confirmation on."),
                ("What to do",
                 "Attach a USB keyboard, or fix the controller, and this screen will go away on "
                 "its own. Nothing has been written and nothing will be."),
            ],
            "diamonds": [],
            "prompt": "",
            "note": "",
            "buttons": [],
            "abort": "",
        }


class IdleScreen:
    """
    What is on the panel when there is nothing to install onto -- AND WHY.

    It used to say "Waiting for the installer." and nothing else. That is honest in exactly one
    situation: the UI running as a consent renderer for a spine driven over SSH, which is how
    Phase 4 was hardware-gated. It was also being shown for two situations that look nothing like
    it -- a device that genuinely has no target (booted from internal, rule 1), and select-target.sh
    failing to run at all -- and telling the operator neither.

    HW-FOUND 2026-08-24 (user): the medium shipped without lib-gpt.sh, select-target.sh died on it,
    gather_preflight() read the non-zero exit as the normal "no target" outcome, and the panel sat
    on "Waiting for the installer." forever. A person holding the device could not distinguish a
    broken build from a disk this installer refuses to touch. So the reason is shown, verbatim,
    from the tool that produced it -- the same facts-from-the-tool/words-from-the-UI split the
    consent gate and the network screen both use.

    STILL NOT INTERACTIVE, and still not an error state: there is nothing here for a person to press
    and nothing has been written. It just stops being a screen that withholds what it knows.
    """

    name = "idle"
    interactive = False          # it asks for nothing, so nothing is pressed at it

    def __init__(self, reason=""):
        self.reason = (reason or "").strip()
        self.result = None

    def handle(self, token):
        # The one way out: the unit reboots when this UI exits, back into the card's own session.
        if token in ("S", TOKEN_BACK, TOKEN_QUIT):
            self.result = ("quit",)

    def describe(self):
        # THE ADVICE MUST NOT INVENT A CAUSE. This used to end with "a device already running from
        # its internal disk is refused on purpose", flatly, whatever the actual reason was -- so on
        # a Pocket FIT refused for carrying ROCKNIX (rule 3b) it explained a cause that had nothing
        # to do with that disk, in the confident voice of the real one. HW 2026-08-24. A screen that
        # explains the WRONG reason is worse than one that explains none.
        #
        # So: the reason comes from select-target.sh verbatim, and the advice is chosen from what
        # that reason actually says. Anything unrecognised gets the honest fallback rather than a
        # guess -- the same facts-from-the-tool / words-from-the-UI split §4b uses.
        low = self.reason.lower()
        if "not ours" in low or "remove the other os" in low:
            advice = ("Another operating system is installed on this device's internal disk. "
                      "RetroForge will not install alongside it, because the firmware would then "
                      "have two systems to choose between and no way to be told which. Remove "
                      "that installation first, then run this installer again.")
        elif "running system" in low:
            advice = ("This installer is running from the internal disk itself, so there is "
                      "nothing for it to install onto. Boot it from an SD card instead.")
        else:
            advice = ("If you expected this device to be installable, this is a fault worth "
                      "reporting: the full reason is in /var/log/retroforge/install.log.")
        blocks = [
            ("No disk to install onto",
             "This installer found nothing on this device it is willing to install to, so it has "
             "not started. Nothing has been written."),
        ]
        if self.reason:
            blocks.append(("Why", self.reason))
        blocks.append(("What to do", advice))
        return {
            "screen": "idle",
            "title": "RetroForge installer",
            "blocks": blocks,
            "diamonds": [],
            "prompt": "",
            "note": "",
            "buttons": [{"pos": "S", "label": "Restart"}],
            "abort": "",
        }


# =================================================================================================
# the socket — installer/confirm-ui's other end
# =================================================================================================
class ConfirmServer:
    """
    One request at a time, and every path answers or closes: confirm-ui exits non-zero on anything
    that is not an answer, and the spine reads that as an abort. Failing closed is the whole point.
    """

    def __init__(self, path):
        self.path = path
        self.pending = None      # (conn, request)
        d = os.path.dirname(path)
        if d:
            os.makedirs(d, exist_ok=True)
        if os.path.exists(path):
            os.unlink(path)
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(path)
        # Root-only. The installer runs as root and nothing else has business here.
        os.chmod(path, 0o600)
        self.sock.listen(1)
        self.sock.setblocking(False)

    def poll(self):
        """Accept at most one new request per call. Returns the request dict, or None."""
        try:
            conn, _ = self.sock.accept()
        except BlockingIOError:
            return None
        except OSError as e:
            log("accept failed: %s" % e)
            return None
        conn.settimeout(5)
        try:
            with conn.makefile("r", encoding="utf-8") as f:
                line = f.readline()
            req = json.loads(line)
        except (OSError, ValueError) as e:
            log("a malformed consent request was refused: %s" % e)
            self._reply_and_close(conn, {"error": "malformed request"})
            return None
        if self.pending is not None:
            # A second spine asking while one is on screen. There is only one screen.
            self._reply_and_close(conn, {"error": "busy"})
            return None
        self.pending = conn
        return req

    def answer(self, payload):
        conn, self.pending = self.pending, None
        if conn is not None:
            self._reply_and_close(conn, payload)

    @staticmethod
    def _reply_and_close(conn, payload):
        try:
            conn.sendall((json.dumps(payload) + "\n").encode())
        except OSError:
            pass
        finally:
            conn.close()

    def close(self):
        self.sock.close()
        try:
            os.unlink(self.path)
        except OSError:
            pass


