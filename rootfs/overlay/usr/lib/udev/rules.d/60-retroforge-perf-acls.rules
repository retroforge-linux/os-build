# retroforge HW-access ACLs — grant the gamescope session (player user, member of `wheel`)
# write access to the sysfs knobs the shell's performance controls drive. The root is read-only, so
# these can't be chmod'd at build time on a live device; a udev rule re-applies them each
# time the device appears (player is in wheel, see rootfs/customize-base.sh) — covers the CPU/GPU
# perf sliders.
#
# No grant for the panel backlight. OGUI's brightness slider goes through brightnessctl and
# logind's SetBrightness, which needs none. With a grant, the Steam Client (running as player) wrote
# the backlight itself and faded the panel to its own default on every start (MANGMI Air X,
# 2026-11-21). Without one, Steam's own brightness slider and its idle dimming have no effect.

SUBSYSTEM=="cpu", KERNEL=="cpu[0-9]*", \
    RUN+="/bin/sh -c 'chgrp wheel /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq /sys/devices/system/cpu/cpufreq/policy*/scaling_governor 2>/dev/null; chmod g+w /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq /sys/devices/system/cpu/cpufreq/policy*/scaling_governor 2>/dev/null'"

SUBSYSTEM=="devfreq", KERNEL=="*.gpu", \
    RUN+="/bin/sh -c 'chgrp wheel /sys/class/devfreq/%k/governor /sys/class/devfreq/%k/max_freq /sys/class/devfreq/%k/min_freq 2>/dev/null; chmod g+w /sys/class/devfreq/%k/governor /sys/class/devfreq/%k/max_freq /sys/class/devfreq/%k/min_freq 2>/dev/null'"
