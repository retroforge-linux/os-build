[Unit]
Description=retroforge Wi-Fi power save as the board profile asks
# Writes (or removes) a NetworkManager drop-in under /run from the board profile's
# RETROFORGE_WIFI_POWERSAVE (/usr/lib/retroforge/wifi-powersave): it must land before NetworkManager
# reads its config.
DefaultDependencies=no
After=local-fs.target
Before=NetworkManager.service network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/retroforge/wifi-powersave

[Install]
WantedBy=multi-user.target
