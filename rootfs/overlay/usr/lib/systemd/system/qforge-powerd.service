[Unit]
Description=qforge power daemon (fan curve, LEDs, boot CPU governor, sched_ext)
# The fan and LEDs come from the hardware map (/run/qforge/hw); without it powerd scans sysfs.
Wants=qforge-hw.service
After=qforge-hw.service
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=org.qforge.Power
NotifyAccess=main
ExecStart=/usr/bin/qforge-powerd
ExecStopPost=/usr/bin/qforge-powerd --fan-safe
Restart=always
RestartSec=1
WatchdogSec=15

[Install]
WantedBy=multi-user.target
