#!/usr/bin/env python3
# retroforge-steam-direct — Steam games started without the Steam client (beside the kept one, minimal,
# when Steam is kept running): the player's "Start Steam games without Steam" setting, and the launch.
#
#   retroforge-steam-direct status       print on or off (and on stderr, where that comes from)
#   retroforge-steam-direct on|off       save the player's choice; print the result
#   retroforge-steam-direct check APPID  exit 0 when APPID starts without the client now; else exit 1,
#                                        saying why on stderr (nothing when the setting is off)
#   retroforge-steam-direct run APPID    start APPID without the client: this process becomes the
#                                        launch. /usr/bin/steam execs it after a `check`, so it asks
#                                        neither the setting nor whether a client runs; exit 1,
#                                        nothing started, when there is no launch to replay
#   retroforge-steam-direct remember     keep every game's newest launch in Steam's log (/usr/bin/steam
#                                        runs it before the client starts)
#   retroforge-steam-direct game APPID [set KEY VALUE]
#                                        print (JSON) APPID's own FEX TSO, launch option, resolution and
#                                        graphics driver (Game settings > RetroForge), after saving one
#   retroforge-steam-direct fex APPID    give an x86 game the graphics driver chosen for it, in its FEX
#                                        folder (/usr/bin/steam runs it before every launch of a game)
#   retroforge-steam-direct restore-resolution PID DISPLAY WxH WxH
#                                        once PID ends, give DISPLAY's X server the first size back if it
#                                        still has the second (run, through systemd-run, starts it)
#
# WHY. On the MANGMI Air X (SM6115, 3.5 GB) earlyoom killed Hades every time it entered its first
# room: the client and its web helper held ~1.0-1.2 GB beside the game's ~2.4 GB (RAM, swap and
# ~1 GB of GPU buffers that cannot be swapped), and RAM plus swap in use reached ~6.98 of 7.13 GB.
# Without the client the same launch peaked at 5.49 GB with 1.5 GB of swap left, and Hades played
# (2026-10-22). Hades logs "SteamAPI failed to initialize!" and carries on; a game that needs Steam
# (Steam DRM, an online check) closes instead.
#
# WHAT IT RUNS: Steam's own last launch of the game on this device. Steam logs each one in
# <Steam>/logs/console_log.txt,
#   [2026-10-22 10:07:35] Game process added : AppID 1145360 "<command>", ProcID 8664, IP 0.0.0.0:0
# and ran <command> as `/bin/sh -c <command>`:
#   <Steam>/linuxarm64/steam-launch-wrapper --oom-score-adjust 900 -- <Steam>/steamrtarm64/reaper
#   SteamLaunch AppId=1145360 -- '<SteamLinuxRuntime_4-arm64>'/_v2-entry-point --verb=waitforexitandrun
#   -- '<Proton 11.0 (ARM64)>'/proton waitforexitandrun '<Hades>/x64Vk/Hades.exe' /c=..\ ...
# It is run the same way, so the launch option Steam chose (Hades has 18 of them, for betas and the
# Steam Deck), the player's own launch options, the compat tool and its runtime stay Steam's, and
# gamescope and OGUI see Steam's reaper as with the client. A game's newest such line (the last one in
# console_log.previous.txt then console_log.txt: by place, not by stamp, which a handheld's clock may
# have got wrong) is kept in ~/.cache/retroforge/steam-direct/<appid>.json when it is read, and
# /usr/bin/steam keeps every game's before each start of the client, so a log the client rotates away
# does not lose one. Install scripts are logged otherwise ("Running install script evaluator for
# AppID ..."), so the line is the game's own.
# With the environment Steam gives a game (steamclient.so names these), over the launch's own:
#   SteamAppId, SteamGameId, SteamOverlayGameId, STEAM_COMPAT_APP_ID   the app id
#   STEAM_COMPAT_CLIENT_INSTALL_PATH   <Steam>
#   STEAM_COMPAT_DATA_PATH             <library>/steamapps/compatdata/<appid> (the game's library)
#   STEAM_COMPAT_INSTALL_PATH          <library>/steamapps/common/<installdir>
#   STEAM_COMPAT_SHADER_PATH           <library>/steamapps/shadercache/<appid>
#   STEAM_COMPAT_LIBRARY_PATHS         every library's steamapps (what pressure-vessel shares)
#   STEAM_COMPAT_TOOL_PATHS            the command's compat tools (folders with a toolmanifest.vdf)
#   STEAM_COMPAT_CONFIG                Valve's per-game Proton setting, when there is one (appinfo.vdf,
#                                      app 891390 "SteamPlay 2.0 Manifests", app_compat_configs)
#   SteamDeck=1                        as the client sets it: /usr/bin/steam starts it with -steamdeck
# from the working folder of the appinfo.vdf launch entry that runs that executable, else the
# executable's own folder. And at the resolution Steam is set to run it at (its Properties > General >
# Game resolution: ResolutionOverride2 in the signed-in account's localconfig.vdf) or the one the player
# chose for it in Game settings, which the client gives the game's X server through gamescope
# (GAMESCOPE_XWAYLAND_MODE_CONTROL) before it starts it; the old size, the one Settings > Display >
# Game resolution gives that server (display_settings.gd), comes back when the game ends.
#
# Left to the client (check says why, and /usr/bin/steam starts Steam as before):
#   - the setting is off;
#   - a client already runs (~/.steam/steam.pid names a live `steam`), other than the kept one
#     (retroforge-steam.service: "Keep Steam running", on by default), which stays minimal beside the
#     game: Steam's UI is open, and the game goes to it;
#   - Steam has not started the game on this device yet. Its first launch goes through Steam, which
#     also runs the game's install scripts (DirectX, VC++ redistributables) and sets up its prefix;
#   - the game is not fully installed, or its files are changing (StateFlags beyond fully installed,
#     an update queued and a run Steam did not see end: an update, a download, a validation...);
#   - an x86 game, or an x86 Proton: Steam runs those through its FEX tool (app 3127680) and an x86
#     Steam Linux Runtime, with settings only the client makes;
#   - the command names no compat tool or no program of the game, or a path in a folder that is gone
#     (the compat tool was changed or uninstalled), or Steam's launch wrapper or reaper is gone.
# A launch option or compat tool the player changes in Steam reaches a game started this way once
# Steam has started it again (Main menu > Emulators > Steam Client, then the game from there).
# An update Steam has queued (StateFlags 2) does not stop a launch: Steam installs it once it runs
# (Main menu > Emulators > Steam Client), and the game runs its installed version until then.
# Not run without the client: the install scripts, the Cloud download before the game, the overlay and
# the Steam Linux Runtime's update. With the kept client beside the game (/usr/bin/steam), its Steam API
# connects to it: achievements, stats, playtime, Steam Input, and the Cloud upload when the game ends
# (Hades and a Steamworks probe on the MANGMI Air X, 2026-10-25). Without it, none of those either:
# saves stay on the device until Steam next uploads them, and the game reads the gamepad itself.
#
# THE SETTING is DIRECT_LAUNCH=on|off in ~/.config/retroforge/steam.conf, beside
# KEEP_RUNNING (the last such line counts; saving rewrites that line and keeps the others). The
# RetroForge plugin's Settings > Steam toggle "Steam: start games without Steam" runs this. Never
# set, it is on, on every board: the kept client beside the game keeps Steam's features, and Steam's
# full client comes up only when the player opens Steam (the user's choice, 2026-10-25; before, only
# the SM6115 and the 4 GB boards). RETROFORGE_STEAM_DIRECT=on|off overrides the file, for testing and
# debugging.
#
# Exit 0; 1 when the setting could not be saved, or (check, run) the game starts through Steam; 2 for a
# bad invocation.
#
# TEST SEAMS (tests/test-steam-direct.sh): RETROFORGE_STEAM_ROOT (also set by /usr/bin/steam),
# RETROFORGE_PROC (/proc), RETROFORGE_STEAM_LIBRARY (the steam-library whose readers this uses),
# XDG_CONFIG_HOME, XDG_CACHE_HOME,
# RETROFORGE_STEAM_XWAYLAND (a JSON file standing in for the game's X server), RETROFORGE_STEAM_DETACH
# (what starts the restore-resolution watcher: systemd-run).
import ctypes
import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
DATA = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
STEAM_ROOT = (os.environ.get("RETROFORGE_STEAM_ROOT") or os.path.join(DATA, "Steam")).rstrip("/")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "retroforge", "steam.conf")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "retroforge", "steam-direct")
PROC = os.environ.get("RETROFORGE_PROC", "/proc")
STEAM_LIBRARY = os.environ.get("RETROFORGE_STEAM_LIBRARY", "/usr/lib/retroforge/steam-library")
KEY = "DIRECT_LAUNCH"
# Steam's FEX tool and its x86 Steam Linux Runtimes (scout, soldier, sniper, 4.0).
X86_TOOLS = (3127680, 1070560, 1391110, 1628350, 4183110)
STEAMPLAY_MANIFESTS = 891390
# StateFlags of an app manifest: fully installed, and what may go with it for a game that can start:
# an update queued (2), a run Steam did not see end (64). Any other bit (files missing or corrupt, an
# update, a download, a validation, a move...) leaves the game to Steam.
FULLY_INSTALLED = 4
READY = FULLY_INSTALLED | 2 | 64
# Steam's own programs in a launch, which have to be there: its launch wrapper and its reaper.
LAUNCHERS = ("steam-launch-wrapper", "reaper")
OOM_SCORE_ADJ = 900  # `steam-launch-wrapper --oom-score-adjust 900`, as Steam starts its games
XWAYLAND = os.environ.get("RETROFORGE_STEAM_XWAYLAND", "")
DETACH = os.environ.get("RETROFORGE_STEAM_DETACH", "systemd-run --user --quiet --collect --")
XA_CARDINAL, PROP_MODE_REPLACE = 6, 0
LAUNCH = re.compile(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\] Game process added : AppID (\d+) "(.*)", ProcID \d+')


def log(msg):
    print(f"retroforge-steam-direct: {msg}", file=sys.stderr, flush=True)


class Refused(Exception):
    """The game starts through Steam; the message says why."""


def steam_library():
    """/usr/lib/retroforge/steam-library as a module: its VDF readers and library folders."""
    loader = importlib.machinery.SourceFileLoader("steam_library", STEAM_LIBRARY)
    spec = importlib.util.spec_from_loader("steam_library", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# ------------------------------------------------------------------------------------------------
# The setting


def saved():
    """The player's choice: on, off, or None when there is none."""
    value = None
    try:
        with open(CONF, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith(KEY + "="):
                    value = line.rstrip("\n")[len(KEY) + 1:]
    except OSError:
        return None
    return value if value in ("on", "off") else None


def state():
    """(on|off, where that comes from)."""
    env = os.environ.get("RETROFORGE_STEAM_DIRECT", "")
    if env in ("on", "off"):
        return env, "RETROFORGE_STEAM_DIRECT"
    choice = saved()
    if choice:
        return choice, CONF
    return "on", "the default"


def save(value):
    lines = []
    try:
        with open(CONF, encoding="utf-8", errors="surrogateescape") as f:
            lines = [line for line in f if not line.startswith(KEY + "=")]
    except FileNotFoundError:
        lines = ["# Steam settings of the RetroForge shell (retroforge-steam-keep, -direct). Safe to edit.\n"]
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    lines.append(f"{KEY}={value}\n")
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".part"
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.writelines(lines)
    os.replace(tmp, CONF)


# ------------------------------------------------------------------------------------------------
# The launch


def client_running():
    """True while a Steam client other than the kept one (retroforge-steam.service, in the background)
    runs: ~/.steam/steam.pid names a live process called steam (the client leaves the file behind when
    it is killed)."""
    try:
        with open(os.path.join(HOME, ".steam", "steam.pid")) as f:
            pid = f.read().strip()
        if not pid.isdigit():
            return False
        with open(os.path.join(PROC, pid, "comm")) as f:
            if f.read().strip() != "steam":
                return False
    except OSError:
        return False
    try:
        with open(os.path.join(PROC, pid, "cgroup")) as f:
            return "/retroforge-steam.service" not in f.read()
    except OSError:
        return True


def logged_launches():
    """{appid: (stamp, command)}: each game's newest launch in Steam's logs. Newest by place, not by
    stamp: the client only appends, and rotates console_log.txt to console_log.previous.txt, so the
    last line wins even when the handheld's clock was wrong (or not yet set) when it was written."""
    found = {}
    for name in ("console_log.previous.txt", "console_log.txt"):
        try:
            with open(os.path.join(STEAM_ROOT, "logs", name), encoding="utf-8", errors="surrogateescape") as f:
                for line in f:
                    if "Game process added" not in line:
                        continue
                    m = LAUNCH.match(line)
                    # Not a game the client did not start (one started without it, beside the kept
                    # client): it logs that one too, with an empty command.
                    if m and f" SteamLaunch AppId={m.group(2)} " in f" {m.group(3)} ":
                        found[int(m.group(2))] = (m.group(1), m.group(3))
        except OSError:
            continue
    return found


def kept(appid):
    """The (stamp, command) kept for appid, else None."""
    try:
        with open(os.path.join(CACHE, f"{appid}.json"), encoding="utf-8") as f:
            cached = json.load(f)
        return str(cached["logged"]), str(cached["command"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def keep(appid, launch):
    """Keep launch for appid, unless it is what is kept already."""
    if kept(appid) == launch:
        return
    try:
        os.makedirs(CACHE, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=CACHE, prefix=f".{appid}-")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"logged": launch[0], "command": launch[1]}, f)
        os.replace(tmp, os.path.join(CACHE, f"{appid}.json"))
    except OSError as err:
        log(f"could not keep Steam's launch of app {appid}: {err}")


def remember():
    """Keep every game's newest logged launch (/usr/bin/steam runs this before the client starts, which
    may rotate its log); the number of games."""
    found = logged_launches()
    for appid, launch in found.items():
        keep(appid, launch)
    return len(found)


def logged_launch(appid):
    """(stamp, command) of Steam's newest logged launch of appid (kept), else the kept one; None when
    there is neither."""
    launch = logged_launches().get(appid)
    if launch is None:
        return kept(appid)
    keep(appid, launch)
    return launch


def manifest(sl, appid):
    """(library, installdir, StateFlags) of appid's app manifest in any library, else None."""
    for lib in sl.library_dirs(STEAM_ROOT):
        fields = {}
        for depth, key, value in sl.vdf_pairs(sl.read_text(os.path.join(lib, "steamapps", f"appmanifest_{appid}.acf"))):
            if depth == 1 and key in ("installdir", "StateFlags") and key not in fields:
                fields[key] = value
        if fields:
            flags = fields.get("StateFlags", "0")
            return lib, fields.get("installdir", ""), int(flags) if flags.isdigit() else 0
    return None


def under(path, folder):
    """True when path is folder or inside it, both resolved (a library may be named through a link)."""
    if not path or not folder:
        return False
    path, folder = os.path.realpath(path), os.path.realpath(folder)
    return path == folder or path.startswith(folder.rstrip("/") + "/")


# Steam's choice of tool for a game: config.vdf's CompatToolMapping, its own entry, else "0".
VDF_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])|//[^\n]*')


def vdf_tree(path):
    """A text VDF as nested dicts, keys lowercased; {} when it cannot be read."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return {}
    stack, cur, key = [], {}, None
    for m in VDF_TOKEN.finditer(text):
        s, brace = m.group(1), m.group(2)
        if brace == "{":
            new = {}
            if key is not None:
                cur[key.lower()] = new
            stack.append(cur)
            cur, key = new, None
        elif brace == "}":
            cur, key = (stack.pop() if stack else cur), None
        elif s is not None:
            if key is None:
                key = s
            else:
                cur[key.lower()] = s
                key = None
    return stack[0] if stack else cur


def mapped_tool(appid):
    """The compatibilitytools.d folder of the tool Steam is set to use for appid; "" for one of Steam's
    own tools (its logged launch has that already) or none."""
    m = vdf_tree(os.path.join(STEAM_ROOT, "config", "config.vdf"))
    for k in ("installconfigstore", "software", "valve", "steam", "compattoolmapping"):
        m = m.get(k, {}) if isinstance(m, dict) else {}
    entry = m.get(str(appid))
    if not (isinstance(entry, dict) and entry.get("name")):
        entry = m.get("0")
    name = entry.get("name", "") if isinstance(entry, dict) else ""
    tools = os.path.join(STEAM_ROOT, "compatibilitytools.d")
    if not name or not os.path.isdir(tools):
        return ""
    for d in sorted(os.listdir(tools)):
        folder = os.path.join(tools, d)
        names = vdf_tree(os.path.join(folder, "compatibilitytool.vdf")).get("compatibilitytools", {}).get("compat_tools", {})
        if isinstance(names, dict) and name.lower() in names:
            return folder
    return ""


def runtime_of(tool):
    """The tool appid a compat tool's toolmanifest.vdf requires ("" for none)."""
    manifest = vdf_tree(os.path.join(tool, "toolmanifest.vdf")).get("manifest", {})
    return str(manifest.get("require_tool_appid", "")) if isinstance(manifest, dict) else ""


def swap_tool(appid, tools, command, want=None):
    """tools and command with the Proton Steam logged replaced by want, else by
    the one Steam is set to now, when that is a compatibilitytools.d tool on the same runtime."""
    proton = [t for t in tools if os.path.isfile(os.path.join(t, "proton"))]
    want = want or mapped_tool(appid)
    if (len(proton) != 1 or not want or want == proton[0] or proton[0] not in command
            or not os.path.isfile(os.path.join(want, "proton")) or runtime_of(want) != runtime_of(proton[0])):
        return tools, command
    log(f"app {appid} runs with {os.path.basename(want)}, not {os.path.basename(proton[0])} as last logged")
    return [want if t == proton[0] else t for t in tools], command.replace(proton[0], want)


# The player's per-game choices (Game settings, steam_game_settings.gd), keyed by app id.
GAMES = os.path.join(os.path.dirname(CONF), "steam-games.json")
CHOICES = {"tso": ("default", "on", "off"), "driver": ("default", "native", "x86")}


def read_games():
    try:
        with open(GAMES, encoding="utf-8") as f:
            games = json.load(f)
    except (OSError, ValueError):
        return {}
    return games if isinstance(games, dict) else {}


def game_settings(appid):
    """tso, launch, resolution and driver for appid: "default" for each one not chosen."""
    mine = read_games().get(str(appid))
    mine = mine if isinstance(mine, dict) else {}
    return {k: str(mine.get(k, "default")) for k in ("tso", "launch", "resolution", "driver")}


def tso_hint(app):
    """Valve's TSO setting for app on the Steam Frame (appinfo common/steam_frame_compatibility), "0", "1" or ""."""
    frame = app.get("appinfo", app).get("common", {}).get("steam_frame_compatibility", {})
    value = frame.get("configuration", {}).get("tso_enable", "") if isinstance(frame, dict) else ""
    return str(value) if str(value) in ("0", "1") else ""


def save_game_setting(appid, key, value):
    games = read_games()
    mine = games.get(str(appid)) if isinstance(games.get(str(appid)), dict) else {}
    if value == "default":
        mine.pop(key, None)
    else:
        mine[key] = value
    if mine:
        games[str(appid)] = mine
    else:
        games.pop(str(appid), None)
    os.makedirs(os.path.dirname(GAMES), exist_ok=True)
    with open(GAMES + ".part", "w", encoding="utf-8") as f:
        json.dump(games, f, indent=1, sort_keys=True)
    os.replace(GAMES + ".part", GAMES)

# ------------------------------------------------------------------------------------------------
# x86 games: their graphics driver (Game settings > RetroForge > Graphics driver)
#
# Steam runs an x86 Linux game through its FEX tool, in pressure-vessel's x86 container, where the game
# loads the x86 Mesa of our FEX guest (the graphics provider, /run/gfx/main): the driver then runs
# emulated too. FEX can hand GL to the device's own arm64 Mesa instead (a "thunk"): the game's
# libGL.so.1 becomes FEX's guest thunk library, whose calls run the host's driver natively (/run/host
# in the container). Valve's tool ships it off. Two files in the game's FEX folder
# (<library>/steamapps/compatdata/<appid>/fex-emu) turn it on:
#   ThunksDB.json  FEX's thunk database, with the paths an x86 loader opens there. Valve's names only
#                  @PREFIX_LIB@ paths, which FEX expands to lib64 folders in the container (its
#                  multiarch check looks in the game's working folder when the root is empty), so they
#                  never match and the game keeps the x86 driver even with the thunk on
#   AppConfig/Steam_<appid>_<program>.json  {"ThunksDB": {"GL": 1}}, for each x86 program in the game's
#                  folder: FEX keys app configs by app id and program, so pressure-vessel's own x86
#                  probes keep the x86 driver
# Megabonk on the Air X (2026-11-23): the same frame rate (the A610 is its limit), ~20% less of the
# CPU, its load ~2.5 s shorter.
# Vulkan goes through FEX's Vulkan thunk too (64-bit only: Valve's tool has no 32-bit Vulkan guest
# library). The host side's loader sees only the container's manifests, so the program's file also
# names the device's Turnip for it (HostEnv VK_DRIVER_FILES -> retroforge-vulkan-icd.json, the host's
# manifest with the library under /run/host) and empties Steam's VK_INSTANCE_LAYERS there (Valve's
# Frame layers, which do not exist here; one HostEnv per JSON block, so through AppOverrides "*").
# Megabonk on Vulkan (-force-vulkan, Air X, 2026-11-24): menu 108-111% of a core against 116-118% on
# x86 Turnip, a run 207-233% against 237-244%, 19-20 frames a second against 18, and it gets the
# gamescope WSI layer, which the x86 driver does not. (Its earlier out-of-memory was mesa's VRAM report
# limit layer with the shell's limit, which reported the real usage against a scaled budget; mesa
# patch 0025 scales both.)
# FEX TSO goes in the same file (TSOEnabled): the player's choice, else Valve's hint for the game
# (appinfo common/steam_frame_compatibility/configuration/tso_enable), as Valve's client sets it on the
# Steam Frame; neither, and FEX's own default (on) stays. An x86 game never starts without the client,
# so this file is the only way a TSO choice reaches it.
# Native is the default; x86 removes our files. A file without our "RetroForge" key is the player's own
# and stays. Proton games (a pfx in their compat data) and games with no x86 program are left alone.
# TEST SEAMS: RETROFORGE_STEAM_FEX_DEPTH (how deep the game's folder is searched, 3);
# RETROFORGE_VULKAN_ICD (the device's Turnip manifest; none there: GL only).
MARK = "written by retroforge-steam-direct for the game's graphics driver (Game settings)"
FEX_DIRS = {
    64: ("/usr/lib/pressure-vessel/overrides/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu",
         "/lib/x86_64-linux-gnu", "/run/gfx/main/usr/lib", "/run/gfx/usr/lib", "/usr/lib", "/usr/lib64"),
    32: ("/usr/lib/pressure-vessel/overrides/lib/i386-linux-gnu", "/usr/lib/i386-linux-gnu",
         "/lib/i386-linux-gnu", "/run/gfx/main/usr/lib32", "/run/gfx/usr/lib32", "/usr/lib32"),
}


VULKAN_ICD = os.environ.get("RETROFORGE_VULKAN_ICD", "/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json")
ICD_NAME = "retroforge-vulkan-icd.json"  # in the game's FEX folder; only ever ours


def thunk_db(vulkan):
    def paths(names, sizes=(64, 32)):
        return [f"{d}/{n}" for bits in sizes for d in FEX_DIRS[bits] for n in names]
    db = {"GL": {"Library": "libGL-guest.so", "Overlay": paths(["libGL.so", "libGL.so.1", "libGL.so.1.2.0", "libGL.so.1.7.0"])}}
    if vulkan:  # Valve's entry adds Steam's own pinned copy, which FEX expands
        db["Vulkan"] = {"Library": "libvulkan-guest.so", "Overlay": paths(["libvulkan.so", "libvulkan.so.1"], (64,))
                        + ["@HOME@/.local/share/Steam/ubuntu12_32/steam-runtime/pinned_libs_64/libvulkan.so.1"]}
    return {"RetroForge": MARK, "DB": db}


def host_vulkan_icd():
    """The device's Turnip manifest as the host side sees it in the container (/run/host), else None."""
    try:
        with open(VULKAN_ICD, encoding="utf-8") as f:
            icd = json.load(f)
        path = icd["ICD"]["library_path"]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if not isinstance(path, str) or not path.startswith("/"):
        return None
    icd["ICD"]["library_path"] = "/run/host" + path
    return icd


def fex_tso(appid):
    """TSOEnabled for an x86 game: "1"/"0" from the player's choice, else Valve's hint, else ""."""
    choice = game_settings(appid)["tso"]
    if choice in ("on", "off"):
        return "1" if choice == "on" else "0"
    sl = steam_library()
    try:
        app = sl.read_app_nodes(os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf"), {appid}).get(appid, {})
    except (OSError, sl.Unreadable):
        return ""
    return tso_hint(app)


def x86_programs(folder):
    """Names of the x86 programs in folder (ELF x86-64 or i386 with an interpreter), a few levels deep."""
    depth = int(os.environ.get("RETROFORGE_STEAM_FEX_DEPTH", "3"))
    found = set()
    base = folder.rstrip("/").count("/")
    for top, dirs, files in os.walk(folder):
        if top.count("/") - base >= depth:
            dirs[:] = []
        for name in files:
            path = os.path.join(top, name)
            try:
                if not os.stat(path).st_mode & 0o111:
                    continue
                with open(path, "rb") as f:
                    head = f.read(64)
                    if len(head) < 52 or head[:4] != b"\x7fELF" or head[5] != 1:
                        continue
                    bits = {1: 32, 2: 64}.get(head[4])
                    machine = int.from_bytes(head[18:20], "little")
                    if (bits, machine) not in ((64, 62), (32, 3)):
                        continue
                    if bits == 64:
                        phoff, phsize, phnum = int.from_bytes(head[32:40], "little"), *(int.from_bytes(head[i:i + 2], "little") for i in (54, 56))
                    else:
                        phoff, phsize, phnum = int.from_bytes(head[28:32], "little"), *(int.from_bytes(head[i:i + 2], "little") for i in (42, 44))
                    f.seek(phoff)
                    table = f.read(phsize * min(phnum, 64))
                if any(int.from_bytes(table[i:i + 4], "little") == 3 for i in range(0, len(table) - 3, phsize or 1)):
                    found.add(name)
            except (OSError, ValueError):
                continue
    return sorted(found)


def x86_game(appid):
    """(FEX folder, its x86 programs) of an installed x86 Linux game, else None."""
    found = manifest(steam_library(), appid)
    if not found or not found[1].strip("/."):
        return None
    lib, installdir, _ = found
    data = os.path.join(lib, "steamapps", "compatdata", str(appid))
    if os.path.isdir(os.path.join(data, "pfx")):
        return None
    programs = x86_programs(os.path.join(lib, "steamapps", "common", installdir))
    return (os.path.join(data, "fex-emu"), programs) if programs else None


def ours(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f).get("RetroForge") == MARK
    except (OSError, ValueError, AttributeError):
        return False


def write_json(path, value):
    """path holds value (ours) unless a file of the player's is there; True when it changed."""
    text = json.dumps(value, indent=1) + "\n"
    try:
        with open(path, encoding="utf-8") as f:
            old = f.read()
    except OSError:
        old = None
    if old == text or (old is not None and not ours(path)):
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".part", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".part", path)
    return True


# A Proton game the client starts gets no STEAM_FEX_TSOENABLED from us (a launch without the client
# does, plan() below), and the arm64 client sets none. Our Proton (Proton-CachyOS) reads a per-game
# compatdata/<appid>/user_settings.py before it writes the game's FEX config (Valve's Proton 11 reads
# only its own), so that file carries the same choice: the player's, else Valve's hint. /usr/bin/steam
# asks for it before a launch through the client. A user_settings.py that is not one of ours is the
# player's and is left alone.
TSO_SETTINGS = """\
# Written by retroforge-steam-direct: FEX TSO for this game when Steam starts it (Game settings > FEX
# TSO, else Valve's setting for the game on the Steam Frame). Edit it and it is yours.
user_settings = {{
    "STEAM_FEX_TSOENABLED": "{}",
}}
"""


def proton_tso(appid):
    """A Proton game's FEX TSO for launches through the client (compatdata/<appid>/user_settings.py)."""
    found = manifest(steam_library(), appid)
    if not found:
        return
    data = os.path.join(found[0], "steamapps", "compatdata", str(appid))
    if not os.path.isdir(os.path.join(data, "pfx")):
        return
    path = os.path.join(data, "user_settings.py")
    tso = fex_tso(appid)
    want = TSO_SETTINGS.format(tso) if tso else None
    try:
        with open(path, encoding="utf-8") as f:
            have = f.read()
    except OSError:
        have = None
    if have == want or (have is not None and have not in (TSO_SETTINGS.format("0"), TSO_SETTINGS.format("1"))):
        return
    if want:
        with open(path + ".part", "w", encoding="utf-8") as f:
            f.write(want)
        os.replace(path + ".part", path)
    else:
        os.remove(path)
    log(f"app {appid}: FEX TSO " + ({"1": "on", "0": "off"}[tso] if tso else "as Proton has it")
        + " when Steam starts it")


def fex_driver(appid):
    """Give an x86 game the driver chosen for it (native: GL and Vulkan through FEX's thunks)."""
    game = x86_game(appid)
    if not game:
        return
    folder, programs = game
    native = game_settings(appid)["driver"] in ("default", "native")
    icd = host_vulkan_icd() if native else None
    icd_path = os.path.join(folder, ICD_NAME)
    tso = fex_tso(appid)
    changed = False
    if native:
        changed |= write_json(os.path.join(folder, "ThunksDB.json"), thunk_db(icd is not None))
        config = {"RetroForge": MARK, "ThunksDB": {"GL": 1}}
        if icd:
            text = json.dumps(icd, indent=1) + "\n"
            try:
                with open(icd_path, encoding="utf-8") as f:
                    same = f.read() == text
            except OSError:
                same = False
            if not same:
                os.makedirs(folder, exist_ok=True)
                with open(icd_path + ".part", "w", encoding="utf-8") as f:
                    f.write(text)
                os.replace(icd_path + ".part", icd_path)
                changed = True
            config = {"RetroForge": MARK, "Config": {"HostEnv": f"VK_DRIVER_FILES={icd_path}"},
                      "AppOverrides": {"*": {"HostEnv": "VK_INSTANCE_LAYERS="}}, "ThunksDB": {"GL": 1, "Vulkan": 1}}
        if tso:
            config.setdefault("Config", {})["TSOEnabled"] = tso
        for name in programs:
            changed |= write_json(os.path.join(folder, "AppConfig", f"Steam_{appid}_{name}.json"), config)
    elif tso:
        for name in programs:
            changed |= write_json(os.path.join(folder, "AppConfig", f"Steam_{appid}_{name}.json"),
                                  {"RetroForge": MARK, "Config": {"TSOEnabled": tso}})
    for path in glob.glob(os.path.join(glob.escape(folder), "AppConfig", f"Steam_{appid}_*.json")) \
            + [os.path.join(folder, "ThunksDB.json")]:
        name = os.path.basename(path)[len(f"Steam_{appid}_"):-len(".json")]
        keep = (native and path.endswith("/ThunksDB.json")) or (name in programs and (native or bool(tso)))
        if not keep and ours(path):
            os.remove(path)
            changed = True
    if not icd and os.path.exists(icd_path):
        os.remove(icd_path)
        changed = True
    if changed:
        what = "GL and Vulkan" if icd else "GL"
        log(f"app {appid}: " + (f"{what} through the device's own driver (FEX's thunks) for {', '.join(programs)}"
                                if native else "GL and Vulkan through the x86 driver in FEX's guest")
            + (f", FEX TSO {'on' if tso == '1' else 'off'}" if tso else ""))


def beta_key(sl, appid):
    """The branch appid is installed from, from its app manifest: "" for the public one."""
    for lib in sl.library_dirs(STEAM_ROOT):
        for depth, key, value in sl.vdf_pairs(sl.read_text(os.path.join(lib, "steamapps", f"appmanifest_{appid}.acf"))):
            if depth == 2 and key.lower() == "betakey":
                return value
    return ""


def launch_entries(app, beta="", every=False):
    """The launch entries Steam's dialog offers here (64-bit Windows, as a Steam Deck, on branch beta;
    all of them with every), in Steam's order: key, description, executable and workingdir (relative),
    arguments."""
    launch = app.get("appinfo", app).get("config", {}).get("launch", {})
    entries = []
    order = lambda kv: (0, int(kv[0]), "") if str(kv[0]).isdigit() else (1, 0, str(kv[0]))
    for key, entry in sorted(launch.items(), key=order) if isinstance(launch, dict) else ():
        if not isinstance(entry, dict) or not entry.get("executable"):
            continue
        config = entry.get("config") if isinstance(entry.get("config"), dict) else {}
        config = {str(k).lower(): str(v) for k, v in config.items()}
        if not every and (entry.get("type") == "none" or (config.get("oslist") and "windows" not in config["oslist"])
                          or config.get("osarch", "64") != "64" or config.get("betakey", beta) != beta
                          or config.get("steamdeck") == "0"):
            continue
        path = str(entry["executable"]).replace("\\", "/")
        path = path[2:] if path.startswith("./") else path.lstrip("/")
        loc = entry.get("description_loc") if isinstance(entry.get("description_loc"), dict) else {}
        text = loc.get("english") or entry.get("description") or path
        entries.append({"key": str(key), "description": str(text), "executable": path,
                        "workingdir": str(entry.get("workingdir") or "").replace("\\", "/").strip("/"),
                        "arguments": str(entry.get("arguments") or "")})
    return entries


def steam_words(arguments):
    """A launch entry's arguments as the words Steam passes: split at spaces, "quoted" parts kept whole."""
    return [w.replace('"', "") for w in re.findall(r'(?:[^\s"]+|"[^"]*")+', arguments)]


def with_entry(command, words, exe, game, entries, entry):
    """command with exe and its arguments replaced by entry's program and arguments, and whether its
    arguments were: those of exe's entry (the longest) whose words follow it in command. Words after
    them, the player's own launch options, stay; with no such entry, all of them do."""
    after = words[words.index(exe) + 1:]
    rel = os.path.relpath(os.path.realpath(exe), os.path.realpath(game)).casefold()
    olds = [steam_words(e["arguments"]) for e in entries if e["executable"].casefold() == rel]
    old = max((w for w in olds if after[:len(w)] == w), key=len, default=None)
    start = command.index(exe)
    end = start + len(exe)
    if command[start - 1:start] in ("'", '"') and command[end:end + 1] == command[start - 1]:
        end += 1  # its closing quote
    head = command[:start] + os.path.join(game, entry["executable"]) + command[start + len(exe):end]
    if old is None:
        return head + command[end:], False
    lexer = shlex.shlex(command[end:], posix=True)
    lexer.whitespace_split, lexer.commenters = True, ""
    for _ in old:
        lexer.get_token()
    rest = command[end:][lexer.instream.tell():] if old else command[end:]
    new = "".join(" " + shlex.quote(w) for w in steam_words(entry["arguments"]))
    return head + new + (" " + rest.lstrip() if rest.strip() else ""), True


def plan(appid):
    """{command, env (to add), workdir, stamp, waiting (an update is queued)} of the launch; Refused
    when there is none."""
    stamp_command = logged_launch(appid)
    if not stamp_command:
        raise Refused("Steam has not started it on this device yet (its first launch goes through Steam)")
    stamp, command = stamp_command
    if f" SteamLaunch AppId={appid} " not in f" {command} ":
        raise Refused(f"Steam's launch of {stamp} is not one this can replay")
    try:
        words = shlex.split(command)
    except ValueError:
        raise Refused(f"Steam's launch of {stamp} does not parse")
    sl = steam_library()
    found = manifest(sl, appid)
    if not found:
        raise Refused("it is not installed")
    lib, installdir, flags = found
    if not flags & FULLY_INSTALLED or flags & ~READY:
        raise Refused(f"its files are not ready (StateFlags {flags}): Steam is installing, updating or checking it")
    if not installdir.strip("/."):
        raise Refused("its app manifest names no folder")
    libraries = sl.library_dirs(STEAM_ROOT)
    game = os.path.join(lib, "steamapps", "common", installdir)

    # The programs the command names: the compat tools (a folder with a toolmanifest.vdf) and the game's
    # executable (the first of its files). A path in a folder that is gone is a tool Steam has replaced
    # or uninstalled; a file not there yet in a folder that is (a log the game is told to write) is not.
    x86 = []
    for tool in X86_TOOLS:
        where = manifest(sl, tool)
        if where and where[1]:
            x86.append(os.path.join(where[0], "steamapps", "common", where[1]))
    roots = [STEAM_ROOT] + libraries
    tools, exe = [], ""
    for word in words:
        if not word.startswith("/") or not any(under(word, r) for r in roots):
            continue   # an argument (Hades: /c=..\), not a path of Steam's
        if any(under(word, d) for d in x86):
            raise Refused("Steam runs it through its FEX tool (an x86 game or Proton), which needs the client")
        folder = os.path.dirname(word)
        if not os.path.isdir(folder) or (os.path.basename(word) in LAUNCHERS and not os.path.isfile(word)):
            raise Refused(f"{word} is gone (Steam starts it again with what is installed now)")
        if os.path.isfile(os.path.join(folder, "toolmanifest.vdf")):
            if not os.path.exists(word):
                raise Refused(f"{word} is gone (Steam starts it again with what is installed now)")
            if folder not in tools:
                tools.append(folder)
        elif not exe and under(word, game) and os.path.isfile(word):
            exe = word
    if not tools:
        raise Refused(f"Steam's launch of {stamp} names no compat tool")
    if not exe:
        raise Refused(f"Steam's launch of {stamp} names no program of the game")
    choice = game_settings(appid)
    tools, command = swap_tool(appid, tools, command)

    appinfo = {}
    try:
        appinfo = sl.read_app_nodes(os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf"), {appid, STEAMPLAY_MANIFESTS})
    except (OSError, sl.Unreadable) as err:
        log(f"appinfo.vdf: {err}; the game runs from its executable's folder, without Valve's Proton setting")
    entry_dir = ""
    if choice["launch"] != "default":
        app = appinfo.get(appid, {})
        entry = next((e for e in launch_entries(app, beta_key(sl, appid)) if e["key"] == choice["launch"]), None)
        other = os.path.join(game, entry["executable"]) if entry else ""
        if entry and os.path.isfile(other) and exe in command:
            command, args = with_entry(command, words, exe, game, launch_entries(app, every=True), entry)
            exe, entry_dir = other, entry["workingdir"]
            log(f"app {appid} runs its launch option {entry['description']!r}"
                + ("" if args else ", with the arguments Steam last gave it (no entry of its program has them)"))
        else:
            log(f"app {appid}: its launch option {choice['launch']} is not there; Steam's last launch stays")
    workdir = workingdir(appinfo.get(appid, {}), game, exe)
    if entry_dir and os.path.isdir(os.path.join(game, entry_dir)):
        workdir = os.path.join(game, entry_dir)
    config = compat_config(appinfo.get(STEAMPLAY_MANIFESTS, {}), appid)
    env = {
        "SteamAppId": str(appid), "SteamGameId": str(appid), "SteamOverlayGameId": str(appid),
        "STEAM_COMPAT_APP_ID": str(appid),
        "STEAM_COMPAT_CLIENT_INSTALL_PATH": STEAM_ROOT,
        "STEAM_COMPAT_DATA_PATH": os.path.join(lib, "steamapps", "compatdata", str(appid)),
        "STEAM_COMPAT_INSTALL_PATH": game,
        "STEAM_COMPAT_SHADER_PATH": os.path.join(lib, "steamapps", "shadercache", str(appid)),
        "STEAM_COMPAT_LIBRARY_PATHS": ":".join(os.path.join(d, "steamapps") for d in libraries),
        # Innermost first, as Steam lists them: Proton, then the runtime it runs in.
        "STEAM_COMPAT_TOOL_PATHS": ":".join(reversed(tools)),
        "SteamDeck": "1",
    }
    if config:
        env["STEAM_COMPAT_CONFIG"] = config
    # Proton's FEX config for the game (proton-fex-config.json): the player's choice, else Valve's hint, as
    # Valve's client sets it on the Steam Frame. Hades (hint off), Air X, 2026-11-24: its menu 181-185% of
    # a core against 188-189% with TSO on, the same 59-60 frames a second.
    tso = {"on": "1", "off": "0"}.get(choice["tso"]) or tso_hint(appinfo.get(appid, {}))
    if tso:
        env["STEAM_FEX_TSOENABLED"] = tso
    return {"command": command, "env": env, "workdir": workdir, "stamp": stamp, "waiting": bool(flags & 2)}


def workingdir(app, game, exe):
    """The working folder of the launch entry that runs exe, else exe's folder."""
    rel = os.path.relpath(os.path.realpath(exe), os.path.realpath(game)) if under(exe, game) else ""
    launch = app.get("appinfo", app).get("config", {}).get("launch", {})
    for entry in launch.values() if isinstance(launch, dict) else ():
        if not isinstance(entry, dict):
            continue
        path = str(entry.get("executable", "")).replace("\\", "/")
        path = path[2:] if path.startswith("./") else path.lstrip("/")
        wd = str(entry.get("workingdir", "")).replace("\\", "/").strip("/")
        if rel and path.casefold() == rel.casefold() and wd:
            folder = os.path.join(game, wd)
            if os.path.isdir(folder):
                return folder
    return os.path.dirname(exe)


def compat_config(manifests, appid):
    """Valve's per-game Proton setting for appid ("" when there is none)."""
    configs = manifests.get("appinfo", manifests).get("extended", {}).get("app_compat_configs", {})
    for entry in configs.values() if isinstance(configs, dict) else ():
        if isinstance(entry, dict) and str(entry.get("appid", "")) == str(appid):
            value = str(entry.get("config", "")).strip()
            return "" if value == "none" else value
    return ""


def decide(appid):
    """The launch (plan) when appid starts without the client; None while the setting is off; Refused,
    saying why, for anything else."""
    if state()[0] != "on":
        return None
    if client_running():
        raise Refused("the Steam client is running: the game goes to it")
    return plan(appid)


def game_resolution(appid):
    """(width, height) Steam runs appid at, from the localconfig.vdf of the account the client last
    signed in to (else the newest one); None for its Default, gamescope's own size."""
    users = vdf_tree(os.path.join(STEAM_ROOT, "config", "loginusers.vdf")).get("users", {})
    ids = [i for i, u in users.items() if i.isdigit() and isinstance(u, dict) and u.get("mostrecent") == "1"]
    paths = [os.path.join(STEAM_ROOT, "userdata", str(int(i) & 0xFFFFFFFF), "config", "localconfig.vdf") for i in ids]
    paths = [p for p in paths if os.path.isfile(p)] \
        or sorted(glob.glob(os.path.join(STEAM_ROOT, "userdata", "*", "config", "localconfig.vdf")), key=os.path.getmtime)[-1:]
    stack = [vdf_tree(paths[0])] if paths else []
    while stack:
        node = stack.pop()
        app = node.get(str(appid))
        if isinstance(app, dict) and "resolutionoverride2" in app:
            m = re.fullmatch(r"(\d+)x(\d+)", app["resolutionoverride2"].strip())
            return (int(m.group(1)), int(m.group(2))) if m and int(m.group(1)) and int(m.group(2)) else None
        stack.extend(v for v in node.values() if isinstance(v, dict))
    return None


def sane_size(value):
    """True for "WxH" with both from 64 to 16384 (Game settings offers Settings > Display's sizes)."""
    m = re.fullmatch(r"(\d+)x(\d+)", value)
    return bool(m) and all(64 <= int(n) <= 16384 for n in m.groups())


def xwayland(display, size=None):
    """(gamescope server id, width, height) of display's X server, else None (not one of gamescope's).
    With size, it is then asked to give that server size, as the client does: GAMESCOPE_XWAYLAND_MODE_CONTROL
    on its root, server id, width, height, and 0 for no larger than the screen."""
    if XWAYLAND:
        try:
            with open(XWAYLAND, encoding="utf-8") as f:
                state = json.load(f)
        except (OSError, ValueError):
            return None
        if state.get("display") != display:
            return None
        before = (state["id"], state["width"], state["height"])
        if size:
            state.update(width=size[0], height=size[1])
            with open(XWAYLAND, "w", encoding="utf-8") as f:
                json.dump(state, f)
        return before
    c = ctypes
    x = c.CDLL("libX11.so.6")
    x.XOpenDisplay.restype, x.XOpenDisplay.argtypes = c.c_void_p, [c.c_char_p]
    x.XDefaultRootWindow.restype, x.XDefaultRootWindow.argtypes = c.c_ulong, [c.c_void_p]
    x.XInternAtom.restype, x.XInternAtom.argtypes = c.c_ulong, [c.c_void_p, c.c_char_p, c.c_int]
    x.XDisplayWidth.argtypes = x.XDisplayHeight.argtypes = [c.c_void_p, c.c_int]
    x.XGetWindowProperty.argtypes = [c.c_void_p, c.c_ulong, c.c_ulong, c.c_long, c.c_long, c.c_int, c.c_ulong,
                                     c.POINTER(c.c_ulong), c.POINTER(c.c_int), c.POINTER(c.c_ulong),
                                     c.POINTER(c.c_ulong), c.POINTER(c.c_void_p)]
    x.XChangeProperty.argtypes = [c.c_void_p, c.c_ulong, c.c_ulong, c.c_ulong, c.c_int, c.c_int, c.c_void_p, c.c_int]
    x.XFree.argtypes = x.XFlush.argtypes = x.XCloseDisplay.argtypes = [c.c_void_p]
    on_error = c.CFUNCTYPE(c.c_int, c.c_void_p, c.c_void_p)(lambda dpy, event: 0)  # Xlib's own exits
    x.XSetErrorHandler.argtypes = [c.c_void_p]
    x.XSetErrorHandler(c.cast(on_error, c.c_void_p))
    dpy = x.XOpenDisplay(display.encode())
    if not dpy:
        return None
    try:
        root, sid = x.XDefaultRootWindow(dpy), None
        atom = x.XInternAtom(dpy, b"GAMESCOPE_XWAYLAND_SERVER_ID", True)
        kind, fmt, n, left, data = c.c_ulong(), c.c_int(), c.c_ulong(), c.c_ulong(), c.c_void_p()
        if atom and x.XGetWindowProperty(dpy, root, atom, 0, 1, False, XA_CARDINAL, c.byref(kind), c.byref(fmt),
                                         c.byref(n), c.byref(left), c.byref(data)) == 0 and data.value:
            if fmt.value == 32 and n.value == 1:
                sid = c.cast(data, c.POINTER(c.c_ulong))[0]  # format 32 comes as longs
            x.XFree(data)
        if sid is None:
            return None
        before = (sid, x.XDisplayWidth(dpy, 0), x.XDisplayHeight(dpy, 0))
        if size:
            values = (c.c_ulong * 4)(sid, size[0], size[1], 0)
            mode = x.XInternAtom(dpy, b"GAMESCOPE_XWAYLAND_MODE_CONTROL", False)
            x.XChangeProperty(dpy, root, mode, XA_CARDINAL, 32, PROP_MODE_REPLACE, values, 4)
            x.XFlush(dpy)
        return before
    finally:
        x.XCloseDisplay(dpy)


def give_resolution(appid, size):
    """Give the game's X server (DISPLAY) size, and leave a watcher outside the game's process tree
    (DETACH) to give it its old size back when this process, the launch, ends."""
    display = os.environ.get("DISPLAY", "")
    try:
        state = xwayland(display) if display else None
    except OSError as err:  # no libX11
        log(f"app {appid} runs at the X server's size, not {size[0]}x{size[1]}: {err}")
        return
    if not state:
        log(f"app {appid} runs at the X server's size, not {size[0]}x{size[1]}: {display or 'no DISPLAY'} is not gamescope's")
        return
    was = (state[1], state[2])
    if was == size:
        return
    xwayland(display, size)
    log(f"app {appid} runs at {size[0]}x{size[1]}, its resolution in Steam (the X server had {was[0]}x{was[1]})")
    watcher = shlex.split(DETACH) + [sys.executable, os.path.abspath(__file__), "restore-resolution",
                                     str(os.getpid()), display, "%dx%d" % was, "%dx%d" % size]
    try:
        subprocess.run(watcher, check=True, timeout=15, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as err:
        log(f"{display} keeps {size[0]}x{size[1]} after the game, nothing to give {was[0]}x{was[1]} back: {err}")


def restore_resolution(pid, display, was, now):
    """Once pid ends, give display's X server was again, unless something has changed it from now since."""
    while os.path.exists(os.path.join(PROC, str(pid))):
        time.sleep(1)
    state = xwayland(display)
    if state and (state[1], state[2]) == now:
        xwayland(display, was)
        log(f"{display} has {was[0]}x{was[1]} again")


def run(appid, launch):
    """Become the launch: Steam's command, through /bin/sh as Steam ran it, from its working folder.
    SIGPIPE and SIGXFSZ go back to their defaults: Python ignores them, and an ignored signal stays
    ignored across exec, in the reaper, pressure-vessel, Proton and the game. And the launch starts at
    oom_score_adj 900, the OOM killer's first choice. Steam's wrapper also sets it from the logged
    `--oom-score-adjust 900`, without a client too (Air X, 2026-10-24), but the logged line is Steam's
    to change."""
    log(f"starting app {appid} without the Steam client, as Steam started it at {launch['stamp']}")
    if launch["waiting"]:
        log(f"app {appid} has an update waiting: Steam installs it once it runs (Main menu > Emulators > Steam Client)")
    mine = re.fullmatch(r"(\d+)x(\d+)", game_settings(appid)["resolution"])
    size = (int(mine.group(1)), int(mine.group(2))) if mine else game_resolution(appid)
    if size:
        give_resolution(appid, size)
    env = dict(os.environ)
    env.update(launch["env"], PWD=launch["workdir"])
    for sig in (signal.SIGPIPE, signal.SIGXFSZ):
        signal.signal(sig, signal.SIG_DFL)
    try:
        with open("/proc/self/oom_score_adj", "w") as f:
            f.write(str(OOM_SCORE_ADJ))
    except OSError:
        pass  # never a reason not to start the game
    try:
        os.chdir(launch["workdir"])
        os.execve("/bin/sh", ["/bin/sh", "-c", launch["command"]], env)
    except OSError as err:
        log(f"could not start app {appid}: {err}")
    return 1


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "status" and len(argv) == 1:
        on, where = state()
        log(f"starting Steam games without Steam is {on} ({where})")
        print(on)
        return 0
    if cmd in ("on", "off") and len(argv) == 1:
        try:
            save(cmd)
        except OSError as err:
            log(f"could not save {KEY}={cmd} in {CONF}: {err}")
            return 1
        on, where = state()
        if on != cmd:
            log(f"saved {cmd}, but {where} says {on}")
        print(on)
        return 0
    if cmd == "remember" and len(argv) == 1:
        remember()
        return 0
    if cmd in ("check", "run") and len(argv) == 2:
        if not argv[1].isdigit():
            log(f"not an app id: {argv[1]}")
            return 2
        appid = int(argv[1])
        try:
            # check decides; run, which /usr/bin/steam execs after a check, only plans: nothing it
            # could refuse now would start Steam instead.
            launch = decide(appid) if cmd == "check" else plan(appid)
        except Refused as why:
            log(f"app {appid} starts through Steam: {why}" if cmd == "check" else f"could not start app {appid}: {why}")
            return 1
        if launch is None:
            return 1
        return 0 if cmd == "check" else run(appid, launch)
    if cmd == "fex" and len(argv) == 2 and argv[1].isdigit():
        try:
            fex_driver(int(argv[1]))
            proton_tso(int(argv[1]))
        except OSError as err:
            log(f"app {argv[1]}: could not set its graphics driver: {err}")
            return 1
        return 0
    if cmd == "restore-resolution" and len(argv) == 5 and argv[1].isdigit():
        sizes = [re.fullmatch(r"(\d+)x(\d+)", a) for a in argv[3:]]
        if all(sizes):
            was, now = [(int(m.group(1)), int(m.group(2))) for m in sizes]
            restore_resolution(int(argv[1]), argv[2], was, now)
            return 0
    if cmd == "game" and len(argv) in (2, 5) and argv[1].isdigit() and (len(argv) == 2 or argv[2] == "set"):
        appid = int(argv[1])
        sl = steam_library()
        try:
            app = sl.read_app_nodes(os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf"), {appid}).get(appid, {})
        except Exception as err:  # appinfo.vdf missing or unreadable: no launch options to offer
            log(f"appinfo.vdf: {err}")
            app = {}
        entries = launch_entries(app, beta_key(sl, appid))
        if len(argv) == 5:
            key, value = argv[3], argv[4]
            ok = value in CHOICES.get(key, ()) or (key == "launch" and (value == "default" or value in [e["key"] for e in entries])) \
                or (key == "resolution" and (value == "default" or sane_size(value)))
            if not ok:
                log(f"not a choice: {key} {value}")
                return 2
            try:
                save_game_setting(appid, key, value)
            except OSError as err:
                log(f"could not save {GAMES}: {err}")
                return 1
        steam = game_resolution(appid)
        print(json.dumps({"settings": game_settings(appid), "direct": state()[0],
                          "launch": [{"key": e["key"], "description": e["description"]} for e in entries],
                          "steam_resolution": "%dx%d" % steam if steam else "", "tso_hint": tso_hint(app),
                          "x86": bool(x86_game(appid))}))
        return 0
    log("usage: retroforge-steam-direct status|on|off|remember|check APPID|run APPID|fex APPID|game APPID [set KEY VALUE]")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
