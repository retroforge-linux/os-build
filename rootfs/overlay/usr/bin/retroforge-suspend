#!/bin/sh
# retroforge-suspend — userspace suspend/resume ENGINE (SteamOS layer C). Replaces the immature kernel
# s2idle/s2ram path (out of scope on these SoCs) with a cgroup-freeze "fake suspend": it stops the
# running session so the game actually halts, lowers power, then BLOCKS until the power key wakes it.
#
# Invoked as systemd-suspend.service's ExecStart (via a drop-in), so EVERY logind-mediated Suspend()
# lands here — the shell's power menu, an idle timeout, or the power key (retroforge-powerbuttond
# turns a short press into a logind Suspend()). logind's sleep lifecycle lasts exactly as long as this one blocking call, just as an in-kernel suspend
# would. Resume is OURS: this engine grabs the power key and wakes on it; there is no wake daemon.
#
# Only user.slice is frozen: this engine, journald, logind and the SYSTEM bus all live in system.slice
# and stay responsive, so a system-wide freeze's "thaw before you can reach dbus" hazard does not apply
# to THEM, and no separate never-frozen slice is needed.
#
# The SESSION bus is a different story, and it is a hard constraint rather than a caveat: dbus-broker
# and `systemd --user` sit in session.slice, which is INSIDE user.slice, so they are frozen along with
# everything else. Anything that talks to the session bus — `systemctl --user`, `gamescopectl` — will
# BLOCK until the thaw. So: use the system bus (this is exactly why the powerd fan handoff is a busctl
# call into system.slice), or do the work before the freeze / after the thaw. Do not "fix" a hang here
# by adding a thaw-then-retry; the call simply does not belong inside the frozen window.
#
# Freezing a narrower subtree would keep the session bus live, but it is not obviously expressible on
# our layout and is NOT a drop-in — see the "narrow the fake-suspend freeze set" entry in docs/worklog/DONE.md.
#
# gamescope is inside user.slice and is frozen DELIBERATELY: it holds the blank KMS modeset statically
# while frozen, so we blank BEFORE the freeze and unblank AFTER the thaw.
#
# A board whose profile sets RETROFORGE_SUSPEND_MODE=mem suspends the kernel to RAM inside that same
# blanked, frozen window instead of waiting in userspace (kernel_sleep); everything around it is shared.
set -u

CONF=/etc/retroforge/rest.conf
[ -r "$CONF" ] && . "$CONF"
: "${RETROFORGE_REST_SCREEN:=internal}"
# Freeze the player's LOGIN SCOPE, not all of user.slice. Measured on HW: session-<n>.scope holds
# gamescope, both Xwaylands, the session scripts, mangoapp, the shell AND the game, while the
# user session bus and `systemd --user` sit outside it under user@1000.service — so
# this halts the workload while leaving the session bus answerable. GLOB, not session-1: the scope
# number is per-login. Expanded (split + globbed) in freeze(), so keep it unquoted there.
: "${RETROFORGE_SUSPEND_FREEZE_CGROUPS:=/sys/fs/cgroup/user.slice/user-1000.slice/session-*.scope}"
: "${RETROFORGE_SUSPEND_SKIP:=}"          # power ops to skip: cpu rfkill governor gpugov led (e.g. "rfkill" over SSH)
: "${RETROFORGE_WAKE_KEY:=KEY_POWER}"
: "${RETROFORGE_WAKE_DEBOUNCE_MS:=1000}"  # ignore a KEY_POWER within this of arming the wait (press bounce)
# fake (default) or mem, from the board profile; rest.conf can override it.
: "${RETROFORGE_SUSPEND_MODE:=$("${RETROFORGE_DEVICE_ENV:-/usr/lib/retroforge/device-env}" 2>/dev/null | sed -n 's/^RETROFORGE_SUSPEND_MODE=//p')}"
: "${RETROFORGE_POWER_DIR:=/sys/power}"
# No XDG_RUNTIME_DIR default here: this runs as root, the session as `player`, and gs_resolve_display
# exports the runtime dir it finds the live socket in.

STATE=/run/retroforge/suspended
FIFO=/run/retroforge/wake.fifo
LOG=/var/log/retroforge-suspend.log
# Log to a FILE, not the journal, on the suspend/resume path — habit from when the whole system froze;
# harmless now that journald stays up (system.slice), and it keeps a durable trace on plain disk I/O.
log() { echo "$(date '+%F %T') retroforge-suspend: $*" >> "$LOG" 2>/dev/null; }

# Resolve the LIVE gamescope control socket (not a blind gamescope-0 default) — see the helper header
# for the stale-socket DPMS bug and for (/run/user/<uid>/ it lives in). panel() only runs
# while gamescope is un-frozen (blank before freeze, unblank after thaw). Fallback no-op if the overlay
# lib is absent.
GS_LIB=/usr/lib/retroforge/gamescope-display.sh
if [ -r "$GS_LIB" ]; then . "$GS_LIB"; else gs_resolve_display() { :; }; fi

# Reversible power-lowering primitives (cpu offline / rfkill / cpufreq+devfreq governors), shared
# verbatim with retroforge-rest. Applied AFTER the freeze and restored BEFORE the thaw. State records
# share retroforge-rest's dir (the two states are mutually exclusive). RETROFORGE_SUSPEND_SKIP maps to POWER_SKIP.
POWER_STATE_DIR=/run/retroforge/rest.d
POWER_SKIP=$RETROFORGE_SUSPEND_SKIP
POW_LIB=/usr/lib/retroforge/power-ops.sh
if [ -r "$POW_LIB" ]; then . "$POW_LIB"; else power_enter() { :; }; power_leave() { :; }; fi

# Hand the fan + clocks to retroforge-powerd for the sleep window: its Suspend() parks the fan on the
# suspend curve (closing the "fan keeps spinning during fake-suspend" gap — power-ops.sh never owned
# the fan) and pins CPU/GPU to minimum; Resume() restores the limits that were in force before (whatever
# PowerStation or the kernel defaults had set). powerd is in
# system.slice, never frozen, so this D-Bus call lands even while user.slice is frozen. Best-effort:
# a down/absent powerd must NOT block the freeze/thaw. Skip via RETROFORGE_SUSPEND_SKIP="powerd".
powerd_call() {  # $1 = Suspend | Resume
  case " $POWER_SKIP " in *" powerd "*) return 0 ;; esac
  command -v busctl >/dev/null 2>&1 || { log "busctl missing; powerd $1 skipped"; return 0; }
  busctl call org.retroforge.Power /org/retroforge/Power org.retroforge.Power1 "$1" >/dev/null 2>&1 \
    || log "powerd $1 call failed (daemon down?)"
}

now_ms() { date +%s%3N; }   # GNU date; millisecond epoch for the wake debounce

# Echo the first /dev/input/event* whose kernel name looks like a power key (pmic_pwrkey on SM8650,
# "Power Button" on gpio-keys boards); non-zero if none — caller then grabs all devices.
find_power_dev() {
  for d in /dev/input/event*; do
    [ -e "$d" ] || continue
    n=$(cat "/sys/class/input/${d##*/}/device/name" 2>/dev/null) || continue
    case "$n" in *pwrkey*|*[Pp]ower*[Bb]utton*) echo "$d"; return 0 ;; esac
  done
  return 1
}

# $1 = 1 (blank) | 0 (unblank) — via gamescope's own KMS modeset. RETURNS NON-ZERO when gamescope
# could not be reached, which is the signal for the bl_power fallback below. It used to return 0 for
# a missing gamescopectl, i.e. "nothing to do" — but there IS something to do, and reporting success
# is what let a suspend proceed with the panel lit.
panel() {
  command -v gamescopectl >/dev/null 2>&1 || { log "no gamescopectl on PATH"; return 1; }
  gs_resolve_display || log "no live gamescope socket; trying ${GAMESCOPE_WAYLAND_DISPLAY:-gamescope-0}"
  gamescopectl "drm_sleep_${RETROFORGE_REST_SCREEN}_screen" "$1" 2>/dev/null && return 0
  log "gamescopectl unreachable; panel unchanged"
  return 1
}

# THE FALLBACK, and the reason this file needs one. HW 2026-07-26: a cycle entered via
# `systemctl suspend` — i.e. any path that was not the Steam client's own sleep flow — left the panel LIT for the
# whole ~70s frozen window. retroforge-suspend runs as systemd-suspend.service (root, system.slice) and
# cannot resolve the live gamescope socket from there, so the KMS blank above never happens: the
# recorder read `panel=enabled` on all 43 frozen samples. The Steam client's own blank was the only thing
# turning the screen off. There is no Steam client any more, so EVERY entry point (the shell's power
# menu, idle timeout, the power key) now depends on this fallback.
#
# bl_power is the one lever reachable from system.slice with no session, no bus and no compositor:
# 4 is FB_BLANK_POWERDOWN, 0 is FB_BLANK_UNBLANK. It does NOT disable the connector, so the DRM
# `enabled` attribute wait_panel polls stays "enabled" — do not wait on it after using this, the
# screen is dark but the connector is not. Glob is a seam so a test can point it at a fake tree.
: "${RETROFORGE_BL_GLOB:=/sys/class/backlight/*}"
bl_power() {  # $1 = 4 (powerdown) | 0 (unblank)
  _bl_n=0
  for _bl in $RETROFORGE_BL_GLOB; do
    [ -w "$_bl/bl_power" ] || continue
    echo "$1" > "$_bl/bl_power" 2>/dev/null && _bl_n=$((_bl_n + 1))
  done
  [ "$_bl_n" -gt 0 ] || return 1
  log "backlight: bl_power=$1 on $_bl_n device(s)"
}

freeze() {  # $1 = 1 (freeze) | 0 (thaw) — direct sysfs write, no dbus/systemctl dependency
  for cg in $RETROFORGE_SUSPEND_FREEZE_CGROUPS; do
    [ -w "$cg/cgroup.freeze" ] && echo "$1" > "$cg/cgroup.freeze" 2>/dev/null
  done
}

# Wait for the internal panel connector to reach the requested KMS state before proceeding. gamescope
# applies the drm_sleep convar on its own main loop (~300ms after gamescopectl returns), so we must NOT
# freeze it until the blank has truly landed (freezing mid-apply traps it lit). Poll the connector's
# sysfs `enabled` attr (plain attribute read — not debugfs, no display hitch).
: "${RETROFORGE_PANEL_WAIT_DS:=30}"   # max wait, deciseconds (3s); generous over the ~300ms apply
PANEL_GLOB="/sys/class/drm/card*-DSI-*"
wait_panel() {  # $1 = enabled|disabled
  _i=0
  while [ "$_i" -lt "$RETROFORGE_PANEL_WAIT_DS" ]; do
    _all=1; _seen=0
    for _c in $PANEL_GLOB; do
      [ -r "$_c/enabled" ] || continue
      [ "$(cat "$_c/status" 2>/dev/null)" = connected ] || continue
      _seen=1
      [ "$(cat "$_c/enabled" 2>/dev/null)" = "$1" ] || _all=0
    done
    [ "$_seen" = 1 ] && [ "$_all" = 1 ] && return 0
    sleep 0.1; _i=$((_i + 1))
  done
  return 1
}

# Park the sound cards for a kernel suspend: an open playback stream keeps the ADSP awake, and an
# awake ADSP holds the SoC out of its low power states. The shell holds one open the whole time it
# runs, so waiting for idle never closes the device. Switching each card's profile to "off" closes
# it at once and moves the streams to the fallback sink, where they stay alive; putting the profile
# back moves them home. The sound server is the session user's and is not frozen.
# HW 2026-11-12, Retroid Pocket Nova: off -> PCM closed, ADSP asleep 100 % of 6 s (0 % before);
# restored -> the shell's stream back on the speaker sink at its old volume.
AUDIO_STATE=/run/retroforge/audio-profiles
pa() {  # pactl as the session user; non-zero when there is no sound server
  for d in /run/user/*; do
    [ -S "$d/pulse/native" ] || continue
    u=$(stat -c %U "$d") || continue
    XDG_RUNTIME_DIR="$d" LC_ALL=C timeout 3 runuser -u "$u" -- pactl "$@"
    return
  done
  return 1
}
audio_park() {
  mkdir -p "$(dirname "$AUDIO_STATE")"
  : > "$AUDIO_STATE"
  pa list cards 2>/dev/null \
    | sed -n -e 's/^\tName: //p' -e 's/^\tActive Profile: //p' \
    | while read -r card && read -r prof; do
        [ "$prof" = off ] && continue
        printf '%s\t%s\n' "$card" "$prof" >> "$AUDIO_STATE"
        pa set-card-profile "$card" off || log "audio: could not park $card"
      done
}
audio_unpark() {
  [ -s "$AUDIO_STATE" ] || { rm -f "$AUDIO_STATE"; return 0; }
  while IFS="$(printf '\t')" read -r card prof; do
    pa set-card-profile "$card" "$prof" || log "audio: could not restore $card to $prof"
  done < "$AUDIO_STATE"
  rm -f "$AUDIO_STATE"
}

do_suspend() {
  [ -e "$STATE" ] && { log "already suspended"; return 0; }
  mkdir -p "$(dirname "$STATE")"
  log "suspending: blank panel"
  # SHORT-CIRCUIT ON PURPOSE: when panel 1 reports gamescope unreachable there is nothing that will
  # ever flip the connector, so waiting the full RETROFORGE_PANEL_WAIT_DS for it is 3s of the suspend
  # path spent proving a foregone conclusion. Go straight to the backlight instead.
  if panel 1 && wait_panel disabled; then
    log "panel blank confirmed"
  else
    log "no KMS blank; falling back to the backlight"
    bl_power 4 || log "no writable bl_power either — SLEEPING WITH THE PANEL LIT"
  fi
  if [ "$RETROFORGE_SUSPEND_MODE" = mem ]; then
    log "parking audio"
    audio_park
  fi
  log "freezing: $RETROFORGE_SUSPEND_FREEZE_CGROUPS"
  freeze 1
  # Lower power AFTER the freeze (no frozen workload left to schedule): offline non-boot CPUs, block
  # radios, drop cpufreq + GPU devfreq governors to powersave. Records prior state for do_resume;
  # honours RETROFORGE_SUSPEND_SKIP.
  log "lowering power (skip='${RETROFORGE_SUSPEND_SKIP}')"
  power_enter
  # Park the fan (and pin clocks) via powerd's suspend mode, after our own power_enter.
  powerd_call Suspend
  : > "$STATE"
  log "suspended"
}

# Block until the power key wakes us. The key is grabbed EXCLUSIVELY (EVIOCGRAB via libinput --grab)
# so the wake press does NOT also reach the (un-frozen) retroforge-powerbuttond forwarder and bounce us
# straight back into suspend on thaw. A short debounce ignores the tail of the press that got us here.
li=""
wake_cleanup() { [ -n "$li" ] && kill "$li" 2>/dev/null; li=""; rm -f "$FIFO"; }
wait_for_wake() {
  command -v libinput >/dev/null 2>&1 || { log "libinput missing; cannot arm wake — resuming"; return 0; }
  rm -f "$FIFO"; mkfifo "$FIFO" 2>/dev/null || true
  pdev=$(find_power_dev || true)
  if [ -n "$pdev" ]; then
    log "waiting for wake ($RETROFORGE_WAKE_KEY on $pdev, grabbed)"
    libinput debug-events --grab --device "$pdev" > "$FIFO" 2>/dev/null &
  else
    log "waiting for wake ($RETROFORGE_WAKE_KEY, all devices grabbed)"
    libinput debug-events --grab > "$FIFO" 2>/dev/null &
  fi
  li=$!
  t0=$(now_ms)
  while IFS= read -r line; do
    case "$line" in
      *"$RETROFORGE_WAKE_KEY"*pressed*)
        [ $(( $(now_ms) - t0 )) -lt "$RETROFORGE_WAKE_DEBOUNCE_MS" ] && continue
        log "wake ($RETROFORGE_WAKE_KEY)"; break ;;
    esac
  done < "$FIFO"
  wake_cleanup   # release the grab so the key works again once awake
}

# RETROFORGE_SUSPEND_MODE=mem: suspend the kernel to RAM, "deep" where the platform offers it, else
# s2idle. The write blocks until a wakeup source (the power key) resumes the kernel. The key stays
# grabbed across the sleep and for the debounce after it, so the wake press never reaches
# retroforge-powerbuttond (which acts on a release it saw pressed) and suspends us again. Non-zero
# when the kernel refuses; the caller then waits for the key as in fake suspend.
kernel_sleep() {
  [ -w "$RETROFORGE_POWER_DIR/state" ] || { log "no writable $RETROFORGE_POWER_DIR/state"; return 1; }
  grep -qw deep "$RETROFORGE_POWER_DIR/mem_sleep" 2>/dev/null \
    && echo deep > "$RETROFORGE_POWER_DIR/mem_sleep" 2>/dev/null
  grab=""
  if command -v libinput >/dev/null 2>&1; then
    pdev=$(find_power_dev || true)
    if [ -n "$pdev" ]; then
      libinput debug-events --grab --device "$pdev" >/dev/null 2>&1 &
    else
      libinput debug-events --grab >/dev/null 2>&1 &
    fi
    grab=$!
  fi
  log "kernel suspend ($(cat "$RETROFORGE_POWER_DIR/mem_sleep" 2>/dev/null))"
  if echo mem > "$RETROFORGE_POWER_DIR/state" 2>/dev/null; then
    log "kernel resumed"; _rc=0
  else
    log "kernel suspend refused"; _rc=1
  fi
  sleep "$(( (RETROFORGE_WAKE_DEBOUNCE_MS + 999) / 1000 ))"
  [ -n "$grab" ] && kill "$grab" 2>/dev/null
  return "$_rc"
}

do_resume() {
  [ -e "$STATE" ] || { log "not suspended"; return 0; }
  rm -f "$STATE"
  # Resume powerd first so the fan spins back up on its active-profile curve as we restore.
  powerd_call Resume
  # Restore power BEFORE the thaw so the workload wakes onto its full CPU/governor budget (reverse of
  # power_enter; restores exactly what was changed).
  log "restoring power"
  power_leave
  log "resuming: thaw"
  freeze 0
  audio_unpark
  log "unblank panel"
  # bl_power 0 FIRST and UNCONDITIONALLY, whichever way the blank happened. It is a no-op when the
  # backlight is already on, and if the blank came from the fallback then nothing else will undo it —
  # gamescope never knew the screen was off. Getting this wrong strands a woken device dark.
  bl_power 0
  if panel 0 && wait_panel enabled; then
    log "panel restore confirmed"
  else
    log "panel restore NOT confirmed in ${RETROFORGE_PANEL_WAIT_DS}ds"
  fi
  # post-resume hooks (run un-frozen, after thaw): generic extension point. None ship by default (NM
  # re-associates unaided after the rfkill-unblock). Missing dir = no hooks, no-op.
  for h in /etc/retroforge/resume.d/*; do
    [ -x "$h" ] || continue
    log "resume hook: $h"
    "$h" >> "$LOG" 2>&1 || log "resume hook failed: $h"
  done
  log "resumed"
}

case "${1:-sleep}" in
  sleep|suspend)
    [ -e "$STATE" ] && exit 0
    # If the unit is stopped/killed mid-sleep (e.g. `systemctl stop systemd-suspend.service` as a
    # force-wake), always release the grab and resume so nothing is stranded frozen.
    trap 'wake_cleanup; do_resume; exit 0' INT TERM
    do_suspend
    if [ "$RETROFORGE_SUSPEND_MODE" = mem ]; then
      kernel_sleep || wait_for_wake
    else
      wait_for_wake
    fi
    do_resume
    trap - INT TERM
    ;;
  resume)
    # Manual/override resume: stop the blocked engine (its trap releases the grab + resumes), then
    # resume here too (idempotent) in case the engine already exited.
    systemctl stop systemd-suspend.service 2>/dev/null || true
    do_resume ;;
  status)  if [ -e "$STATE" ]; then echo suspended; else echo awake; fi ;;
  *) echo "usage: retroforge-suspend {sleep|resume|status}" >&2; exit 2 ;;
esac
