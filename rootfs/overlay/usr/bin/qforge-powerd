#!/usr/bin/env python3
import configparser
import os
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time
import warnings
from pathlib import Path

warnings.filterwarnings("ignore", category=DeprecationWarning)

BUS_NAME = "org.qforge.Power"
OBJECT_PATH = "/org/qforge/Power"
IFACE = "org.qforge.Power1"
# qforge-powerd owns what nothing else on the image does: the fan, the BOOT CPU frequency governor
# (the kernel default is `performance`, see kernel/kernel.config, so something has to replace it
# before the shell starts), the sched_ext scheduler choice, and the suspend-time clock clamp.
#
# It does NOT own CPU or GPU frequency LIMITS, core online state, boost or the governors after boot:
# PowerStation (packages/powerstation, org.shadowblip.PowerStation) does, because that is the
# service OpenGamepadUI's performance menu drives. Its power profiles are governor pairs (CPU
# schedutil/ondemand/performance, GPU simple_ondemand/performance), so powerd writes the governor
# ONCE per boot and never again: a restart or a config reload re-applying it would silently undo
# the profile the player picked.
STATE_FILE = Path("/var/lib/qforge/powerd.state")
# On tmpfs, so it lasts exactly one boot: present once the boot governor is in, which is what keeps
# a restarted powerd (Restart=always) off the governors PowerStation has set since.
BOOT_GOVERNOR_MARKER = Path(os.environ.get(
    "QFORGE_POWERD_RUN", "/run/qforge-powerd")) / "boot-governor-applied"
# Overridable so tests/test-fan-curve.sh can drive the real parse/write paths against a
# fabricated tree.
FACTORY_CONFIG_FILE = Path(os.environ.get(
    "QFORGE_POWERD_FACTORY", "/usr/share/qforge/power.conf"))
CONFIG_DIR = Path(os.environ.get("QFORGE_POWERD_ETC", "/etc/qforge"))
CONFIG_FILE = CONFIG_DIR / "power.conf"
# Three layers, lowest first: /usr factory -> the operator's own /etc file -> drop-ins. The
# split exists because the /etc file is OPERATOR territory (hand-written, commented, and it
# may override the governor, a factory curve or the whole [fan] block), while FAN_CURVE_DROPIN is ours to
# rewrite from scratch on every FanCurve set. configparser cannot round-trip comments, so
# writing the user's curve into the /etc file would silently eat an operator's notes on every
# slider drag. An operator who wants the last word still has it: drop-ins are read in sorted
# order, so a 90-*.conf of their own outranks ours.
CONFIG_DROPIN_DIR = Path(f"{CONFIG_FILE}.d")
FAN_CURVE_DROPIN = CONFIG_DROPIN_DIR / "50-fan-curves.conf"
# The LED setting set over D-Bus (LedEnabled/LedColor/LedBrightness), rewritten whole like the curve.
LED_DROPIN = CONFIG_DROPIN_DIR / "50-leds.conf"
# The board's hardware map (/usr/lib/qforge/hw-map, docs/hardware-map.md): which hwmon is the fan
# and which LEDs make up which group. powerd drives what it names and only scans sysfs itself
# when the map is absent (an image without it, or hw-map not run yet).
HW_RUN = Path(os.environ.get("QFORGE_HW_RUN", "/run/qforge/hw"))
# The curve powerd itself writes, as opposed to a factory one. The name is what makes
# FanCurveIsCustom answerable, and what ResetFanCurve deletes.
CUSTOM_CURVE = "custom"
# Measured the better choice for frame-time consistency on these SoCs (see kernel/kernel.config);
# overridable with [cpu] governor= in the config.
DEFAULT_CPU_GOVERNOR = "ondemand"
# Energy-aware scheduling. The kernel turns EAS on by itself whenever schedutil drives an
# asymmetric (big.LITTLE) CPU with an energy model, and EAS packs a game's threads onto the little
# cores: on the MANGMI Air X (SM6115, A53 + A73) a 60 fps frame loop with ~6 ms of work per frame
# missed 95% of its deadlines on schedutil+EAS (work ran at 36 ms, on the A53s), against 1% on
# ondemand and 1-2% on schedutil with EAS off (HW-measured 2026-10-10). So powerd writes
# kernel.sched_energy_aware=0 after every governor change unless [cpu] energy_aware=on.
EAS_SYSCTL = Path(os.environ.get("QFORGE_POWERD_EAS_SYSCTL", "/proc/sys/kernel/sched_energy_aware"))
# The board profile can narrow the scheduler choice (QFORGE_CPU_SCHEDULERS, space-separated, from
# device-env). The Air X profile allows only "none": scx_lavd placed one of two game threads on
# the A53s and it missed 76-86% of its frames whatever the governor.
DEVICE_ENV = Path(os.environ.get("QFORGE_POWERD_DEVICE_ENV", "/usr/lib/qforge/device-env"))
FAN_SAFE_PWM = 128
# Fallback only: the factory config carries curve_stops. It matters when an /etc file from an
# older image is layered over a newer /usr, which is exactly the case an OTA produces.
DEFAULT_CURVE_STOPS = (60, 70, 80, 90, 100)

# sched_ext. "none" is the in-kernel scheduler (EEVDF; one implementation, not
# runtime-selectable, so it is the whole non-scx half of this vocabulary) with scx.service
# stopped, "lavd" is scx_lavd with it running. Which binary the unit runs comes from
# /etc/default/scx (we ship SCX_SCHEDULER=scx_lavd); editing that file out from under us makes
# the "lavd" label inaccurate, nothing worse.
#
# Deliberately just these two, matching Valve's vocabulary exactly. scx-scheds also ships
# scx_bpfland and scx_rusty, but those stay SSH-only per-title fallbacks rather than QAM
# entries. Not to be confused with the cpufreq governor (schedutil / performance): that is
# frequency policy, a separate axis ([cpu] governor below).
#
# THE DEFAULT IS "none", i.e. the stock in-kernel scheduler — same as SteamOS, for a different
# reason. SteamOS defaults to stock because scx there may not be installed at all (its manager
# bails with "scx.service not installed" and holo ships no scx packages); we build both halves
# ourselves (CONFIG_SCHED_CLASS_EXT in kernel/kernel.config, packages/scx-scheds into the
# [qforge] overlay, scx-scheds in customize-base.sh PKGS), so the capability is always there
# and lavd is one `qforge-scheduler lavd` away. The old reason for defaulting to stock — a report
# that lavd hurt in-game performance — is GONE: it was measured on SM8650 (2026-08-09) and refuted,
# lavd came out ~62% faster on a GPU-headroom title because stock leaves the prime core near-idle.
# See packages/scx-scheds/source.pin for the numbers. We still default to stock because swapping the
# in-kernel scheduler is a thing to opt into rather than have imposed; it is selectable
# system-wide through this property. lavd was briefly the default
# (2026-07-30 to
# 2026-08-03); flipping it back does NOT touch a device that already persisted `cpu_scheduler=lavd`
# in powerd.state — an explicit saved choice outranks this default in both directions, so such a
# device needs one `qforge-scheduler none`.
#
# THE DEFAULT IS NOT IMPLEMENTED BY ENABLING scx.service, and must not be. The unit ships
# installed but never `enable`d; restore_cpu_scheduler() below is the only thing that starts it
# at boot, so a fresh device boots on the stock scheduler and only a persisted choice starts lavd.
# (scx_lavd used to run with --autopower, following the power profile through the
# power-profiles-daemon names powerd answered; with the profiles gone it runs in its default mode.)
CPU_SCHEDULERS = ["none", "lavd"]
DEFAULT_CPU_SCHEDULER = "none"
SCX_UNIT = "scx.service"
SCX_BINARY = Path("/usr/bin/scx_lavd")
SCX_SYSFS = Path("/sys/kernel/sched_ext")
SCX_TIMEOUT = 15

XML = f"""
<node>
  <interface name="{IFACE}">
    <method name="Reload"/>
    <method name="Suspend"/>
    <method name="Resume"/>
    <method name="GetStatus">
      <arg type="a{{sv}}" name="status" direction="out"/>
    </method>
    <property name="AvailableCpuSchedulers" type="as" access="read"/>
    <property name="CpuScheduler" type="s" access="readwrite"/>
    <!-- The scheduler actually loaded. Equals CpuScheduler except when the kernel has ejected
         lavd underneath us (see reconcile_scheduler_live) or a switch is still in flight. -->
    <property name="ActiveCpuScheduler" type="s" access="read"/>
    <property name="FanMode" type="s" access="read"/>
    <property name="FanPwm" type="u" access="read"/>
    <property name="FanRpm" type="u" access="read"/>
    <property name="Temperature" type="u" access="read"/>
    <!-- The editable fan curve, as PWM values sampled at FIXED temperature stops.
         Editing only the PWMs is what makes an invalid curve unreachable rather than
         rejected: the stops are already sorted, so "temperatures must rise" cannot be
         violated and there is no ordering to validate. There is one curve for the
         device; it is not per title.

         The STORAGE grammar is unchanged (`temp:pwm,...`, arbitrary point count), so an
         operator can still hand-author a curve of any shape over SSH and powerd will
         apply it verbatim. FanCurve then reports that curve RESAMPLED onto the stops --
         which is what the fan is actually doing at those temperatures, not an
         approximation of it. Writing the property does flatten such a curve to the stops. -->
    <property name="FanCurveStops" type="au" access="read"/>
    <property name="FanCurve" type="au" access="readwrite"/>
    <property name="FanCurveMinPwm" type="u" access="read"/>
    <property name="FanCurveMaxPwm" type="u" access="read"/>
    <property name="FanCurveIsCustom" type="b" access="read"/>
    <!-- The board's LEDs (the hardware map's LED groups; without one, the RGB LEDs). LedCount 0
         means there is nothing to light. LedColor is R, G, B (0-255); single-colour LEDs follow
         LedBrightness and are off only for black. Kept in power.conf.d/50-leds.conf. -->
    <property name="LedCount" type="u" access="read"/>
    <property name="LedEnabled" type="b" access="readwrite"/>
    <property name="LedColor" type="au" access="readwrite"/>
    <property name="LedBrightness" type="u" access="readwrite"/>
    <!-- Deletes what powerd wrote and returns to the factory curve. Does not touch an
         operator's own override in the /etc file. -->
    <method name="ResetFanCurve"/>
  </interface>
</node>
"""


def read_text(path, default=""):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def write_text(path, value):
    try:
        Path(path).write_text(f"{value}\n")
        return True
    except OSError as exc:
        print(f"qforge-powerd: write failed {path}: {exc}", file=sys.stderr)
        return False


def try_write(path, value):
    """A sysfs write whose failure is an ANSWER, not an incident — so it must not log.

    write_text() narrates every OSError, which is right for a write we expect to land and
    wrong for a probe: asking the kernel for a governor it does not have is how we find out
    that it does not have it, and doing so once per policy would fill the journal with
    errors describing normal operation."""
    try:
        Path(path).write_text(f"{value}\n")
        return True
    except OSError:
        return False


def restore_factory_config(reason):
    """Quarantine EVERY user layer so factory-only sections keep tracking /usr.

    All of them, not just the /etc file: the config is three layers now, and dropping only
    one of them leaves whichever other layer was the actual culprit still in place. The
    caller re-parses factory-only immediately afterwards, so the next boot would hit the
    same bad file and quarantine nothing -- a loop that presents as "my curve reverts every
    reboot" with no error anyone can see.
    """
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    # The suffix goes AFTER .conf on purpose: `50-fan-curves.conf.invalid-<ts>` no longer
    # matches the *.conf glob, so a quarantined drop-in stays quarantined.
    victims = [path for path in [CONFIG_FILE, *sorted(CONFIG_DROPIN_DIR.glob("*.conf"))]
               if path.exists()]
    if not victims:
        raise reason
    dropped = []
    for path in victims:
        backup = path.with_name(f"{path.name}.invalid-{timestamp}")
        try:
            shutil.copy2(path, backup)
            path.unlink()
        except OSError:
            continue
        dropped.append(f"{path} (backup at {backup})")
    if not dropped:
        raise reason
    print(f"qforge-powerd: dropped invalid config {', '.join(dropped)}; "
          f"using factory defaults: {reason}", file=sys.stderr)


def sd_notify(message):
    notify_socket = os.environ.get("NOTIFY_SOCKET")
    if not notify_socket:
        return
    if notify_socket.startswith("@"):
        notify_socket = "\0" + notify_socket[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.connect(notify_socket)
            sock.sendall(message.encode())
    except OSError:
        pass


def board_cpu_schedulers():
    """The board profile's QFORGE_CPU_SCHEDULERS (device-env), as a set; None when the profile
    sets none (every scheduler allowed) or device-env cannot be run."""
    try:
        out = subprocess.run([str(DEVICE_ENV)], check=False, text=True, timeout=10,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        if line.startswith("QFORGE_CPU_SCHEDULERS="):
            words = shlex.split(line.split("=", 1)[1])
            value = " ".join(words).split()
            return set(value) if value else None
    return None


def ints_from_file(path):
    return sorted(int(v) for v in read_text(path).split() if v.isdigit())


def clamp(value, low, high):
    return max(low, min(high, value))


def parse_fan_curve(value):
    curve = []
    for item in value.split(","):
        if ":" not in item:
            continue
        temp, pwm = item.split(":", 1)
        try:
            curve.append((int(temp.strip()), int(pwm.strip())))
        except ValueError:
            continue
    return sorted(curve, reverse=True)


def format_fan_curve(curve):
    """Inverse of parse_fan_curve, in the descending order the factory config is written in."""
    return ",".join(f"{temp}:{pwm}" for temp, pwm in sorted(curve, reverse=True))


def curve_pwm(curve, temp):
    """The curve's PWM at a temperature: linear between points, flat outside the ends.

    Pulled out of target_pwm so the UI can ask the same question the fan tick asks. It is
    deliberately NOT quantized -- quantization is an artifact of what the hardware accepts,
    and rounding it into a slider's value would make the slider jump under the user's thumb
    and then disagree with what they set.
    """
    curve = sorted(curve)
    if not curve:
        return 0
    if temp <= curve[0][0]:
        return curve[0][1]
    if temp >= curve[-1][0]:
        return curve[-1][1]
    for (low_temp, low_pwm), (high_temp, high_pwm) in zip(curve, curve[1:]):
        if low_temp <= temp <= high_temp:
            span = high_temp - low_temp
            if not span:
                return high_pwm
            return int(round(low_pwm + (high_pwm - low_pwm) * (temp - low_temp) / span))
    return curve[0][1]


def binary_fan_on(curve, temp, was_on, on_pwm, hysteresis):
    """On/off for a fan with two speeds (gpio-fan: off or full).

    A PWM there is not a speed: the driver rounds every value above 0 up to "on", so following
    the curve would hold the fan at full speed from the curve's floor up. Instead the fan switches
    on where the curve reaches on_pwm (its first step: 72 C on the moderate curve) and off again
    once the curve at temp + hysteresis is back below it, so it does not flap around the knee."""
    if not curve:
        return was_on

    def exact(t):  # curve_pwm without its rounding: 71 C must not count as the 72 C knee
        points = sorted(curve)
        if t <= points[0][0]:
            return float(points[0][1])
        for (t0, p0), (t1, p1) in zip(points, points[1:]):
            if t <= t1:
                return p0 + (p1 - p0) * (t - t0) / (t1 - t0) if t1 > t0 else float(p1)
        return float(points[-1][1])

    if was_on:
        return exact(temp + hysteresis) >= on_pwm
    return exact(temp) >= on_pwm


def is_two_speed_fan(hwmon, thermal_root=Path("/sys/class/thermal")):
    """A gpio-fan whose cooling device has one step above off (speed-map with two entries)."""
    if not hwmon or read_text(hwmon / "name") != "gpio_fan":
        return False
    for cdev in thermal_root.glob("cooling_device*"):
        if read_text(cdev / "type") == "gpio-fan":
            return read_text(cdev / "max_state") == "1"
    return False


def parse_led_config(parser):
    """[led]: the colour and brightness powerd gives the board's RGB LEDs (on|off, R,G,B, 0-255)."""
    enabled = parser.get("led", "enabled", fallback="on").strip().lower()
    if enabled not in ("on", "off"):
        raise ValueError(f"[led] enabled must be on or off, not {enabled!r}")
    parts = [p.strip() for p in parser.get("led", "color", fallback="0,96,255").split(",")]
    if len(parts) != 3:
        raise ValueError("[led] color must be R,G,B")
    color = tuple(clamp(int(p), 0, 255) for p in parts)
    brightness = clamp(parser.getint("led", "brightness", fallback=64), 0, 255)
    return {"enabled": enabled == "on", "color": color, "brightness": brightness}


def discover_leds(root=Path("/sys/class/leds"), hw=None):
    """The LEDs powerd lights. With a hardware map, every LED of every group it names
    (hw/leds/<group>/NN -> /sys/class/leds/<led>), single-colour ones included. Without one, the
    multicolor (RGB) LEDs: the Air X/Y stick rings are rgb:l<n> / rgb:r<n> multi-LEDs over
    aw20036 channels; plain single-channel LEDs (mmc activity, the rings' raw channels) are left
    alone there because nothing says they are for show."""
    hw = HW_RUN if hw is None else hw
    if (hw / "leds").is_dir():
        found = []
        for group in sorted((hw / "leds").iterdir()):
            for link in sorted(group.iterdir()):
                led = link.resolve()
                if (led / "brightness").exists() and led not in found:
                    found.append(led)
        if found:
            return found
    return sorted(p for p in root.glob("*") if (p / "multi_intensity").exists() and (p / "multi_index").exists())


def discover_fan(hw=None, hwmon_root=Path("/sys/class/hwmon")):
    """The fan's hwmon directory, if it can be driven (pwm1). The hardware map's `fan` link
    first; otherwise a hwmon named pwmfan, then the first hwmon with a pwm1."""
    hw = HW_RUN if hw is None else hw
    if (hw / "fan").exists():
        fan = (hw / "fan").resolve()
        if (fan / "pwm1").exists():
            return fan
    for path in sorted(hwmon_root.glob("hwmon*")):
        if read_text(path / "name") == "pwmfan" and (path / "pwm1").exists():
            return path
    for path in sorted(hwmon_root.glob("hwmon*")):
        if (path / "pwm1").exists():
            return path
    return None


def led_intensity(multi_index, color):
    """multi_intensity in the order multi_index lists the channels; unknown channels get 0."""
    by_name = {"red": color[0], "green": color[1], "blue": color[2]}
    return " ".join(str(by_name.get(name, 0)) for name in multi_index.split())


def apply_leds(leds, color, brightness):
    """Colour for multicolor LEDs, brightness for all. A single-colour LED has no colour of its
    own: it is lit at the brightness unless the colour is black."""
    for led in leds:
        top = int(read_text(led / "max_brightness", "255") or 255)
        if (led / "multi_intensity").exists():
            write_text(led / "multi_intensity", led_intensity(read_text(led / "multi_index"), color))
            level = brightness
        else:
            level = brightness if any(color) else 0
        # brightness is 0-255 on the D-Bus side; scale onto LEDs with a smaller range
        write_text(led / "brightness", clamp(round(level * top / 255), 0, top))


def render_led_dropin(config):
    """The whole LED drop-in, for the setting made over D-Bus."""
    r, g, b = config["color"]
    return "\n".join([
        "# Written by qforge-powerd (org.qforge.Power1 LedEnabled/LedColor/LedBrightness).",
        "# Deleting this file returns the LEDs to the factory [led] setting.",
        "",
        "[led]",
        f"enabled={'on' if config['enabled'] else 'off'}",
        f"color={r},{g},{b}",
        f"brightness={config['brightness']}",
        "",
    ])


def resample_curve(curve, stops):
    return [curve_pwm(curve, stop) for stop in stops]


def parse_curve_stops(value):
    stops = []
    for item in str(value).split(","):
        item = item.strip()
        if not item.isdigit():
            raise ValueError(f"invalid fan curve stop: {item!r}")
        stops.append(int(item))
    if len(stops) < 2:
        raise ValueError("need at least two fan curve stops")
    if any(high <= low for low, high in zip(stops, stops[1:])):
        raise ValueError("fan curve stops must rise")
    if stops[0] < 0 or stops[-1] > 120:
        raise ValueError("fan curve stops must lie in 0..120")
    return stops


def clean_curve_pwms(pwms, stops, low, high):
    """A slider payload the fan tick can run: right length, in range, never falling.

    The running max is what enforces monotonicity, and it is applied rather than rejected on
    purpose -- with fixed stops the only way to get a descending pair is a client that
    ignores the contract, and clamping it gives that client a working fan instead of an error.
    """
    if len(pwms) != len(stops):
        raise ValueError(f"fan curve needs exactly {len(stops)} values")
    clean, floor = [], low
    for pwm in pwms:
        value = clamp(int(pwm), floor, high)
        clean.append(value)
        floor = value
    return clean


def render_fan_dropin(pwms, stops):
    """The whole drop-in, rebuilt from scratch, for one custom curve sampled at `stops`."""
    curve = format_fan_curve(list(zip(stops, pwms)))
    return "\n".join([
        "# Written by qforge-powerd (org.qforge.Power1 FanCurve). Rebuilt in full on",
        "# every change, so comments added here do not survive -- put operator overrides in",
        f"# {CONFIG_FILE} (read first) or a higher-numbered drop-in (read after) instead.",
        "#",
        "# `ResetFanCurve` deletes this file and the factory curve applies again.",
        "",
        f"[fan_curve.{CUSTOM_CURVE}]",
        "label=Custom",
        f"curve={curve}",
        "",
        "[fan]",
        f"curve={CUSTOM_CURVE}",
    ]) + "\n"


def require_section(parser, section):
    if not parser.has_section(section):
        raise ValueError(f"missing config section [{section}]")


def fan_safe_once():
    fan_hwmon = discover_fan()
    if not fan_hwmon:
        return
    enable = fan_hwmon / "pwm1_enable"
    if enable.exists():
        write_text(enable, "1")
    write_text(fan_hwmon / "pwm1", FAN_SAFE_PWM)


class QforgePower:
    def __init__(self):
        self.fan_curves = {}
        self.fan_curve_name = ""
        self.fan_curve_points = []
        self.fan_config = {}
        self.suspend_config = {}
        self.cpu_governor = DEFAULT_CPU_GOVERNOR
        self.cpu_energy_aware = False
        self.board_schedulers = board_cpu_schedulers()
        # cpu_scheduler is the PERSISTED CHOICE; scheduler_live is what is actually loaded right
        # now. They differ only when the kernel ejects lavd underneath us or a start is still in
        # flight -- see reconcile_scheduler_live().
        self.cpu_scheduler = DEFAULT_CPU_SCHEDULER
        self.scheduler_live = DEFAULT_CPU_SCHEDULER
        self.smoothed_temp = 0.0
        self.last_pwm = 0
        self.suspended = False
        self.suspend_fan_active = False
        self.suspend_save = {}
        self.connection = None
        self.led_config = {"enabled": False, "color": (0, 0, 0), "brightness": 0}
        self.leds = []
        self.load_config()
        self.discover()
        self.load_state()
        self.set_leds(True)
        if self.fan_pwm:
            current = read_text(self.fan_pwm)
            self.last_pwm = int(current) if current.isdigit() else self.fan_config["min_pwm"]
        self.apply_boot_cpu_governor()
        self.fan_tick()
        GLib.timeout_add_seconds(3, self.fan_tick)
        # There is no per-game (per-ROM) layer: emulators carry their own per-game settings.
        # What is left on this cadence is noticing a scheduler the kernel ejected.
        GLib.timeout_add_seconds(3, self.scheduler_tick)

    def discover(self):
        # The GPU devfreq node is still discovered, but only for the suspend clamp: its
        # frequency range at runtime belongs to PowerStation.
        self.gpu = self.discover_gpu()
        self.cpu_policies = sorted(Path("/sys/devices/system/cpu/cpufreq").glob("policy*"))
        self.fan_hwmon = self.discover_fan_hwmon()
        self.fan_pwm = self.fan_hwmon / "pwm1" if self.fan_hwmon else None
        self.fan_enable = self.fan_hwmon / "pwm1_enable" if self.fan_hwmon else None
        self.fan_rpm = self.fan_hwmon / "fan1_input" if self.fan_hwmon else None
        self.fan_binary = is_two_speed_fan(self.fan_hwmon)
        self.fan_on = False
        self.temp_paths = self.discover_temps()
        self.leds = discover_leds()

    def parse_config(self, include_user=True):
        fan_curves = {}
        parser = configparser.ConfigParser()
        config_files = [FACTORY_CONFIG_FILE]
        if include_user:
            if CONFIG_FILE.exists():
                config_files.append(CONFIG_FILE)
            # Sorted, and read last: our own 50- drop-in outranks the operator's /etc file,
            # a 90- of theirs outranks us. Later files win key-by-key, so a drop-in holding
            # only `[fan] curve=` overrides that key and inherits the rest of [fan].
            config_files.extend(sorted(CONFIG_DROPIN_DIR.glob("*.conf")))
        if not parser.read(config_files):
            raise FileNotFoundError(FACTORY_CONFIG_FILE)
        self.led_config = parse_led_config(parser)
        cpu_governor = parser.get("cpu", "governor", fallback=DEFAULT_CPU_GOVERNOR).strip()
        if not cpu_governor:
            raise ValueError("empty [cpu] governor")
        energy_aware = parser.get("cpu", "energy_aware", fallback="off").strip().lower()
        if energy_aware not in ("on", "off"):
            raise ValueError(f"[cpu] energy_aware must be on or off, not {energy_aware!r}")
        for section in parser.sections():
            if not section.startswith("fan_curve."):
                continue
            parts = section.split(".", 1)
            if len(parts) != 2:
                continue
            curve = parse_fan_curve(parser.get(section, "curve", fallback=""))
            if curve:
                fan_curves[parts[1]] = curve
        require_section(parser, "fan")
        # [fan] curve= names a [fan_curve.<name>] section or spells the points out inline.
        curve_value = parser.get("fan", "curve").strip()
        inline = parse_fan_curve(curve_value)
        if inline:
            curve_name, curve_points = "", inline
        elif curve_value.lower() in fan_curves:
            curve_name, curve_points = curve_value.lower(), fan_curves[curve_value.lower()]
        else:
            raise ValueError(f"unknown [fan] curve: {curve_value}")
        fan_config = {
            key: parser.getint("fan", key)
            for key in ("min_pwm", "max_pwm", "ramp_up", "ramp_down")
        }
        fan_config["smoothing"] = clamp(parser.getfloat("fan", "smoothing"), 0.0, 0.99)
        fan_config["pwm_quantum"] = clamp(parser.getint("fan", "pwm_quantum", fallback=1), 1, 255)
        # Two-speed fans only (is_two_speed_fan): where the curve turns the fan on, and how far
        # below that it turns off again.
        fan_config["switch_on_pwm"] = clamp(parser.getint("fan", "switch_on_pwm", fallback=77), 1, 255)
        fan_config["switch_hysteresis"] = clamp(parser.getint("fan", "switch_hysteresis", fallback=6), 0, 30)
        fan_config["min_pwm"] = clamp(fan_config["min_pwm"], 0, 255)
        fan_config["max_pwm"] = clamp(fan_config["max_pwm"], fan_config["min_pwm"], 255)
        fan_config["curve_stops"] = parse_curve_stops(
            parser.get("fan", "curve_stops",
                       fallback=",".join(str(stop) for stop in DEFAULT_CURVE_STOPS)))

        fan_off_below = clamp(parser.getint("suspend", "fan_off_below", fallback=45), 0, 120)
        fan_on_above = clamp(
            parser.getint("suspend", "fan_on_above", fallback=50),
            fan_off_below,
            120,
        )
        fan_safe_above = clamp(
            parser.getint("suspend", "fan_safe_above", fallback=55),
            fan_on_above,
            120,
        )
        fan_low_pwm = clamp(
            parser.getint("suspend", "fan_low_pwm", fallback=fan_config["min_pwm"]),
            0,
            fan_config["max_pwm"],
        )
        fan_safe_pwm = clamp(
            parser.getint("suspend", "fan_safe_pwm", fallback=FAN_SAFE_PWM),
            fan_low_pwm,
            fan_config["max_pwm"],
        )
        suspend_config = {
            "fan_off_below": fan_off_below,
            "fan_on_above": fan_on_above,
            "fan_safe_above": fan_safe_above,
            "fan_low_pwm": fan_low_pwm,
            "fan_safe_pwm": fan_safe_pwm,
        }
        return (cpu_governor, fan_curves, curve_name, curve_points, fan_config,
                suspend_config, energy_aware == "on")

    def load_config(self):
        try:
            parsed = self.parse_config()
        except Exception as exc:
            restore_factory_config(exc)
            parsed = self.parse_config(include_user=False)
        (
            self.cpu_governor,
            self.fan_curves,
            self.fan_curve_name,
            self.fan_curve_points,
            self.fan_config,
            self.suspend_config,
            self.cpu_energy_aware,
        ) = parsed

    def discover_gpu(self):
        for path in Path("/sys/class/devfreq").glob("*.gpu"):
            if (path / "available_frequencies").exists():
                return path
        for path in Path("/sys/class/devfreq").glob("*"):
            if "gpu" in path.name.lower() and (path / "governor").exists() and (path / "available_frequencies").exists():
                return path
        return None

    def discover_fan_hwmon(self):
        return discover_fan()

    def discover_temps(self):
        control = []
        for zone in Path("/sys/class/thermal").glob("thermal_zone*"):
            kind = read_text(zone / "type").lower()
            temp = zone / "temp"
            if not temp.exists():
                continue
            if kind.startswith(("cpu", "gpu", "gpuss", "video", "mem")):
                control.append(temp)
        return control

    def load_state(self):
        # Only the scheduler choice is persisted now. A state file from an image that still had
        # power profiles also carries profile=/gpu_level=/manual_gpu_clock=; those are ignored and
        # dropped on the next save.
        if not STATE_FILE.exists():
            return
        for line in read_text(STATE_FILE).splitlines():
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            if key == "cpu_scheduler" and value in CPU_SCHEDULERS:
                self.cpu_scheduler = value

    def save_state(self):
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(f"cpu_scheduler={self.cpu_scheduler}\n")

    def available_cpu_schedulers(self):
        # No sched_ext in this kernel, or no scx binary: only the in-kernel scheduler exists.
        # The manager hides its CpuScheduler1 interface entirely when this is the answer.
        if not (SCX_SYSFS.is_dir() and SCX_BINARY.exists()):
            return ["none"]
        allowed = getattr(self, "board_schedulers", None)
        if allowed:
            return [s for s in CPU_SCHEDULERS if s == "none" or s in allowed]
        return list(CPU_SCHEDULERS)

    def systemctl(self, *args, timeout=SCX_TIMEOUT):
        return subprocess.run(
            ["systemctl", *args],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )

    def scx_unit_active(self):
        try:
            return self.systemctl("is-active", SCX_UNIT, timeout=5).stdout.strip() == "active"
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"qforge-powerd: {SCX_UNIT} is-active failed: {exc}", file=sys.stderr)
            return False

    def reset_scx_failure(self):
        # scx.service carries upstream's StartLimitIntervalSec=30 / StartLimitBurst=2, so a couple
        # of quick none<->lavd flips leave the unit rate-limited and every later start refused with
        # no in-product way to clear it. Clearing first is free when there is nothing to clear.
        try:
            self.systemctl("reset-failed", SCX_UNIT, timeout=5)
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"qforge-powerd: {SCX_UNIT} reset-failed failed: {exc}", file=sys.stderr)

    def reconcile_scheduler_live(self):
        """Re-derive scheduler_live from the unit. Returns True if it changed.

        scheduler_live is a BELIEF, and the kernel can invalidate it without telling us:
        sched_ext ejects a misbehaving BPF scheduler on its own (`disabled (runtime error)`,
        `disabled (runnable task stall)`) and reverts every task to the stock scheduler. scx_lavd
        usually re-attaches in-process — its own `loop { .. should_restart() }` — so the unit
        survives and there is nothing to reconcile; but when it exits instead, the unit goes
        inactive while we still report "lavd". That is how ActiveCpuScheduler came to claim lavd
        across five consecutive ejections on 2026-08-27 while the system was actually on EEVDF.

        Deliberately the UNIT and not /sys/kernel/sched_ext/state: the sysfs file reads `disabled`
        for ~1s while scx_lavd attaches, so trusting it here would report "none" every time the
        scheduler is legitimately starting. GetStatus already carries the raw sysfs value for
        anyone who needs the kernel's own view.
        """
        if len(self.available_cpu_schedulers()) == 1:
            return False
        live = "lavd" if self.scx_unit_active() else "none"
        if live == self.scheduler_live:
            return False
        self.scheduler_live = live
        return True

    def restore_cpu_scheduler(self):
        # Apply the saved choice at daemon start, or DEFAULT_CPU_SCHEDULER ("none") when nothing
        # is saved. scx.service is never `enable`d, so this (and an explicit `systemctl start`) is
        # the only path that loads a BPF scheduler — a fresh device therefore boots on the stock
        # in-kernel scheduler and only a persisted `cpu_scheduler=lavd` starts the unit here.
        # Called from main() once our bus name is owned, so the unit's start job is not opened
        # from inside our own still-pending start (Type=dbus).
        if len(self.available_cpu_schedulers()) == 1:
            self.cpu_scheduler = "none"
            self.scheduler_live = "none"
            return
        if self.scx_unit_active():
            # Already running — somebody started it by hand, or powerd restarted underneath a
            # live scheduler. Adopt what is actually there instead of stopping their work.
            self.cpu_scheduler = "lavd"
            self.scheduler_live = "lavd"
            return
        if self.cpu_scheduler == "none":
            self.scheduler_live = "none"
            return
        self.reset_scx_failure()
        try:
            # --no-block on purpose: our own systemd start job is still open here (Type=dbus,
            # the bus name is taken after __init__ returns), so do not sit waiting on a second
            # job from inside it. A start that fails is reported by the unit, not by us.
            self.systemctl("start", "--no-block", SCX_UNIT)
            self.scheduler_live = "lavd"
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"qforge-powerd: restoring {SCX_UNIT} failed: {exc}", file=sys.stderr)
            self.cpu_scheduler = "none"
            self.scheduler_live = "none"

    def apply_scheduler(self, scheduler):
        """Make `scheduler` the LIVE one by starting/stopping scx.service. Touches
        scheduler_live only — the caller owns the persisted choice."""
        # Re-derive first: the guard below is the only thing standing between a caller and a
        # redundant unit cycle, and it is worthless if it compares against a stale belief. If the
        # kernel ejected lavd and scx_lavd exited, this is what lets the next apply start it again
        # instead of early-returning because we still think it is loaded.
        self.reconcile_scheduler_live()
        if scheduler == self.scheduler_live:
            return
        action = "stop" if scheduler == "none" else "start"
        if action == "start":
            self.reset_scx_failure()
        try:
            proc = self.systemctl(action, SCX_UNIT)
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError(f"systemctl {action} {SCX_UNIT} timed out") from exc
        if proc.returncode != 0:
            raise RuntimeError(f"systemctl {action} {SCX_UNIT} failed: {proc.stdout.strip()}")
        # Type=simple, so a zero exit only proves scx_lavd was exec'd, not that it attached —
        # attach takes ~1s and lands in the journal. Report the requested scheduler, same as
        # SteamOS does; GetStatus carries the kernel's own view for anyone who needs the truth.
        self.scheduler_live = scheduler

    def set_cpu_scheduler(self, scheduler):
        if scheduler not in self.available_cpu_schedulers():
            raise ValueError(scheduler)
        if scheduler == self.cpu_scheduler:
            return
        self.cpu_scheduler = scheduler
        self.apply_scheduler(scheduler)

    def gpu_freqs(self):
        if not self.gpu:
            return []
        return ints_from_file(self.gpu / "available_frequencies")

    def cpu_available_freqs(self, policy):
        freqs = ints_from_file(policy / "scaling_available_frequencies")
        if freqs:
            return freqs
        low = read_text(policy / "cpuinfo_min_freq")
        high = read_text(policy / "cpuinfo_max_freq")
        if low.isdigit() and high.isdigit():
            return [int(low), int(high)]
        return []

    def fan_curve_pwms(self):
        return resample_curve(self.fan_curve_points, self.fan_config["curve_stops"])

    def reload_config(self):
        """Re-read every layer and re-apply. Shared by the Reload method and every curve
        write, so a curve edit cannot drift from what an operator's `Reload` would do. The
        governor is not re-applied: after boot it is the power profile's (PowerStation)."""
        self.load_config()
        self.discover()
        if not getattr(self, "suspended", False):
            self.set_leds(True)

    def write_fan_dropin(self, pwms):
        """Rebuild the drop-in for a custom curve, or remove it when `pwms` is None."""
        if pwms is not None:
            CONFIG_DROPIN_DIR.mkdir(parents=True, exist_ok=True)
            text = render_fan_dropin(pwms, self.fan_config["curve_stops"])
            # Atomic replace: powerd re-reads this from its own reload path, and a half-written
            # ini is a quarantined config.
            temporary = FAN_CURVE_DROPIN.with_name(f".{FAN_CURVE_DROPIN.name}.new")
            temporary.write_text(text)
            os.replace(temporary, FAN_CURVE_DROPIN)
        else:
            FAN_CURVE_DROPIN.unlink(missing_ok=True)
        self.reload_config()

    def set_led(self, enabled=None, color=None, brightness=None):
        """Change one part of the LED setting and keep it: the drop-in is rewritten whole and the
        config reloaded, so what D-Bus reports is what an operator's Reload would give."""
        config = dict(self.led_config)
        if enabled is not None:
            config["enabled"] = bool(enabled)
        if color is not None:
            if len(color) != 3:
                raise ValueError("LedColor needs three values (R, G, B)")
            config["color"] = tuple(clamp(int(c), 0, 255) for c in color)
        if brightness is not None:
            config["brightness"] = clamp(int(brightness), 0, 255)
        CONFIG_DROPIN_DIR.mkdir(parents=True, exist_ok=True)
        temporary = LED_DROPIN.with_name(f".{LED_DROPIN.name}.new")
        temporary.write_text(render_led_dropin(config))
        os.replace(temporary, LED_DROPIN)
        self.reload_config()

    def led_changed(self):
        return {name: self.get_property(name) for name in ("LedEnabled", "LedColor", "LedBrightness")}

    def fan_curve_changed(self):
        return {
            "FanCurve": self.get_property("FanCurve"),
            "FanCurveIsCustom": self.get_property("FanCurveIsCustom"),
        }

    def set_fan_curve(self, pwms):
        clean = clean_curve_pwms(
            pwms, self.fan_config["curve_stops"], self.fan_config["min_pwm"],
            self.fan_config["max_pwm"])
        self.write_fan_dropin(clean)
        print(f"qforge-powerd: fan curve set to {format_fan_curve(self.fan_curve_points)}",
              file=sys.stderr)

    def reset_fan_curve(self):
        # Unconditional, including when there was nothing to remove: the reload has to run
        # either way so the reported end state is the real one, and an operator may have
        # edited the file since we last read it.
        self.write_fan_dropin(None)
        print("qforge-powerd: fan curve reset to factory", file=sys.stderr)

    def write_governor(self, path, preferred):
        """Set the governor, falling back only once the kernel has refused it.

        The preferred name is tried by WRITING it, not by looking it up in
        scaling_available_governors first. That list holds the governors currently
        REGISTERED, and a governor built as a module is not registered until something
        asks for it -- the ask being this very write, which lands in
        cpufreq_parse_governor() and request_module("cpufreq_%s"). Consulting the list
        first is therefore how a =m governor becomes permanently unreachable: it is never
        listed, so it is never written, so it never loads. (Our kernel builds all three =y
        precisely so this cannot bite, but powerd also runs on images it did not ship with,
        and the /etc config may name a governor the factory one never did.)

        The fallback is logged. This same fallback once made two power profiles identical at
        the governor level for a whole release, silently, and the only reason it was ever
        found was a hand check of scaling_available_governors on a device."""
        target = path / "scaling_governor"
        order = list(dict.fromkeys((preferred, "schedutil", "ondemand")))
        for name in order:
            if not try_write(target, name) or read_text(target) != name:
                continue
            if name != preferred:
                print(f"qforge-powerd: {path.name} governor '{preferred}' unavailable, "
                      f"using '{name}' (have: "
                      f"{read_text(path / 'scaling_available_governors')})", file=sys.stderr)
            return name
        print(f"qforge-powerd: {path.name} governor unsettable, left at "
              f"'{read_text(target)}'", file=sys.stderr)
        return None

    def apply_cpu_governor(self):
        """Replace the kernel's boot governor (performance) on every policy. Frequency LIMITS
        are not touched: they are the kernel's defaults until PowerStation is asked to change
        them, and the suspend clamp restores whatever was in force."""
        for policy in self.cpu_policies:
            self.write_governor(policy, self.cpu_governor)
        self.apply_energy_aware()

    def apply_energy_aware(self):
        """After every governor change: the kernel re-enables EAS whenever schedutil comes up on
        an asymmetric CPU, so the sysctl has to follow the governor, not just boot. The file only
        exists on kernels that can do EAS, and refusing a write (no energy model, a governor EAS
        does not run with) is fine: then EAS is off anyway."""
        if not EAS_SYSCTL.exists():
            return
        want = "1" if getattr(self, "cpu_energy_aware", False) else "0"
        if read_text(EAS_SYSCTL) != want and try_write(EAS_SYSCTL, want):
            print(f"qforge-powerd: sched_energy_aware={want}", file=sys.stderr)

    def apply_boot_cpu_governor(self):
        """The boot governor, once per boot. The marker is written even when a policy refused:
        a later start would only meet the same kernel, and by then the governors are the
        power profile's."""
        if BOOT_GOVERNOR_MARKER.exists():
            return
        self.apply_cpu_governor()
        BOOT_GOVERNOR_MARKER.parent.mkdir(parents=True, exist_ok=True)
        BOOT_GOVERNOR_MARKER.touch()

    def set_leds(self, on):
        """Nothing else lights the RGB LEDs: InputPlumber 0.81 parses a fixed LED colour but never
        applies it, and our xbox-elite target carries no LED output. Off for suspend."""
        if not getattr(self, "leds", None):
            return
        lit = on and self.led_config["enabled"]
        apply_leds(self.leds, self.led_config["color"], self.led_config["brightness"] if lit else 0)

    def suspend(self):
        if self.suspend_save:
            return
        self.set_leds(False)
        self.suspended = True
        self.suspend_fan_active = False
        self.suspend_save = {"cpu": [], "gpu": {}}
        for policy in self.cpu_policies:
            freqs = self.cpu_available_freqs(policy)
            if freqs:
                self.suspend_save["cpu"].append(
                    (
                        policy,
                        read_text(policy / "scaling_min_freq"),
                        read_text(policy / "scaling_max_freq"),
                    )
                )
                write_text(policy / "scaling_min_freq", freqs[0])
                write_text(policy / "scaling_max_freq", freqs[0])
        freqs = self.gpu_freqs()
        if self.gpu and freqs:
            self.suspend_save["gpu"] = {
                "governor": read_text(self.gpu / "governor"),
                "min": read_text(self.gpu / "min_freq"),
                "max": read_text(self.gpu / "max_freq"),
            }
            write_text(self.gpu / "min_freq", freqs[0])
            write_text(self.gpu / "max_freq", freqs[0])
        self.fan_tick()

    def resume(self):
        self.set_leds(True)
        self.suspended = False
        self.suspend_fan_active = False
        self.smoothed_temp = 0.0
        for policy, min_freq, max_freq in self.suspend_save.get("cpu", []):
            freqs = self.cpu_available_freqs(policy)
            if freqs:
                write_text(policy / "scaling_min_freq", freqs[0])
            if max_freq:
                write_text(policy / "scaling_max_freq", max_freq)
            if min_freq:
                write_text(policy / "scaling_min_freq", min_freq)
        gpu_save = self.suspend_save.get("gpu", {})
        if self.gpu and gpu_save:
            freqs = self.gpu_freqs()
            if freqs:
                write_text(self.gpu / "min_freq", freqs[0])
            if gpu_save.get("max"):
                write_text(self.gpu / "max_freq", gpu_save["max"])
            if gpu_save.get("min"):
                write_text(self.gpu / "min_freq", gpu_save["min"])
            if gpu_save.get("governor"):
                write_text(self.gpu / "governor", gpu_save["governor"])
        self.suspend_save = {}
        self.fan_tick()

    def read_temps(self):
        values = []
        for path in self.temp_paths:
            value = read_text(path)
            if value.isdigit():
                values.append(int(value) // 1000)
        return values

    def read_temp(self):
        values = sorted(self.read_temps(), reverse=True)
        if not values:
            return 0
        values = values[:3]
        return sum(values) // len(values)

    def read_temp_max(self):
        values = self.read_temps()
        return max(values) if values else 0

    def suspend_target_pwm(self, temp):
        config = self.suspend_config
        if not temp:
            return config["fan_safe_pwm"]
        if temp >= config["fan_safe_above"]:
            self.suspend_fan_active = True
            return config["fan_safe_pwm"]
        if self.suspend_fan_active:
            if temp <= config["fan_off_below"]:
                self.suspend_fan_active = False
                return 0
            return config["fan_low_pwm"]
        if temp >= config["fan_on_above"]:
            self.suspend_fan_active = True
            return config["fan_low_pwm"]
        return 0

    def quantize_pwm(self, pwm):
        quantum = self.fan_config["pwm_quantum"]
        if quantum > 1:
            pwm = round(pwm / quantum) * quantum
        return clamp(int(pwm), self.fan_config["min_pwm"], self.fan_config["max_pwm"])

    def target_pwm(self, temp):
        curve = self.fan_curve_points
        if not curve:
            return self.fan_config["min_pwm"]
        return self.quantize_pwm(curve_pwm(curve, temp))

    def fan_tick(self):
        try:
            if not self.fan_pwm:
                sd_notify("WATCHDOG=1")
                return True
            if self.fan_enable and self.fan_enable.exists():
                write_text(self.fan_enable, "1")

            if self.suspended:
                temp = self.read_temp_max()
                target = self.suspend_target_pwm(temp)
                self.smoothed_temp = float(temp)
                self.last_pwm = clamp(target, 0, self.fan_config["max_pwm"])
            else:
                temp = self.read_temp()
                if temp:
                    weight = self.fan_config["smoothing"]
                    self.smoothed_temp = temp if not self.smoothed_temp else (self.smoothed_temp * weight + temp * (1.0 - weight))
                    target = self.target_pwm(int(self.smoothed_temp))
                else:
                    target = FAN_SAFE_PWM
                if self.fan_binary:
                    if temp:
                        self.fan_on = binary_fan_on(
                            self.fan_curve_points, int(self.smoothed_temp), self.fan_on,
                            self.fan_config["switch_on_pwm"], self.fan_config["switch_hysteresis"])
                    else:
                        self.fan_on = True  # no temperature: fail safe
                    self.last_pwm = self.fan_config["max_pwm"] if self.fan_on else 0
                else:
                    if target > self.last_pwm:
                        next_pwm = min(target, self.last_pwm + self.fan_config["ramp_up"])
                    else:
                        next_pwm = max(target, self.last_pwm - self.fan_config["ramp_down"])
                    self.last_pwm = clamp(next_pwm, self.fan_config["min_pwm"], self.fan_config["max_pwm"])

            write_text(self.fan_pwm, self.last_pwm)
            if self.connection:
                self.emit_properties(
                    {
                        "FanPwm": GLib.Variant("u", self.last_pwm),
                        "FanRpm": GLib.Variant("u", self.fan_rpm_value()),
                        "Temperature": GLib.Variant("u", temp),
                    }
                )
            sd_notify("WATCHDOG=1")
        except Exception as exc:
            print(f"qforge-powerd: fan tick failed: {exc}", file=sys.stderr)
            self.fan_safe()
            sd_notify("WATCHDOG=1")
        return True

    def scheduler_tick(self):
        # Suspended = session frozen and CPUs mostly offline; nothing to reconcile then. Never
        # lets an exception kill the timer.
        try:
            if not self.suspended:
                # Notice if the scheduler went away underneath us (sched_ext ejection that
                # scx_lavd did not survive). Nothing else announces that, so a client would
                # otherwise keep rendering "LAVD" for a system that is back on the stock scheduler.
                if self.reconcile_scheduler_live() and self.connection is not None:
                    self.emit_properties({
                        "ActiveCpuScheduler": GLib.Variant("s", self.scheduler_live),
                    })
        except Exception as exc:
            print(f"qforge-powerd: scheduler tick failed: {exc}", file=sys.stderr)
        return True

    def fan_safe(self):
        if not self.fan_pwm:
            return
        if self.fan_enable and self.fan_enable.exists():
            write_text(self.fan_enable, "1")
        write_text(self.fan_pwm, FAN_SAFE_PWM)
        self.last_pwm = FAN_SAFE_PWM

    def fan_rpm_value(self):
        value = read_text(self.fan_rpm) if self.fan_rpm else ""
        return int(value) if value.isdigit() else 0

    def get_property(self, prop):
        if prop == "AvailableCpuSchedulers":
            return GLib.Variant("as", self.available_cpu_schedulers())
        if prop == "CpuScheduler":
            return GLib.Variant("s", self.cpu_scheduler)
        if prop == "ActiveCpuScheduler":
            return GLib.Variant("s", self.scheduler_live)
        if prop == "FanMode":
            return GLib.Variant("s", "managed" if self.fan_pwm else "unavailable")
        if prop == "FanPwm":
            return GLib.Variant("u", self.last_pwm)
        if prop == "FanRpm":
            return GLib.Variant("u", self.fan_rpm_value())
        if prop == "Temperature":
            return GLib.Variant("u", self.read_temp())
        if prop == "FanCurveStops":
            return GLib.Variant("au", self.fan_config["curve_stops"])
        if prop == "FanCurve":
            return GLib.Variant("au", self.fan_curve_pwms())
        if prop == "FanCurveMinPwm":
            return GLib.Variant("u", self.fan_config["min_pwm"])
        if prop == "FanCurveMaxPwm":
            return GLib.Variant("u", self.fan_config["max_pwm"])
        if prop == "FanCurveIsCustom":
            return GLib.Variant("b", self.fan_curve_name == CUSTOM_CURVE)
        if prop == "LedCount":
            return GLib.Variant("u", len(self.leds))
        if prop == "LedEnabled":
            return GLib.Variant("b", self.led_config["enabled"])
        if prop == "LedColor":
            return GLib.Variant("au", list(self.led_config["color"]))
        if prop == "LedBrightness":
            return GLib.Variant("u", self.led_config["brightness"])
        raise KeyError(prop)

    def set_property(self, prop, value):
        changed = {}
        if prop == "CpuScheduler":
            self.set_cpu_scheduler(value.get_string())
            changed["CpuScheduler"] = GLib.Variant("s", self.cpu_scheduler)
        elif prop == "FanCurve":
            self.set_fan_curve(list(value))
            changed = self.fan_curve_changed()
        elif prop == "LedEnabled":
            self.set_led(enabled=value.get_boolean())
            changed = self.led_changed()
        elif prop == "LedColor":
            self.set_led(color=list(value))
            changed = self.led_changed()
        elif prop == "LedBrightness":
            self.set_led(brightness=value.get_uint32())
            changed = self.led_changed()
        else:
            raise KeyError(prop)
        self.save_state()
        self.emit_properties(changed)

    def status(self):
        return {
            "cpu_governor": GLib.Variant("s", self.cpu_governor),
            "cpu_scheduler": self.get_property("CpuScheduler"),
            # The kernel's own view ("enabled"/"disabled"/absent), which the property above
            # cannot express: it lags a start by ~1s and goes back to "disabled" on its own if
            # a BPF scheduler is ejected. Diagnostics only.
            "sched_ext_state": GLib.Variant("s", read_text(SCX_SYSFS / "state")),
            "fan_mode": self.get_property("FanMode"),
            "fan_pwm": self.get_property("FanPwm"),
            "fan_rpm": self.get_property("FanRpm"),
            "fan_curve": self.get_property("FanCurve"),
            "fan_curve_stops": self.get_property("FanCurveStops"),
            "fan_curve_custom": self.get_property("FanCurveIsCustom"),
            "temperature": self.get_property("Temperature"),
            "suspended": GLib.Variant("b", self.suspended),
            "leds": GLib.Variant("as", [str(led) for led in self.leds]),
            "led_enabled": self.get_property("LedEnabled"),
        }

    def emit_properties(self, changed, path=OBJECT_PATH, iface=IFACE):
        self.connection.emit_signal(
            None,
            path,
            "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", (iface, changed, [])),
        )

    def handle_method_call(self, _conn, _sender, _path, iface, method, _params, invocation):
        if iface != IFACE:
            invocation.return_dbus_error(f"{BUS_NAME}.Error.UnknownInterface", iface)
            return
        if method == "Reload":
            try:
                self.reload_config()
            except Exception as exc:
                print(f"qforge-powerd: reload failed: {exc}", file=sys.stderr)
                invocation.return_dbus_error(f"{BUS_NAME}.Error.ReloadFailed", str(exc))
                return
            self.emit_properties(self.fan_curve_changed())
            invocation.return_value(None)
            return
        if method == "ResetFanCurve":
            try:
                self.reset_fan_curve()
            except Exception as exc:
                print(f"qforge-powerd: {method} failed: {exc}", file=sys.stderr)
                invocation.return_dbus_error(f"{BUS_NAME}.Error.FanCurveFailed", str(exc))
                return
            self.emit_properties(self.fan_curve_changed())
            invocation.return_value(None)
            return
        if method == "Suspend":
            self.suspend()
            invocation.return_value(None)
            return
        if method == "Resume":
            self.resume()
            invocation.return_value(None)
            return
        if method == "GetStatus":
            invocation.return_value(GLib.Variant("(a{sv})", (self.status(),)))
            return
        invocation.return_dbus_error(f"{BUS_NAME}.Error.UnknownMethod", method)

    def handle_get_property(self, _conn, _sender, _path, iface, prop):
        if iface != IFACE:
            return None
        try:
            return self.get_property(prop)
        except Exception:
            return None

    def handle_set_property(self, _conn, _sender, _path, iface, prop, value):
        if iface != IFACE:
            return False
        try:
            self.set_property(prop, value)
            return True
        except Exception as exc:
            print(f"qforge-powerd: set {prop} failed: {exc}", file=sys.stderr)
            return False

    def register(self, connection):
        self.connection = connection
        # Keep a reference to the node: Gio does not own the DBusInterfaceInfo we hand it, and a
        # collected node takes the registration's interface info with it.
        self.node = Gio.DBusNodeInfo.new_for_xml(XML)
        connection.register_object(
            OBJECT_PATH,
            self.node.interfaces[0],
            self.handle_method_call,
            self.handle_get_property,
            self.handle_set_property,
        )


def main():
    if "--fan-safe" in sys.argv:
        fan_safe_once()
        return

    global GLib, Gio
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import GLib, Gio

    loop = GLib.MainLoop()
    power = QforgePower()

    def bus_acquired(connection, _name):
        power.register(connection)

    def name_acquired(_connection, _name):
        power.restore_cpu_scheduler()

    def name_lost(_connection, _name):
        loop.quit()

    owner_id = Gio.bus_own_name(
        Gio.BusType.SYSTEM,
        BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        bus_acquired,
        name_acquired,
        name_lost,
    )

    def stop(_signum, _frame):
        power.fan_safe()
        loop.quit()

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, stop)
    try:
        loop.run()
    finally:
        power.fan_safe()
        Gio.bus_unown_name(owner_id)


if __name__ == "__main__":
    main()
