#!/usr/bin/env python3
# retroforge-steam-proton — Steam's Proton on the boards where Valve's own is the wrong tool
# (steam_tool.our_proton):
#   - ARMv8.0 CPUs (no LSE atomics, e.g. the SM6115): Proton-CachyOS rebuilt for them
#     (retroforge-linux/proton-cachyos-armv8). Valve builds its Protons with LSE atomics, which the
#     kernel emulates there;
#   - another board whose GPU needs DXVK-Sarek (the SM4450's Adreno 613): Proton-CachyOS's own arm64
#     build. Valve's Protons carry only upstream DXVK, so no DirectX game starts with them there (the
#     Adreno 610: Among Us and Hollow Knight, "d3d11: failed to create factory (80004005)", MANGMI
#     Air X, 2026-11-28; user's choice for the SM4450 too, 2026-11-28, not run on one).
# On every other board it does nothing and Steam keeps its own default: there Proton-CachyOS is an
# optional download (Apps > Proton), never a default.
#
#   retroforge-steam-proton status   armv8 or arm64 (which build is Steam's tool here), or steam (none)
#   retroforge-steam-proton apply    /usr/bin/steam runs this before the client starts, and
#                                    steam-install once Steam Client is installed
#   retroforge-steam-proton pending  exit 0 when the running client should be restarted for apply to
#                                    set our build (/usr/bin/steam asks before a kept client gets a
#                                    launch), 1 otherwise
#
# apply installs or updates the build in the background (steam-compat-tools; Steam Client's install
# has already put it in place, see steam-install), and once it is installed and the client is not
# running, sets it as Steam's default compatibility tool: entry "0" of CompatToolMapping in config.vdf.
# Before the client's first real start there is no config.vdf: this writes one holding only that
# entry, which the client reads and keeps, so the first Windows game already runs with our build.
#
# EACH GAME STEAM WOULD START WITH A PROTON TOO. Steam picks a game's tool by priority: one set for the
# game (250), Valve's recommendation for it (100 or 85), the default (75). Valve recommends its own
# Proton for most Windows games, so the client ran them with Valve's build while the launches without
# the client ran ours, and each switch made the next launch redo Wine's prefix set-up (~45 s on the Air
# X: Hades, 2026-10-24). So each such installed game gets its own entry for our build, as the player
# would set it in its Properties (steam_tool.proton_game): one Steam's app cache lists for Windows and
# not Linux, and one with a Linux build that Valve recommends a Proton for all the same, in its own
# list of games or in the game's Deck test result (Hollow Knight and SuperTux; started by the client,
# Hollow Knight died with Valve's Proton on the Air X). A game set to any other tool keeps it, one set
# to an ARMv8.0 build RetroForge offered before (Valve's Proton rebuilt, OLD_DIRS) moves to this one. A
# game Valve leaves on its Linux build is left to Steam.
#
# A RUNNING CLIENT. config.vdf is the client's while it runs (it writes its own when it exits), so apply
# leaves it alone then, and our build is set at the client's next start. A client kept running in the
# background (/usr/bin/steam, retroforge-steam-keep) may not start again before the next boot: one
# opened while Steam Client's install or this build's download ran never had it, and a Windows game
# installed under it ran its first launches with Valve's Proton, which Valve recommends for it (85 over
# the default's 75). `pending` says when set_tools would change config.vdf for an entry it has not
# written since this boot ($XDG_RUNTIME_DIR/retroforge-steam-proton.set): /usr/bin/steam then restarts
# a kept client nothing else uses before it hands it a launch. An entry the client dropped after we wrote
# it is not pending again: a restart would not keep it either.
#
# TEST SEAMS (tests/test-steam-proton.sh): RETROFORGE_STEAM_ROOT, RETROFORGE_CPUINFO,
# RETROFORGE_STEAM_COMPAT_TOOLS (the helper), RETROFORGE_STEAM_PROTON_START (a command run with the
# helper and `install` as arguments instead of systemd-run), RETROFORGE_STEAM_LIBRARY (the steam-library
# whose readers this uses), and steam_tool.needs_sarek's RETROFORGE_DEVICE_ENV and RETROFORGE_STEAM_SAREK.
import importlib.machinery
import importlib.util
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "retroforge", "python"))
import steam_tool  # noqa: E402  (config.vdf's editor, which build is Steam's tool here and for which games)
from steam_tool import mappings, set_entry  # noqa: E402

DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
STEAM_ROOT = os.environ.get("RETROFORGE_STEAM_ROOT") or os.path.join(DATA, "Steam")
CPUINFO = os.environ.get("RETROFORGE_CPUINFO", "/proc/cpuinfo")
HELPER = os.environ.get("RETROFORGE_STEAM_COMPAT_TOOLS", "/usr/lib/retroforge/steam-compat-tools")
START = os.environ.get("RETROFORGE_STEAM_PROTON_START")
LOG = os.path.join(DATA, "retroforge", "steam-compat-tools.log")
KINDS = {steam_tool.ARMV8_PROTON: "armv8", steam_tool.ARM64_PROTON: "arm64"}  # what status and apply print
# The folders of the Valve-based ARMv8.0 builds offered before (steam-compat-tools' DROPPED).
OLD_DIRS = ("proton-armv8-retroforge", "proton-armv8-experimental-retroforge")
STEAM_LIBRARY = os.environ.get("RETROFORGE_STEAM_LIBRARY", "/usr/lib/retroforge/steam-library")
VDF = os.path.join(STEAM_ROOT, "config", "config.vdf")
MAPPING, EMPTY_VDF = steam_tool.MAPPING, steam_tool.EMPTY_VDF
DEFAULT = MAPPING + ["0"]
# The CompatToolMapping entries set_tools wrote since this boot, one key per line ("0", app ids).
WRITTEN = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "retroforge-steam-proton.set")


def log(msg):
    print(f"retroforge-steam-proton: {msg}", file=sys.stderr, flush=True)


def our_tool():
    """The build that is Steam's tool on this board, "" where Steam keeps its own."""
    return steam_tool.our_proton(CPUINFO)


def installed(tool):
    return all(os.path.isfile(os.path.join(tool, f)) for f in (".retroforge-pin", "proton", "compatibilitytool.vdf"))


def client_running():
    client = os.path.join(STEAM_ROOT, "steamrtarm64", "steam")
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv0 = f.read().split(b"\0", 1)[0].decode("utf-8", "replace")
        except OSError:
            continue
        if argv0 == client or argv0.endswith("/steamrtarm64/steam"):
            return True
    return False


def start_install():
    """The build installed or updated in the background, its log appended to LOG."""
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    out = open(LOG, "a")
    if START:
        subprocess.Popen([START, HELPER, "install"], stdout=out, stderr=out, start_new_session=True)
        return
    res = subprocess.run(["systemd-run", "--user", "--quiet", "--collect", "--unit=retroforge-steam-compat-tools",
                          f"--setenv=RETROFORGE_STEAM_ROOT={STEAM_ROOT}", f"-pStandardOutput=append:{LOG}",
                          f"-pStandardError=append:{LOG}", HELPER, "install"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode != 0:  # no user manager, or another run is already going (its lock decides)
        subprocess.Popen([HELPER, "install"], stdout=out, stderr=out, start_new_session=True)


def steam_library():
    """/usr/lib/retroforge/steam-library as a module: its manifest and app cache readers."""
    loader = importlib.machinery.SourceFileLoader("steam_library", STEAM_LIBRARY)
    spec = importlib.util.spec_from_loader("steam_library", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def proton_games():
    """{appid: name} of the installed games Steam would start with a Proton (steam_tool.proton_game), by
    the client's app cache: its lists of tools hold Valve's own mappings."""
    lib = steam_library()
    installed = lib.installed_apps(STEAM_ROOT)
    if not installed:
        return {}
    nodes = lib.app_nodes(STEAM_ROOT, set(installed) | set(steam_tool.LISTS))
    mapped = steam_tool.valve_mappings(nodes)
    return {appid: installed[appid]["name"] for appid, node in nodes.items()
            if appid in installed and steam_tool.proton_game(appid, node, mapped)}


def plan(name):
    """(text, new, fresh, keys, added): config.vdf now and as set_tools writes it, whether there was
    none, the CompatToolMapping entries it changes ("0", app ids) and the games among them."""
    fresh = False
    try:
        with open(VDF, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        # The client writes config.vdf at its first real start (not at steam-install's update run),
        # and reads one that is there: so it starts with our default, not Valve's Proton.
        text, fresh = EMPTY_VDF, True
    new = set_entry(text, DEFAULT, {"name": name, "config": "", "priority": "75"})
    keys = ["0"] if new != text else []
    try:
        games = proton_games()
    except Exception as err:  # the app cache unreadable: the default alone
        log(f"could not read the installed games' platforms: {err}")
        games = {}
    tools, added = mappings(new), []
    for appid, game in sorted(games.items()):
        have = tools.get(str(appid))
        if have == name or (have is not None and have not in OLD_DIRS):
            continue
        new = set_entry(new, MAPPING + [str(appid)], {"name": name, "config": "", "priority": "250"})
        keys.append(str(appid))
        added.append(game)
    return text, new, fresh, keys, added


def written():
    try:
        with open(WRITTEN, encoding="utf-8") as f:
            return set(f.read().split())
    except OSError:
        return set()


def pending():
    """See A RUNNING CLIENT."""
    name = our_tool()
    if not name or not installed(os.path.join(STEAM_ROOT, "compatibilitytools.d", name)):
        return False
    try:
        keys = plan(name)[3]
    except (OSError, ValueError):  # a config.vdf we cannot edit: a restart would not help
        return False
    return bool(set(keys) - written())


def set_tools(name):
    """Our build as Steam's default and as the own tool of each game Steam would start with a Proton
    (see EACH GAME STEAM WOULD START WITH A PROTON TOO)."""
    text, new, fresh, keys, added = plan(name)
    if added:
        log(f"{name} is now the tool of {', '.join(added)}")
    if new == text:
        return
    os.makedirs(os.path.dirname(VDF), exist_ok=True)
    backup = VDF + ".before-retroforge-proton"
    if not fresh and not os.path.exists(backup):
        with open(backup, "w", encoding="utf-8") as f:
            f.write(text)
    with open(VDF + ".part", "w", encoding="utf-8") as f:
        f.write(new)
    os.replace(VDF + ".part", VDF)
    try:
        with open(WRITTEN, "a", encoding="utf-8") as f:
            f.write("".join(k + "\n" for k in keys))
    except OSError:
        pass
    if mappings(text).get("0") != name:
        log(f"Steam's default compatibility tool is now {name}")


def apply():
    name = our_tool()
    if not name:
        return "steam"
    tool = os.path.join(STEAM_ROOT, "compatibilitytools.d", name)
    start_install()
    if not installed(tool):
        log(f"{name} is not installed yet (it downloads in the background); Steam keeps its default for now")
    elif client_running():
        log("the Steam client is running; its default tool is set at its next start (a kept client "
            "is restarted for it before a launch that nothing else needs it during)")
    else:
        try:
            set_tools(name)
        except (OSError, ValueError) as err:
            log(f"could not set Steam's default tool in {VDF}: {err}")
    return KINDS[name]


def main(argv):
    if argv[1:] == ["status"]:
        print(KINDS.get(our_tool(), "steam"))
        return 0
    if argv[1:] == ["apply"]:
        print(apply())
        return 0
    if argv[1:] == ["pending"]:
        return 0 if pending() else 1
    log("usage: retroforge-steam-proton status|apply|pending")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
