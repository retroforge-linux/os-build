#!/usr/bin/env python3
# retroforge-cheevos — the player's RetroAchievements sign-in for RetroArch (plan retroarch Phase 3).
#
#     retroforge-cheevos login <user>     -> the password on stdin (one line); checked with
#                                            retroachievements.org, the token saved; JSON status on stdout
#     retroforge-cheevos logout           -> the name and token removed from RetroArch's settings
#     retroforge-cheevos hardcore on|off  -> RetroArch's hardcore mode (no save states, rewind, cheats)
#     retroforge-cheevos status           -> JSON on stdout: signed_in, user, hardcore, retroarch_running
#
# THE CALLER IS THE RETROFORGE OGUI PLUGIN (Settings > Library > RetroAchievements). Exit status:
# 0 ok, 2 bad invocation, 3 network (retroachievements.org not reached), 5 local (a file, or
# RetroArch running: see below), 7 the sign-in refused (wrong name or password), 8 an answer that
# is not RetroAchievements' login (the site busy or changed). stderr says why, in English.
#
# SECRETS. The password is read from stdin, never argv, and goes to curl on stdin too (-K -: a
# config holding the URL and the form), so no process list ever shows it. It is never written
# anywhere: only the token RetroAchievements answers with is kept, as cheevos_token in RetroArch's
# ~/.config/retroarch/retroarch.cfg (cheevos_password stays empty), the file made 0600 before the
# token goes in, under umask 077 (the temporary file write_atomic renames into place too). curl runs
# with -q (no ~/.curlrc), https only, certificates checked. RetroArch signs in with that token at every game, as after a sign-in in its own
# menu. The standalone emulators with RetroAchievements (DuckStation, ARMSX2, PPSSPP, Dolphin,
# Flycast) get the same name, token and hardcore setting from retroforge-launch at each of their
# launches, read from this file (the achievements module in /usr/lib/retroforge/python): this tool
# never writes their files, so nothing here waits on them running.
#
# RETROARCH RUNNING: RetroArch writes retroarch.cfg back from memory when it exits
# (config_save_on_exit), so a change made while it runs would be undone: login, logout and hardcore
# refuse with exit 5 then. A home where RetroArch never ran gets the image's seed first: a
# retroarch.cfg holding only the sign-in would keep the seed out for good (the launcher never seeds
# over an existing file).
#
# TEST SEAMS (tests/test-cheevos.sh): RETROFORGE_CURL, RETROFORGE_EMU_DATA_DIR, RETROFORGE_PROC.
import json
import os
import re
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "retroforge", "python"))
import emuopts  # noqa: E402

EXIT_OK, EXIT_USAGE, EXIT_NET, EXIT_LOCAL, EXIT_LOGIN, EXIT_ANSWER = 0, 2, 3, 5, 7, 8
CURL = os.environ.get("RETROFORGE_CURL", "curl")
EMU_DATA_DIR = os.environ.get("RETROFORGE_EMU_DATA_DIR", "/usr/share/retroforge/emulators")
PROC = os.environ.get("RETROFORGE_PROC", "/proc")
HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config/retroarch/retroarch.cfg")
SEED = os.path.join(EMU_DATA_DIR, "retroarch", "retroarch.cfg")
LOGIN_URL = "https://retroachievements.org/dorequest.php"
USER = re.compile(r"[A-Za-z0-9_.-]{1,64}")   # RetroAchievements names are letters and digits
TOKEN = re.compile(r"[A-Za-z0-9]{8,128}")
PASSWORD_MAX = 256
ANSWER_MAX = 64 << 10  # bytes: login2's answer is a few hundred


class Fail(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def log(msg):
    print(f"retroforge-cheevos: {msg}", file=sys.stderr, flush=True)


def version():
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("VERSION_ID="):
                    return re.sub(r"[^A-Za-z0-9._-]", "", line.split("=", 1)[1].strip().strip('"')) or "dev"
    except OSError:
        pass
    return "dev"


def retroarch_running():
    """Whether a RetroArch runs: argv[0] .../bin/retroarch (what the launcher starts: HW 2026-11-09,
    /tmp/.mount_<id>/bin/retroarch --config ...) or the kernel's name for it is retroarch (a build
    that runs its binary through a bundled ld.so). It fails open (a missed RetroArch undoes the
    change at its exit), so both are checked."""
    try:
        pids = [p for p in os.listdir(PROC) if p.isdigit()]
    except OSError:
        return False
    for pid in pids:
        try:
            with open(os.path.join(PROC, pid, "cmdline"), "rb") as f:
                argv = f.read(4096).split(b"\0")
        except OSError:
            continue
        if argv[0].endswith(b"/bin/retroarch") or any(a.endswith(b"/shared/bin/retroarch") for a in argv[1:3]):
            return True
        try:
            with open(os.path.join(PROC, pid, "comm"), "rb") as f:
                if f.read(64).strip() == b"retroarch":
                    return True
        except OSError:
            pass
    return False


def refuse_if_running():
    if retroarch_running():
        raise Fail(EXIT_LOCAL, "RetroArch is running: close the game first (RetroArch writes its own "
                               "settings back when it exits, undoing this)")


def read_cfg():
    try:
        with open(CFG) as f:
            return f.read()
    except FileNotFoundError:
        return None
    except OSError as err:
        raise Fail(EXIT_LOCAL, f"cannot read {CFG}: {err}")


def prepare_cfg():
    """retroarch.cfg as text, 0600: the image's seed first when RetroArch never ran."""
    try:
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        if not os.path.lexists(CFG):
            fd = os.open(CFG, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as dst, open(SEED, "rb") as src:
                shutil.copyfileobj(src, dst)
        os.chmod(CFG, 0o600)
    except OSError as err:
        raise Fail(EXIT_LOCAL, f"cannot prepare {CFG}: {err}")
    return read_cfg()


def write_cfg(settings):
    """Set each key = "value" in retroarch.cfg (RetroArch's own quoting), atomically, 0600 kept."""
    text = prepare_cfg()
    for key, value in settings.items():
        text = emuopts.ini_set(text, "", key, f'"{value}"', " = ")
    try:
        emuopts.write_atomic(CFG, text.encode())
    except OSError as err:
        raise Fail(EXIT_LOCAL, f"cannot write {CFG}: {err}")


def cfg_value(text, key):
    raw = emuopts.ini_get(text or "", "", key)
    return raw.strip().strip('"') if raw is not None else ""


def curl_quote(value):
    """A curl config string: double quotes, with \\ and \" escaped."""
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def ask_login(user, password):
    """login2's answer as a dict; exit 3 when the site is not reached, 8 when it is not login2's."""
    config = "\n".join([
        f"url = {curl_quote(LOGIN_URL)}",
        f"data-urlencode = {curl_quote('r=login2')}",
        f"data-urlencode = {curl_quote('u=' + user)}",
        f"data-urlencode = {curl_quote('p=' + password)}",
        f"user-agent = {curl_quote(f'RetroForge/{version()} retroforge-cheevos')}",
    ]) + "\n"
    cmd = [CURL, "-q", "--silent", "--show-error", "--proto", "=https", "--proto-redir", "=https",
           "--connect-timeout", "20", "--max-time", "60", "--max-filesize", str(ANSWER_MAX),
           "-w", r"\n%{http_code}", "-K", "-"]
    try:
        res = subprocess.run(cmd, input=config.encode(), capture_output=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as err:
        raise Fail(EXIT_NET, f"retroachievements.org not reached: {err}")
    if res.returncode != 0:
        raise Fail(EXIT_NET, f"retroachievements.org not reached (curl exit {res.returncode}): "
                             f"{res.stderr.decode(errors='replace').strip()}")
    body, _, code = res.stdout.rpartition(b"\n")
    try:
        answer = json.loads(body[:ANSWER_MAX])
    except ValueError:
        answer = None
    if not isinstance(answer, dict) or "Success" not in answer:
        raise Fail(EXIT_ANSWER, f"retroachievements.org answered HTTP {code.decode(errors='replace')} "
                                f"without a login result: try again later")
    return answer


def cmd_login(user):
    password = sys.stdin.readline().rstrip("\r\n")
    if not USER.fullmatch(user or ""):
        raise Fail(EXIT_USAGE, "login needs a RetroAchievements user name (letters and digits)")
    if not password or len(password) > PASSWORD_MAX or not password.isprintable():
        raise Fail(EXIT_USAGE, "login needs the password on stdin, one line")
    refuse_if_running()
    answer = ask_login(user, password)
    if answer.get("Success") is not True:
        why = "".join(c for c in str(answer.get("Error") or "") if c.isprintable())[:200]
        raise Fail(EXIT_LOGIN, why or "RetroAchievements refused the sign-in")
    name, token = str(answer.get("User") or ""), str(answer.get("Token") or "")
    if not (USER.fullmatch(name) and TOKEN.fullmatch(token)):
        raise Fail(EXIT_ANSWER, "RetroAchievements' answer holds no usable name and token")
    refuse_if_running()  # again: a game may have started during the request (up to a minute)
    write_cfg({"cheevos_enable": "true", "cheevos_username": name, "cheevos_token": token,
               "cheevos_password": ""})
    log(f"signed in as {name}")
    return cmd_status()


def cmd_logout():
    refuse_if_running()
    if read_cfg() is not None:
        write_cfg({"cheevos_username": "", "cheevos_token": "", "cheevos_password": ""})
    return EXIT_OK


def cmd_hardcore(state):
    refuse_if_running()
    write_cfg({"cheevos_hardcore_mode_enable": "true" if state == "on" else "false"})
    return EXIT_OK


def cmd_status():
    text = read_cfg()
    user, token = cfg_value(text, "cheevos_username"), cfg_value(text, "cheevos_token")
    print(json.dumps({"signed_in": bool(user and token), "user": user or None,
                      "hardcore": cfg_value(text, "cheevos_hardcore_mode_enable") == "true",
                      "retroarch_running": retroarch_running()}, sort_keys=True))
    return EXIT_OK


def main(argv):
    usage = "usage: retroforge-cheevos login <user> (password on stdin) | logout | hardcore on|off | status"
    if len(argv) == 2 and argv[0] == "login":
        return cmd_login(argv[1])
    if argv == ["logout"]:
        return cmd_logout()
    if len(argv) == 2 and argv[0] == "hardcore" and argv[1] in ("on", "off"):
        return cmd_hardcore(argv[1])
    if argv == ["status"]:
        return cmd_status()
    raise Fail(EXIT_USAGE, usage)


if __name__ == "__main__":
    # Every file and folder this tool makes is the player's alone, write_atomic's temporary file
    # included: it holds the token before it is renamed over retroarch.cfg.
    os.umask(0o077)
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as f:
        log(str(f))
        sys.exit(f.code)
    except KeyboardInterrupt:
        sys.exit(EXIT_LOCAL)
