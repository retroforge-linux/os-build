#!/usr/bin/env python3
# retroforge-launch — start a ROM in its system's emulator, from an OpenGamepadUI library card.
#
#   retroforge-launch <system> <rom>
#   retroforge-launch --gui <emulator>
#   retroforge-launch --psn-install
#
# --gui starts the emulator's own UI with no ROM: Main menu > Emulators > Open, for the settings OGUI
# does not expose. It runs exactly like a ROM (prepare, seed, own session, exit handling below),
# with the definition's gui_args in place of args.
#
# Emulators are not in the image: the plugin downloads each one into /home/player/emulators/. Which
# emulator runs a system, and the emulator.json that says how, with the seeds, sync and per-system
# settings it puts into $HOME: launch_def. How each download format runs: launch_formats. The PSN
# inbox: psn_inbox. Per-emulator options: emuopts. The RetroAchievements sign-in a standalone
# emulator gets at every launch: achievements. All five live in /usr/lib/retroforge/python.
#
# CPU pinning (CPUS=big): the emulator is started on the device's fast cores, so its threads stay
# off the little cluster and do not migrate across clusters; background work (audio, input, Wi-Fi)
# keeps the little cores. "Fast" is every ONLINE CPU whose cpu_capacity is above the smallest online
# one — never a CPU number (Qualcomm numbers slowest-first, other SoCs do not), and never only the top
# tier (one prime core is no home for a multi-threaded emulator). PowerStation's core-count slider is
# the POWER control and offlines the fast cores first, so with none of them online, or on a
# homogeneous SoC, nothing is pinned. sched_ext schedulers (scx_lavd) honour the affinity mask (HW
# 2026-10-03). It is the PLAYER's choice, never the image's: a default per emulator (Settings >
# Emulators -> ~/.config/retroforge/emulators/<emulator>.conf, CPUS=big|all, also used by --gui) and an
# override per game (Game settings > RetroForge -> ~/.config/retroforge/games/<system>/<rom file>.conf,
# the same CPUS line). Nothing ships pinned: with neither, all cores.
#
# Per-emulator options (renderer, resolution, aspect...): /usr/share/retroforge/emulators/<emulator>/
# options.json says what each value does (command-line arguments, environment, settings in the
# emulator's own files); the player's choices are lines of the same two confs, the game's winning.
# emuopts (/usr/lib/retroforge/python) applies them before the start: an emulator-level value stays
# in the emulator's settings, a game-level one is put back when the emulator exits (and at the next
# launch, after a double Exit). Its header has the details.
#
# One-time installs (install): a file the PLAYER provides that the emulator must import before any
# game runs (RPCS3's PS3 firmware). When `unless` is missing under $HOME, the emulator's binary is run
# with `args` ("{file}" = $HOME/<from>) from the mounted download, before the game, and waited for;
# `unless` must exist afterwards. A ROM launch whose `from` file is missing does not start the
# emulator (it would wait on its own error dialog): it ends with exit 3 and `missing-file <emulator>
# <from>` in the status file, so the plugin can tell the player where to put it. --gui still opens
# without it.
#
# Stub ROMs (stub): a card for a game that lives inside the emulator's own data, not in ~/roms — a
# PSN game RPCS3 installed into dev_hdd0 (plan psn-pkg). The card's file is a stub the installer
# wrote: its first line is a game id, and the definition maps the stub's extension to what the
# emulator boots in its place ("{text}" = that id; RPCS3's "%RPCS3_GAMEID%:NPUB30024" resolves the
# installed game through its own VFS). Only the emulator's command line gets the target: the stub
# file stays the game's identity everywhere else (the card's name is its filename, the per-game
# conf is keyed on it). The installer writes the stub as UTF-8, the id ASCII letters, digits and
# underscore (STUB_ID): anything else on the first line — or a binary, empty or unreadable file —
# ends the launch (exit 3, `bad-stub <emulator>`), and the plugin's popup (plan psn-pkg phase 3)
# tells the player to reinstall the package.
#
# Every AppImage format mounts the AppImage and runs its real binary; every rule below was found on
# hardware (DuckStation, MANGMI Pocket Max, 2026-10-03) and each one cost a crash:
#
#   - Never exec the AppImage or its AppRun. The runtime starts AppRun, a symlink to the binary; Qt
#     takes applicationDirPath from that path, misses usr/bin/qt.conf, finds no platform plugin and
#     aborts. Desktops hide this with a system Qt; RetroForge has none.
#   - OGUI stops a game with Reaper.reap(): every PID in the tree, leaves inward, gets
#     `kill -TERM -- -PID` and then `kill -TERM PID`, each a separate command. The emulator runs in
#     its own session, so it leads its own process group: its two signals arrive back to back and
#     coalesce into one, as when OGUI launches it directly. Inside our group it got a second, later
#     SIGTERM through `-<our pid>`, which DuckStation takes as "Ctrl+C again: force quit" and
#     abort()s — a core dump and a 14 s exit.
#   - We never forward a signal to the emulator, for the same reason: it already has OGUI's. We
#     only survive ours (TERM, INT, HUP) and wait for it. The one exception is opt-in per
#     definition: "exit_resend": N sends ONE more SIGTERM when the emulator is still running N s
#     after a stop signal reached us, and SIGKILL to the emulator alone N s after that. It is for
#     an emulator that SIGTERM does not end: OGUI's second Exit would SIGKILL the whole tree, us
#     included, leaving a dead mount. (melonDS and Azahar used it first; their real cause was SDL
#     catching SIGTERM, fixed with SDL_NO_SIGNAL_HANDLERS in their definitions.) Killing only the emulator, we still release the mount.
#   - The mount runtime is in the tree too. It starts with SIGTERM ignored, or OGUI's Exit pulls the
#     files out from under an emulator that is still shutting down. After the emulator exits it is
#     released with SIGHUP (the runtime holds the mount busy until it exits) and fusermount3 -u.
#   - Exit pressed twice is SIGKILL for everything, which leaves a dead mount: sweep ours first.
#
# GPU priority: on the A7xx boards (SM8550, SM8650) every emulator (game or --gui) starts with
# RETROFORGE_GAME_LOWPRIO=1, which turns on the implicit Vulkan layer VK_LAYER_RETROFORGE_game_priority
# (packages/retroforge-gpu-priority): its queues run at LOW global priority, so OGUI's overlay,
# Xwayland and mangoapp -- which never get the variable -- preempt it instead of waiting behind its
# frames; and TU_AUTOTUNE_FLAGS=preempt_optimize,adapt: smaller tiles reach a preemption point sooner
# (adapt again, since the variable replaces drirc's tu_autotune_flags).
# Neither on the single-ring A650/A610 (SM8250, SM6115) nor an unknown board: they do not preempt,
# so the layer would only be one more thing in the process; there kernel/patches/0270 keeps the UI
# ahead. The SoC class comes from device-env (the session does not export it). A definition's "env"
# overrides both, e.g. {"DISABLE_RETROFORGE_GAME_LOWPRIO": "1"} for an emulator that misbehaves.
#
# VRAM report limit, as Valve sets it for the Steam Frame's games: every emulator starts with mesa's
# vram-report-limit layer (implicit, gated on ENABLE_MESA_VRAM_REPORT_LIMIT; packages/mesa) reporting
# a 4096 MiB heap, which engines that size their budgets from VRAM plan around, while Turnip's own
# heap is 15/16 of RAM (drirc.d/01-retroforge-turnip.conf). The layer applies to ONE exact
# vendorID:deviceID: device-env's RETROFORGE_GPU_CHIP_ID, derived from the GPU node's compatible
# string. No Adreno node, no limit: the layer stays off. Nor when 15/16 of RAM is not above
# 4096 MiB: the layer does not clamp, it REPORTS 4096 MiB and scales the budget up to match, so on a
# small board an emulator would plan around memory the device does not have. Turnip's real heap is
# already the smaller one there. The shell's own report (retroforge-session) is never passed on:
# the layer's variables are dropped from what we inherit. A definition's "env" overrides it.
#
# OOM victim: every emulator process (game, --gui, install, setup, the PSN installer) starts with
# oom_score_adj 900, the value Steam's launch wrapper gives a Steam game, and its children inherit
# it. Neither the kernel's OOM killer nor earlyoom counts GPU memory (msm buffers are outside RSS),
# and the session scope runs at 0: on the Air X (2026-10-24) an emulator would have scored below
# OGUI, and pipewire-pulse and wireplumber (200, systemd's user@ default) above both. Raising a
# child needs no privilege. The launcher stays at 0 so it is still there to release the mount.
#
# core_dumps false: the emulator starts with RLIMIT_CORE 0, so systemd-coredump logs a crash in the
# journal but stores no core. For an emulator known to crash on a normal exit (Snes9x 1.63 did, from
# inside its SIGTERM handler): ~14 MB per Exit otherwise.
#
# Exit status: the emulator's (128 + N when signal N ended it), or 2 for a bad invocation or
# definition, 3 when the emulator is not installed or does not start (its AppImage does not mount),
# or a one-time install cannot run or fails. OGUI runs games through its reaper and never sees this
# status, so an exit 3 is also written to $RETROFORGE_LAUNCH_STATUS (`not-installed <emulator>`,
# `mount-failed <emulator>`, `missing-file <emulator> <path under $HOME>`, `install-failed
# <emulator>`, `bad-stub <emulator>` or `psn-installing <emulator>`), cleared at every start: the
# RetroForge plugin's EXIT hook reads it and tells the player what to do.

import os
import re
import signal
import subprocess
import sys
import time

# Our modules (launch_*, psn_inbox, emuopts) ship beside us: /usr/lib/retroforge/python in the
# image, the same place under rootfs/overlay when the offline tests run this file from the repo (no
# bytecode: /usr is read-only on the device, and in the repo it would land inside rootfs/overlay).
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "retroforge", "python"))
import achievements  # noqa: E402
import emuopts  # noqa: E402
from launch_common import (CONFIG_HOME, EMU_DATA_DIR, EMU_DIR, ENV, HOME, VRAM_REPORT_LIMIT_VARS,  # noqa: E402
                           Exit, device_field, emulator_child, log)
from launch_def import (FILE, ROM, SYSTEM, SYSTEM_ID, TEXT, apply_system_settings,  # noqa: E402
                        emulator_for, load_definition, missing_requirement, seed_first_run, sync_files,
                        systems_of)
from launch_formats import FORMATS  # noqa: E402
from psn_inbox import PSN_SYSTEM, psn_install, try_psn_lock  # noqa: E402

CPU_ROOT = ENV.get("RETROFORGE_CPU_ROOT", "/sys/devices/system/cpu")
PLAYER_CONF_DIR = ENV.get("RETROFORGE_PLAYER_CONF_DIR", os.path.join(CONFIG_HOME, "retroforge", "emulators"))
GAME_CONF_DIR = ENV.get("RETROFORGE_GAME_CONF_DIR", os.path.join(CONFIG_HOME, "retroforge", "games"))
STATE_DIR = ENV.get("RETROFORGE_STATE_DIR",
                    os.path.join(ENV.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "retroforge"))
STATUS = ENV.get("RETROFORGE_LAUNCH_STATUS",
                 os.path.join(ENV.get("XDG_RUNTIME_DIR") or "/tmp", "retroforge-launch.status"))
PREEMPTING_SOCS = {"SM8550", "SM8650"}  # A7xx: four preemptible GPU rings
MEMINFO = ENV.get("RETROFORGE_MEMINFO", "/proc/meminfo")
VRAM_REPORT_LIMIT_MIB = 4096
TURNIP_HEAP_SHARE = 15 / 16  # heap_memory_percent in drirc.d/01-retroforge-turnip.conf
INSTALL_SETTLE = 1.0  # s to wait after an install step for OGUI's Exit to reach us too (below)

USAGE = "usage: retroforge-launch <system> <rom> | --gui <emulator> | --psn-install"
EMU_ID = re.compile(r"[a-z0-9_-]+")
# Where OpenGamepadUI (its patch 0024) reads the running game's gamepad profile (gamepad_profile,
# below): the profile's path, then the pid owning the declaration. Same env knob for the tests.
GAME_PROFILE_DECL = ENV.get("RETROFORGE_GAME_PROFILE",
                            os.path.join(ENV.get("XDG_RUNTIME_DIR") or "/tmp", "opengamepadui", "game_profile"))
SCRIPT_SHELL = "/bin/bash"  # what a scripts-format game card's script runs with
# A stub's game id: strictly ASCII letters, digits and underscore (PSN title ids are [A-Z]{4}[0-9]{5}),
# so an id can never carry a path (/, ..), an option (-x) or control characters into the command line.
STUB_ID = re.compile(r"[A-Za-z0-9_]{1,64}")


# ---------------------------------------------------------------------------------- invocation --

def parse_args(argv):
    """-> (system or None, rom or None, emulator or None)."""
    if len(argv) != 2:
        raise Exit(2, USAGE)
    if argv[0] == "--gui":
        if not EMU_ID.fullmatch(argv[1]):
            raise Exit(2, f"bad emulator name '{argv[1]}'")
        return None, None, argv[1]
    system, rom = argv
    if not SYSTEM_ID.fullmatch(system):
        raise Exit(2, f"bad system name '{system}'")
    if not (os.path.isfile(rom) or os.path.isdir(rom)):  # a folder: a PS3 disc dump
        raise Exit(2, f"no such ROM: {rom}")
    return system, rom, None



def gpu_priority_env():
    """The emulator's GPU priority environment (header: GPU priority)."""
    if device_field("RETROFORGE_SOC_CLASS") not in PREEMPTING_SOCS:
        return {}
    return {"RETROFORGE_GAME_LOWPRIO": "1", "TU_AUTOTUNE_FLAGS": "preempt_optimize,adapt"}


def turnip_heap_mib():
    """Turnip's own heap in MiB (15/16 of MemTotal); None when /proc/meminfo cannot say."""
    try:
        with open(MEMINFO) as f:
            m = re.search(r"^MemTotal:\s+(\d+) kB$", f.read(), re.M)
    except OSError:
        return None
    return int(m.group(1)) / 1024 * TURNIP_HEAP_SHARE if m else None


def vram_limit_env():
    """The emulator's VRAM report limit environment (header: VRAM report limit)."""
    heap = turnip_heap_mib()
    if heap is None or heap <= VRAM_REPORT_LIMIT_MIB:
        return {}
    device_id = device_field("RETROFORGE_GPU_CHIP_ID")
    if not device_id:
        return {}
    return {"ENABLE_MESA_VRAM_REPORT_LIMIT": "1", "VK_VRAM_REPORT_LIMIT_HEAP_SIZE": str(VRAM_REPORT_LIMIT_MIB),
            "VK_VRAM_REPORT_LIMIT_DEVICE_ID": device_id}


# -------------------------------------------------------------------------------------- CPUs --

def read_text(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def fast_cpus():
    """Online CPUs above the smallest online capacity, as a taskset list; "" when there are none."""
    online = read_text(os.path.join(CPU_ROOT, "online"))
    if not online:
        return ""
    cpus = []
    for part in online.split(","):
        lo, _, hi = part.partition("-")
        if lo.isdigit() and (hi == "" or hi.isdigit()):
            cpus.extend(range(int(lo), int(hi or lo) + 1))
    caps = {}
    for c in cpus:
        cap = read_text(os.path.join(CPU_ROOT, f"cpu{c}", "cpu_capacity"))
        if cap and cap.isdigit():
            caps[c] = int(cap)
    if not caps:
        return ""
    low = min(caps.values())
    return ",".join(str(c) for c in sorted(caps) if caps[c] > low)


# ---------------------------------------------------------------------------------------- run --

def fail(reason, emulator, msg, detail=None):
    """An exit-3 failure the plugin reports to the player."""
    try:
        with open(STATUS, "w") as f:
            f.write(f"{reason} {emulator}{' ' + detail if detail else ''}\n")
    except OSError:
        pass
    raise Exit(3, msg)


def stub_boot_target(emulator, rom, stub):
    """A stub ROM's boot target (definition "stub", header): the stub's extension names a template,
    and the file's first line replaces "{text}" in it. Any other ROM is its own target. Only the
    emulator's command line gets the result: the stub path stays the game's identity (card name,
    per-game conf)."""
    template = stub.get(os.path.splitext(rom)[1][1:].lower()) if os.path.isfile(rom) else None
    if template is None:
        return rom
    try:
        # Strict UTF-8: a binary file (a stray .pkg, say) must be bad-stub, never mojibake RPCS3
        # is then started with. readline's cap bounds the read; a line past it fails STUB_ID.
        with open(rom, encoding="utf-8") as f:
            game_id = f.readline(128).strip()
    except (OSError, UnicodeDecodeError) as err:
        fail("bad-stub", emulator, f"cannot read the stub {rom}: {err}")
    if not STUB_ID.fullmatch(game_id):
        fail("bad-stub", emulator, f"{rom} must hold one game id on its first line")
    return template.replace(TEXT, game_id)


def missing_installs(emulator, install, is_game):
    """The install steps still to run; a game launch whose provided file is absent fails here."""
    todo = []
    for step in install:
        if os.path.exists(os.path.join(HOME, step["unless"])):
            continue
        if not os.path.isfile(os.path.join(HOME, step["from"])):
            if is_game:
                fail("missing-file", emulator, f"{emulator} needs ~/{step['from']} (not found)",
                     step["from"])
            log(f"{emulator}: ~/{step['from']} not found, skipping its install")
            continue
        todo.append(step)
    return todo


def run_installs(emulator, binary, env, todo, interrupted):
    for step in todo:
        src = os.path.join(HOME, step["from"])
        args = [src if a == FILE else a for a in step["args"]]
        log(f"{emulator}: installing ~/{step['from']}: {binary} {' '.join(args)}")
        try:
            # No core file: a one-time helper run, and RPCS3's installer aborts in a destructor
            # after a successful install; dumping its address space held the launch ~1 min
            # (HW 2026-10-07, Pocket FIT).
            rc = subprocess.run([binary] + args, env=env, start_new_session=True,
                                preexec_fn=emulator_child()).returncode
        except (OSError, ValueError) as err:
            fail("install-failed", emulator, f"could not run {binary}: {err}")
        # OGUI's Exit reached the install (and us): the player left. Never start the game after
        # that, and leave no status: there is nothing to tell them. reap() signals leaves first, so
        # an install that ends on SIGTERM returns BEFORE our own signal arrives: give it a moment
        # (once per emulator, ever). How the installer itself ended says nothing about that: it
        # may crash on its way out after a good install, so only our own signals mean "Exit".
        deadline = time.monotonic() + INSTALL_SETTLE
        while not interrupted and time.monotonic() < deadline:
            time.sleep(0.05)
        if interrupted:
            raise Exit(128 + interrupted[0],
                       f"{emulator}: install of ~/{step['from']} interrupted; not starting the game")
        if not os.path.exists(os.path.join(HOME, step["unless"])):
            fail("install-failed", emulator,
                 f"installing ~/{step['from']} failed (exit {rc}, no ~/{step['unless']})")
        if rc != 0:
            log(f"{emulator}: the install of ~/{step['from']} ended with {rc}, but "
                f"~/{step['unless']} is there: installed")


# ------------------------------------------------------------ gamepad profile (gamepad_profile) --
# The definition's InputPlumber device profile (the Guide-modifier hotkey layer) is DECLARED to
# OpenGamepadUI, which owns every profile load: its focus profile while it has focus, this one
# while the game has, so the two never race over a device. The declaration names our pid, and a
# launcher that dies leaves one OpenGamepadUI ignores. ALL OF IT IS BEST-EFFORT: a declaration
# that cannot be written means a game without hotkeys and one log line, never no game.

def declare_gamepad_profile(emulator, name):
    """Declare the definition's profile for this run. True when declared (withdraw it on exit)."""
    if name is None:
        return False
    profile = os.path.join(EMU_DATA_DIR, emulator, name)
    if not os.path.isfile(profile):
        log(f"gamepad profile: {profile} is not in the image; no hotkeys")
        return False
    try:
        os.makedirs(os.path.dirname(GAME_PROFILE_DECL), exist_ok=True)
        partial = GAME_PROFILE_DECL + ".partial"
        with open(partial, "w") as f:
            f.write(f"{profile}\n{os.getpid()}\n")
        os.replace(partial, GAME_PROFILE_DECL)
    except OSError as err:
        log(f"gamepad profile: could not declare {profile}: {err}; no hotkeys")
        return False
    log(f"gamepad profile {name}: declared to OpenGamepadUI")
    return True


def withdraw_gamepad_profile(declared):
    """Remove our declaration, unless another launcher's has replaced it since."""
    if not declared:
        return
    try:
        with open(GAME_PROFILE_DECL) as f:
            owner = f.read().split("\n")[1:2]
        if owner == [str(os.getpid())]:
            os.remove(GAME_PROFILE_DECL)
    except FileNotFoundError:
        pass
    except OSError as err:
        log(f"gamepad profile: could not withdraw the declaration: {err}")


def cpus_for(emulator_conf, game_conf):
    """The run's CPUS: the game's, else the emulator's, else all. A value that is neither big nor all
    is reported and skipped."""
    for name, conf in (("game", game_conf), ("emulator", emulator_conf)):
        if conf.get("CPUS", "big") not in emuopts.CPUS_VALUES:
            log(f"{name} conf: ignoring CPUS={conf['CPUS']} (want big or all)")
    return emuopts.cpus_choice(emulator_conf, game_conf)


def pinning(emulator, cpus):
    """`taskset -c <fast cpus>` when this run goes on the fast cores (cpus "big"), else []."""
    if cpus != "big":
        return []
    fast = fast_cpus()
    if not fast:
        log("no fast core online (core-count limit, or one core type): not pinning")
        return []
    log(f"pinning {emulator} to fast cores {fast}")
    return ["taskset", "-c", fast]


def player_confs(emulator, system, rom):
    """(the emulator's conf, the game's conf) as {key: value}; the game's is {} for --gui."""
    game = emuopts.read_conf(emuopts.game_conf_path(GAME_CONF_DIR, system, rom)) if rom is not None else {}
    return emuopts.read_conf(os.path.join(PLAYER_CONF_DIR, f"{emulator}.conf")), game


def load_options(emulator, definition):
    try:
        options = emuopts.load_options(EMU_DATA_DIR, emulator)
    except emuopts.OptionsError as err:
        raise Exit(2, str(err)) from None
    if options is not None and definition["format"] == "scripts":
        raise Exit(2, f"{emulator}: options.json is for emulators, not the scripts format")
    return options


def log_warning(msg):
    log(f"warning: {msg}")


def options_warning(emulator):
    return lambda msg: log(f"warning: {emulator}: {msg}")


def apply_options(emulator, options, confs, system):
    """Restore a journal a killed run left, then apply this run's choices: -> (args, env).
    `system` is None for --gui."""
    emuopts.restore(HOME, STATE_DIR, emulator, options_warning(emulator))
    if options is None:
        return [], {}
    return emuopts.apply(options, HOME, STATE_DIR, emulator, *confs, options_warning(emulator),
                         systems=systems_of(emulator), system=system)


def run(argv):
    if argv == ["--psn-install"]:
        return psn_install()
    system, rom, emulator = parse_args(argv)
    if emulator is None:
        emulator = emulator_for(system)
    definition = load_definition(emulator)
    if definition["root"] is not None:  # the scripts format: the unpacked folder itself
        image = os.path.join(HOME, definition["root"])
        installed = os.path.join(image, definition["binary"])
    else:
        image = installed = os.path.join(EMU_DIR, emulator, "current")
    if not os.access(installed, os.X_OK):
        fail("not-installed", emulator, f"{emulator} is not installed ({installed} missing or not executable)")
    # One RPCS3 at a time (header): a ps3 launch takes the installer's lock and HOLDS it until the
    # game exits, so --psn-install mid-game is refused and a launch mid-install fails readably
    # instead of two RPCS3s sharing dev_hdd0 and running the 8 GiB ACE out of memory. Do not drop
    # the psn_lock reference: the variable IS the lock's lifetime (plus the game's own, below).
    psn_lock = None
    if system == PSN_SYSTEM:
        try:
            psn_lock = try_psn_lock()
        except OSError as err:
            # A broken lock path must not brick every ps3 launch: the guard is best-effort here.
            log(f"cannot take the PSN lock ({err}): launching unguarded")
        else:
            if psn_lock is None:
                fail("psn-installing", emulator,
                     "a PSN install is running; launch again when it finishes")
    if rom is not None:  # a core or BIOS the system needs (launch_def: system_requires)
        req = missing_requirement(definition["system_requires"].get(system, []))
        if req is not None:
            status = req.get("status", "missing-file")
            fail(status, emulator, f"{system} needs ~/{' or ~/'.join(req['any'])} (not found)",
                 " ".join(req["any"]) if status == "missing-file" else None)
    # One emulator can serve several systems (ClownMDEmu: md, segacd; armGBA: gb, gbc, gba) with
    # per-system folders, on its command line or in its settings file.
    # A stub ROM boots what its first line names (after the not-installed check: that message wins).
    boot = stub_boot_target(emulator, rom, definition["stub"]) if rom is not None else None
    args = ([boot if a == ROM else a.replace(SYSTEM, system)
             for a in definition["system_args"].get(system, []) + definition["args"]]
            if rom is not None else definition["gui_args"])
    seed_first_run(emulator, definition["seed"])
    sync_files(emulator, definition["sync"])
    achievements.apply(emulator, definition["achievements"], HOME, log_warning)
    if rom is not None:
        apply_system_settings(emulator, definition["system_settings"], system)
    todo = missing_installs(emulator, definition["install"], rom is not None)
    options = load_options(emulator, definition)
    confs = player_confs(emulator, system, rom)
    pin = pinning(emulator, cpus_for(*confs))

    # From here on, survive our own signals (OGUI's Exit reaches us too) and wait: never forward
    # them. Caught signals go back to default in the emulator at exec.
    interrupted = []  # signals seen: only the one-time install step acts on them
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda signum, _: interrupted.append(signum))
    package = FORMATS[definition["format"]](emulator, image)
    profile_declared = False
    try:
        # Before the mount: the restore in `finally` must cover every way out from here on.
        opt_args, opt_env = apply_options(emulator, options, confs, system)
        args = opt_args + args
        try:
            root = package.prepare()
        except Exit as err:
            fail("mount-failed", emulator, str(err))
        binary = os.path.join(root, definition["binary"])
        inherited = {k: v for k, v in ENV.items() if k not in VRAM_REPORT_LIMIT_VARS}
        env = {**inherited, **gpu_priority_env(), **vram_limit_env(), **package.env(), **definition["env"],
               **opt_env}
        run_installs(emulator, binary, env, todo, interrupted)
        # Last before the start: nothing below but the start itself can fail, so no declaration
        # outlives a launch that said no.
        profile_declared = declare_gamepad_profile(emulator, definition["gamepad_profile"])
        program = SCRIPT_SHELL if package.runs_rom and rom is not None else binary
        log(f"{system or 'gui'} -> {emulator}: {program} {' '.join(args)}")
        try:
            # Its own session; taskset execs, so the emulator keeps this PID and leads it. A ps3
            # game inherits the PSN lock's fd: flock follows the open file description, so the
            # lock outlives even a SIGKILLed launcher for as long as the game runs.
            emu = subprocess.Popen(pin + [program] + args, env=env, start_new_session=True,
                                   pass_fds=() if psn_lock is None else (psn_lock.fileno(),),
                                   preexec_fn=emulator_child(definition["core_dumps"]))
        except (OSError, ValueError) as err:
            fail("mount-failed", emulator, f"could not start {binary}: {err}")
        rc = wait_emulator(emu, definition["exit_resend"], interrupted)
        return 128 - rc if rc < 0 else rc
    finally:
        withdraw_gamepad_profile(profile_declared)
        package.release()
        emuopts.restore(HOME, STATE_DIR, emulator, options_warning(emulator))


def wait_emulator(emu, resend_after, interrupted):
    """The emulator's exit status. With exit_resend: once a stop signal reached us (OGUI's Exit
    signals the whole tree) and the emulator still runs resend_after seconds later, it gets ONE
    more SIGTERM, and SIGKILL resend_after seconds after that; we stay to release the mount."""
    if not resend_after:
        return emu.wait()
    seen, since, escalation = len(interrupted), None, [(signal.SIGTERM, "one more SIGTERM"),
                                                       (signal.SIGKILL, "SIGKILL")]
    while True:
        try:
            return emu.wait(timeout=0.1)
        except subprocess.TimeoutExpired:
            pass
        if since is None:
            if len(interrupted) > seen:
                since = time.monotonic()
        elif escalation and time.monotonic() - since >= resend_after:
            sig, what = escalation.pop(0)
            log(f"the emulator still runs {resend_after} s after the stop: {what} (exit_resend)")
            try:
                emu.send_signal(sig)
            except ProcessLookupError:
                pass
            since = time.monotonic()


def main():
    try:
        os.unlink(STATUS)
    except OSError:
        pass
    try:
        return run(sys.argv[1:])
    except Exit as err:
        log(str(err))
        return err.code
    except Exception as err:  # a bug here must still end with a message, not a silent hang
        log(f"internal error: {type(err).__name__}: {err}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
