# upterm — share a terminal session over SSH through a relay (uptermd.upterm.dev by default).
#
# WHY IT IS HERE: in PKGS (rootfs/customize-base.sh), so on every image. A device is reachable over
# SSH only from the LAN it joined (or a USB cable on a dev card); `upterm host` lets someone remote
# attach to a shell on it through an outbound connection, with no port forward. Nothing starts it:
# it runs only when someone on the device types it. Chosen over tmate, whose tmate.io relay has been
# down since 2025.
#
# WHY LOCAL AND NOT FETCHED: upterm is in neither holo nor the upstream aarch64 base (it is AUR-only
# on Arch). Built from the release tarball with upstream's own .goreleaser.yml flags.
#
# Static (CGO_ENABLED=0), as upstream ships it: no runtime deps. Only the client (cmd/upterm); the
# relay server (cmd/uptermd) has no business on a handheld.
#
# GO TOOLCHAIN. go.mod at this tag asks for go 1.26.9; the snapshot ships go 1.26.3 and Arch's go.env
# sets GOTOOLCHAIN=local, which would refuse the build. GOTOOLCHAIN names the exact toolchain, which
# the go command fetches from proxy.golang.org and checks against sum.golang.org, the same trust path
# as every module this build downloads (go.sum pins those). Same as packages/tailscale.
#
# VERSION STAMP. upterm compares host and server versions and Current() panics on one it cannot
# parse, so the ldflags give the real release version, not a source build's "(devel)".
#
# To bump: pkgver + sha256sums (measure it), _commit/_date from the tag (`git ls-remote
# https://github.com/owenthereal/upterm.git 'refs/tags/v<ver>^{}'`, then that commit's committer
# date), _gotoolchain to go.mod's `go` line, then `make mirror-lock`.

pkgname=upterm
pkgver=0.41.1
_commit=58bbe0ad1ce687910a476a8dc98cecb57996e192
_date=2026-11-05T18:39:29Z
_gotoolchain=go1.26.9
pkgrel=1
pkgdesc='Instant terminal sharing over SSH'
arch=('aarch64')
url='https://github.com/owenthereal/upterm'
license=('Apache-2.0')
depends=()
makedepends=('go')
options=('!lto' '!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('f5d5cc664b2859e67cb6437206daebee28b14b4a22be8fa3991e9a8c809b291d')

prepare() {
  cd "${pkgname}-${pkgver}"
  export GOTOOLCHAIN="${_gotoolchain}" GOPATH="${srcdir}/gopath" GOFLAGS='-modcacherw'
  # The one step that needs the network (toolchain + modules); build() then runs offline.
  go mod download
}

build() {
  cd "${pkgname}-${pkgver}"
  export GOTOOLCHAIN="${_gotoolchain}" GOPATH="${srcdir}/gopath" GOFLAGS='-modcacherw -mod=readonly' \
         GOPROXY=off CGO_ENABLED=0
  local v=github.com/owenthereal/upterm/internal/version
  go build -trimpath \
    -ldflags "-s -w -X ${v}.Version=${pkgver} -X ${v}.GitCommit=${_commit} -X ${v}.Date=${_date}" \
    -o build/upterm ./cmd/upterm
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 build/upterm "${pkgdir}/usr/bin/upterm"
  install -Dm644 etc/man/man1/*.1 -t "${pkgdir}/usr/share/man/man1"
  install -Dm644 etc/completion/upterm.bash_completion.sh "${pkgdir}/usr/share/bash-completion/completions/upterm"
  install -Dm644 etc/completion/upterm.zsh_completion "${pkgdir}/usr/share/zsh/site-functions/_upterm"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
