# gtk2 — built FROM SOURCE via a retroforge-owned PKGBUILD (packages/gtk2/PKGBUILD).
# The deckard snapshot carried Arch's gtk2 2.24.33-5 through mash-20260528.1.pvt; mash-20260704.1.pvt
# dropped it from core/extra and from sources/ (#55). What is left is gtk2-compat, an 8 KB openSUSE
# shim that conflicts with gtk2 and ships no libgtk-x11-2.0, so it is no substitute.
#
# Why: /usr/bin/steam runs the Steam client raw on the host, and steamui.so links libgtk-x11-2.0 and
# libgdk-x11-2.0 (rootfs/customize-base.sh PKGS). Without them the client's installer and its
# updater cannot start.
#
# Recipe: Arch's 2.24.33-5 (mash-20260528.1.pvt sources/packages/gtk2-2.24.33-5.src.tar.gz) with its
# two patches under patches/, from GNOME's release tarball instead of the git tag. See the PKGBUILD.
#
# Fields (see packages/README.md):
#   name           pkgname (must match the PKGBUILD); also the work/ build-dir + repo entry
#   pkgbuild_local path (relative to this dir) to the checked-in PKGBUILD to build
#   patches        Arch's, applied -p1 in the source root by build-overlay.sh
#   pkgrel_suffix  numeric suffix appended to the PKGBUILD's pkgrel so pacman prefers our build
name: gtk2
pkgbuild_local: PKGBUILD
patches: 0001-Lower-severity-of-XID-collision-warnings.patch 0002-Stop-looking-for-modules-in-cwd.patch
pkgrel_suffix: 1
