 # Called when the node enters the scene tree for the first time.
 func _ready() -> void:
+	add_to_group(GROUP)
 	state_machine.state_changed.connect(_on_state_changed)
 
 	# Create a timer to update the time
@@ -29,6 +35,14 @@ func _on_state_changed(from: State, to: State):
 	logger.debug(state_stack)
 
 
+## Shows "Previous" with L1's icon and "Next" with R1's: on a game's page, each while there is a
+## game that way. Their boxes are shown and hidden, as an InputIcon shows itself when the kind of
+## input changes.
+func show_game_steps(previous: bool, next: bool) -> void:
+	previous_game.visible = previous
+	next_game.visible = next
+
+
 # Updates the current time on timer timeout
 func _on_update_time():
