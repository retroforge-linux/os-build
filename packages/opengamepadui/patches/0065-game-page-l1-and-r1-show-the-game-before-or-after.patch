diff --git a/core/ui/card_ui/launch/game_beside.gd b/core/ui/card_ui/launch/game_beside.gd
new file mode 100644
index 0000000..ffd06aa
--- /dev/null
+++ b/core/ui/card_ui/launch/game_beside.gd
@@ -0,0 +1,32 @@
+extends RefCounted
+
+## Which game a game's page shows next when L1 or R1 is pressed on it: the one before or after it
+## in the row or grid the page was opened from. `nodes` are that row's or grid's children.
+
+
+## Whether `node` is a game's card that can be stepped to: one that is shown (a search hides the
+## cards it filters out) and not being removed. Home's Library card and the spacers are not.
+static func is_card(node: Variant) -> bool:
+	return is_instance_valid(node) and node is Control and node.visible \
+		and not node.is_queued_for_deletion() and node.get("library_item") != null
+
+
+## The card of the game `item` among `nodes`, or null when it has none there.
+static func card_of(nodes: Array, item: Object) -> Control:
+	if item == null:
+		return null
+	for node in nodes:
+		if is_card(node) and node.get("library_item") == item:
+			return node
+	return null
+
+
+## The card `step` games after `item`'s (before it when negative), in the order the cards are laid
+## out: in a grid the end of one row is followed by the start of the next. Null past either end, and
+## when `item` has no card among `nodes`.
+static func beside(nodes: Array, item: Object, step: int) -> Control:
+	var cards := nodes.filter(is_card)
+	var at := cards.find(card_of(cards, item))
+	if at < 0 or at + step < 0 or at + step >= cards.size():
+		return null
+	return cards[at + step]
