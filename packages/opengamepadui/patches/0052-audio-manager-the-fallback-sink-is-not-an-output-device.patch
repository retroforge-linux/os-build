From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Sat, 14 Nov 2026 12:00:00 +0000
Subject: [PATCH] fix(AudioManager): the fallback sink is not an output device

RetroForge keeps a silent sink, retroforge-fallback, owned by the
PipeWire daemon, so a default sink still exists while WirePlumber
restarts and Godot's PulseAudio driver keeps its audio thread. It was an
Audio/Duplex node to stay out of the output list, but that made it the
default source on a board without a mic, and SDL3 then played into it
(RetroForge #45). It is an Audio/Sink now.

The output list takes every Audio/Sink wpctl shows, so it would offer
"Fallback" as a device to pick. get_output_devices() and
set_output_device() now skip the node of that name.

---
 core/global/audio_manager.gd | 9 +++++++++
 1 file changed, 9 insertions(+)

--- a/core/global/audio_manager.gd
+++ b/core/global/audio_manager.gd
@@ -6,6 +6,9 @@
 ## The AudioManager is responsible for managing the system volume and audio
 ## devices if the host supports it.
 
+## The system's silent fallback sink (RetroForge), kept while WirePlumber restarts; not a device to pick.
+const FALLBACK_SINK := "retroforge-fallback"
+
 signal volume_changed(value: float)
 ## Emitted when the system volume has been read, e.g. once WirePlumber has a default sink at startup.
 ## Unlike volume_changed it does not show the volume indicator; views use it to show the real level.
@@ -147,6 +150,9 @@
 				node_name = line.split('"', false)[-1]
 			if line.contains("media.class") and line.contains("Audio/Sink"):
 				is_output = true
+			if line.contains("node.name") and line.contains('"%s"' % FALLBACK_SINK):
+				is_output = false
+				break
 		if is_output and node_name != "":
 			devices.append(node_name)
 			ids.append(id)
@@ -214,6 +220,9 @@
 				node_name = line.split('"', false)[-1]
 			if line.contains("media.class") and line.contains("Audio/Sink"):
 				is_output = true
+			if line.contains("node.name") and line.contains('"%s"' % FALLBACK_SINK):
+				is_output = false
+				break
 		if is_output and node_name != "":
 			devices.append(node_name)
 
