-## Populates the mount grid with an item for every mount point on this PartitionDevice
+## Populates the mount grid with this PartitionDevice's main mount point, and sets its size:
+## the filesystem's free space of its size while it is mounted. udisks2 also lists
+## every bind mount of the filesystem: the /home partition is bound at /opt, /root, /srv,
+## /var/cache/pacman, /var/log, ... and an SD card at /run/retroforge/sdcard (the network share).
 func _populate_mounts() -> void:
 	_clear_mounts()
+	size_label.text = partition_device.get_readable_size()
