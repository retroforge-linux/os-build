+func _on_devices_updated(_devices: Array[BlockDevice]) -> void:
 	if is_visible_in_tree():
-		_on_drives_updated(devices)
+		_on_drives_updated()
 	else:
 		_stale = true
 
 
 func _refresh() -> void:
-	if not _stale or not is_visible_in_tree():
+	if not is_visible_in_tree():
+		# What the menu shows also follows the mount table, which changes with no udisks2
+		# signal (an SD card is mounted after udisks2 reports it): read it again at each show.
+		_stale = true
+		_mounts_timer.stop()
+		return
+	_mounts_timer.start()
+	if not _stale:
 		return
-	_on_drives_updated(udisks2.get_unprotected_devices())
+	_on_drives_updated()
+
+
+func _on_mounts_poll() -> void:
+	if ShownDisks.partitions(ShownDisks.read_file("/proc/self/mounts")) != _shown:
+		_on_drives_updated()
 
 
-func _on_drives_updated(devices: Array[BlockDevice]) -> void:
+## Builds a card for each disk ShownDisks names, with only the partitions it names: /home's,
+## and an internal install's SD card. udisks2's unprotected devices are not used: they leave out
+## the disk holding /home, the very one to show, list every other disk once per partition with
+## no filesystem, and are read over D-Bus partition by partition.
+func _on_drives_updated() -> void:
 	_stale = false
 	logger.debug("Got updated drives")
 
@@ -52,28 +81,25 @@
 		container.remove_child(child)
 		child.queue_free()
 
-	# Show a label if no drives are available
-	if devices.size() == 0:
-		no_drive_label.visible = true
-		container.visible = false
-		return
-
-	no_drive_label.visible = false
-	container.visible = true
-
 	# Poplulate drives
 	var last_focus: FocusGroup
-	for drive in devices:
-		var drive_type = drive.dbus_path.trim_prefix(steam_disks.BLOCK_PREFIX)
-
-		# Ignore loop devices
-		if drive_type.contains("loop"):
+	var shown := ShownDisks.partitions(ShownDisks.read_file("/proc/self/mounts"))
+	_shown = shown
+	if shown.is_empty():
+		logger.warn("No partition mounted at /home")
+	for disk: String in shown:
+		var drive := _block_device(disk)
+		if not drive:
+			logger.warn("udisks2 does not know /dev/" + disk)
 			continue
+		var partitions := PackedStringArray()
+		for partition: String in shown[disk]:
+			partitions.append(steam_disks.BLOCK_PREFIX + "/" + partition)
 
 		# Create Drive Card
 		var drive_card := drive_card_scene.instantiate() as DriveCard
 		container.add_child(drive_card)
-		drive_card.setup(drive)
+		drive_card.setup(drive, partitions)
 		drive_card.visible = true
 
 		# Set up focus
@@ -82,3 +108,16 @@
 			last_focus.focus_neighbor_bottom = drive_focus
 			drive_focus.focus_neighbor_top = last_focus
 		last_focus = drive_focus
+
+	# Show a label if no drives are available
+	no_drive_label.visible = last_focus == null
+	container.visible = last_focus != null
+
+
+## The udisks2 BlockDevice for a disk, from the resource cache: the extension keeps one there
+## for every block device it tracks, and offers no other way to look one up by name.
+func _block_device(disk: String) -> BlockDevice:
+	var path := UDISKS2_RES_PREFIX + steam_disks.BLOCK_PREFIX + "/" + disk
+	if not ResourceLoader.exists(path):
+		return null
+	return load(path) as BlockDevice
