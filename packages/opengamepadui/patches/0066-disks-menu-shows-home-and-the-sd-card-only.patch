diff --git a/core/systems/disks/shown_disks.gd b/core/systems/disks/shown_disks.gd
new file mode 100644
--- /dev/null
+++ b/core/systems/disks/shown_disks.gd
@@ -0,0 +1,135 @@
+extends RefCounted
+
+## Which disks and partitions the Disks settings menu shows: the partition mounted at /home on its
+## disk, and, when /home is not on an SD card (an internal install), the SD card's mounted
+## partitions. The rest of a handheld's internal storage is the vendor's (super, vbmeta, xbl, ...:
+## ~85 partitions), nothing a player manages there. Read from the mount table and sysfs; `sys` and
+## `dev` stand for /sys and /dev. And what a partition card says of its partition: its main mount
+## point and the space left on it.
+
+
+## The partitions to show, by disk, as kernel names ({"sda": ["sda17"]}), the disk holding /home
+## first. `mounts` is the text of /proc/self/mounts. Empty when nothing is mounted at /home.
+static func partitions(mounts: String, sys := "/sys", dev := "/dev") -> Dictionary:
+	var shown := {}
+	var home := ""
+	var mounted: Array[String] = []
+	for line in mounts.split("\n", false):
+		var fields := line.split(" ", false)
+		if fields.size() < 2 or not fields[0].begins_with("/dev/"):
+			continue
+		var partition := kernel_name(dev + fields[0].trim_prefix("/dev"))
+		if fields[1] == "/home":
+			home = partition
+		if partition not in mounted:
+			mounted.append(partition)
+
+	var home_disk := disk_of(home, sys)
+	if home_disk.is_empty():
+		return shown
+	shown[home_disk] = [home]
+	if is_sd_card(home_disk, sys):
+		return shown
+
+	for partition in mounted:
+		var disk := disk_of(partition, sys)
+		if disk.is_empty() or disk == home_disk or not is_sd_card(disk, sys):
+			continue
+		if disk not in shown:
+			shown[disk] = []
+		(shown[disk] as Array).append(partition)
+
+	return shown
+
+
+## A partition's main mount point: the first place its whole filesystem is mounted, in the order
+## of `mountinfo` (the text of /proc/self/mountinfo). Its bind mounts come after it, or mount a
+## directory of it (/home's partition is also at /opt, /root, /var/log, ...). "" when unmounted.
+static func main_mount(mountinfo: String, partition: String, dev := "/dev") -> String:
+	for line in mountinfo.split("\n", false):
+		# 110 33 179:8 / /home rw,relatime shared:222 - ext4 /dev/mmcblk0p8 rw
+		var halves := line.split(" - ", false, 1)
+		var fields := halves[0].split(" ", false)
+		if halves.size() < 2 or fields.size() < 5 or fields[3] != "/":
+			continue
+		var source := halves[1].split(" ", false)
+		if source.size() < 2 or not source[1].begins_with("/dev/"):
+			continue
+		if kernel_name(dev + source[1].trim_prefix("/dev")) == partition:
+			# The kernel writes a space, tab, newline or backslash as \040, \011, \012, \134
+			# (an SD card labelled "MY GAMES" is at /run/media/player/MY\040GAMES).
+			return fields[4].replace("\\040", " ").replace("\\011", "\t") \
+				.replace("\\012", "\n").replace("\\134", "\\")
+	return ""
+
+
+## "24.65 GB free of 24.73 GB" for the filesystem mounted at `mount`, "" when df cannot tell.
+static func free_of_total(mount: String) -> String:
+	var output := []
+	if OS.execute("df", ["-B1", "--output=size,avail", "--", mount], output) != 0 or output.is_empty():
+		return ""
+	return space_text(output[0])
+
+
+## The text for df's `--output=size,avail` output (a header line, then the two in bytes), or "".
+static func space_text(df_output: String) -> String:
+	var lines := df_output.strip_edges().split("\n", false)
+	if lines.size() < 2:
+		return ""
+	var values := lines[-1].split(" ", false)
+	if values.size() != 2 or not values[0].is_valid_int() or not values[1].is_valid_int():
+		return ""
+	return readable_size(int(values[1])) + " free of " + readable_size(int(values[0]))
+
+
+## A size in decimal units with two decimals, as udisks2's own sizes are shown ("25.58 GB").
+static func readable_size(bytes: int) -> String:
+	const UNITS := ["B", "KB", "MB", "GB", "TB", "PB"]
+	var value := float(bytes)
+	var unit := 0
+	while value >= 1000.0 and unit < UNITS.size() - 1:
+		value /= 1000.0
+		unit += 1
+	return "%.2f %s" % [value, UNITS[unit]]
+
+
+## The kernel name of a device node (/dev/sda17 -> sda17), through a link (/dev/disk/by-*).
+static func kernel_name(device: String) -> String:
+	var dir := DirAccess.open(device.get_base_dir())
+	if dir and dir.is_link(device):
+		return dir.read_link(device).get_file()
+	return device.get_file()
+
+
+## The disk a partition is on (sda17 -> sda), or "" when it is not a partition.
+static func disk_of(partition: String, sys := "/sys") -> String:
+	if partition.is_empty():
+		return ""
+	var path := sys + "/class/block/" + partition
+	if not FileAccess.file_exists(path + "/partition"):
+		return ""
+	var dir := DirAccess.open(sys + "/class/block")
+	if not dir or not dir.is_link(path):
+		return ""
+	# ../../devices/.../block/sda/sda17
+	return dir.read_link(path).get_base_dir().get_file()
+
+
+## Whether the disk is an SD card: the MMC core types a card "SD" and an eMMC "MMC" (the internal
+## storage of the SM6115 handhelds is an mmcblk too).
+static func is_sd_card(disk: String, sys := "/sys") -> bool:
+	if not disk.begins_with("mmcblk"):
+		return false
+	return read_file(sys + "/block/" + disk + "/device/type").strip_edges() == "SD"
+
+
+## The whole content of a file, "" when it cannot be read. /proc and /sys files report a size of 0
+## (or 4096), so it is read until EOF.
+static func read_file(path: String) -> String:
+	var file := FileAccess.open(path, FileAccess.READ)
+	if not file:
+		return ""
+	var data := PackedByteArray()
+	while not file.eof_reached():
+		data.append_array(file.get_buffer(4096))
+	return data.get_string_from_utf8()
