 var _stale := true
+## The partitions the cards were built for (ShownDisks.partitions()).
+var _shown := {}
+## Reads the mount table while the menu is shown: an SD card is mounted after udisks2 reports
+## it, and a card formatted here is mounted again after, with no udisks2 signal either time.
+var _mounts_timer := Timer.new()
 
 
 # Called when the node enters the scene tree for the first time.
@@ -24,23 +34,42 @@
 
 	udisks2.unprotected_devices_updated.connect(_on_devices_updated)
 	visibility_changed.connect(_refresh)
