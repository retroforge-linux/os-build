# msm-firmware-loader — each board's own Qualcomm firmware from its Android partitions
# (postmarketOS msm-firmware-loader + make-dynpart-mappings), built FROM SOURCE via the local
# PKGBUILD; see its header. Neither is in the holo snapshot.
#
# Patches, all ours (0001-0005 from ROCKNIX's SM6115 port, 0006-0009 written here):
#   0001  slot from the GPT A/B flags of boot_a/boot_b: OpenABL boots Linux with no
#         androidboot.slot_suffix and qbootctl needs udev's by-partlabel links.
#   0002  without a fastrpc user, link the sensors registry from the plain persist mount.
#   0003  blobs only under the devicetree's device folders (qcom/<soc>/<vendor>/...), so the
#         vendor partition's venus, a630_sqe or touch firmware never shadow /lib/firmware.
#   0004  map the active slot's dynamic partitions; the Air X's factory super has data only in _a.
#   0005  no per-entry forks in the scans and links; the unit runs before udev.
#   0006  persist and dsp mounted with noload (journaled ext4, never replayed); no bluetooth.
#   0007  vendor's firmware/ before the modem's image/, compared by whole file name, as Android's
#         ueventd searches them; OEMs put rebuilt ADSPs there (Odin 3, Odin 2 Portal, RP Nova, Classic).
#   0008  fewer forks on the boot path: builtins for the cmdline and firmware path, od for the GPT,
#         the cached slot, one mkdir, one ln -s per partition directory.
#   0009  dsp, persist and the hexagonrpc tree in a second run ("hexagonrpc") for hexagonrpcd's
#         units, not before udev: rootfs/overlay's msm-firmware-loader-hexagonrpc.service.
#   0014  sns_reg_version, and a per-boot tmpfs copy of persist's sensors directory that
#         hexagonrpcd serves writable (its 0004): the Pocket FIT's sensors PD rebuilds its registry.
#   0015  LEFT OUT on this test branch (test/socinfo-without-0015): with 0016 a registry the
#         sensors PD rebuilds gets the vendor's own qsh_ble_config (UART 6 on SM8550/SM8650), and
#         this branch checks whether the ADSP sleeps with it, without the UART 99 entry (issue #46).
#   0016  ours: hexagonrpcd's socinfo as a downstream kernel has it (hw_platform, platform_subtype,
#         platform_version from debugfs's qcom_socinfo): the sensors PD picks its configs by them.
#
# After adding or bumping this: `make relock` (the package must land in rootfs/manifest.lock; it is
# listed in PKGS in rootfs/customize-base.sh).
name: msm-firmware-loader
pkgbuild_local: PKGBUILD
patches: 0001-msm-firmware-loader-read-the-active-slot-from-the-GP.patch 0002-msm-firmware-loader-link-the-sensors-registry-withou.patch 0003-msm-firmware-loader-expose-blobs-only-under-device-f.patch 0004-msm-firmware-loader-map-the-dynamic-partitions-of-th.patch 0005-msm-firmware-loader-scan-and-link-without-forking-pe.patch 0006-msm-firmware-loader-mount-persist-and-dsp-without-re.patch 0007-msm-firmware-loader-prefer-the-vendor-partition-s-bl.patch 0008-msm-firmware-loader-fork-less-on-the-boot-path.patch 0009-msm-firmware-loader-build-the-hexagonrpc-tree-after-.patch 0010-msm-firmware-loader-link-the-blobs-in-image-subfolde.patch 0011-msm-firmware-loader-serve-qcom-and-the-SoC-s-folder-.patch 0012-msm-firmware-loader-serve-Bluetooth-firmware-from-th.patch 0013-msm-firmware-loader-let-an-override-folder-win-over-.patch 0014-msm-firmware-loader-give-hexagonrpcd-a-writable-copy.patch 0016-msm-firmware-loader-give-hexagonrpcd-the-socinfo-a-d.patch
pkgrel_suffix: 1
