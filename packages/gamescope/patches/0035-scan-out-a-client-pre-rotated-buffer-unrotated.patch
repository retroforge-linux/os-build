+// A client layer drawn already turned to the panel (commit_is_pre_rotated) scans out as is, but
+// the composite samples layers in logical orientation: copy it back unrotated, once per commit.
+static gamescope::Rc<CVulkanTexture> vulkan_unrotate_layer( const gamescope::Rc<CVulkanTexture> &pTex, uint64_t ulContentID, uint32_t uSlot )
+{
+	if ( !g_uPreRotation || !g_device.supportsRotatedCopy() || !pTex || pTex->isYcbcr() || uSlot >= k_nMaxLayers )
+		return nullptr;
+
+	uint32_t uWidth = pTex->width();
+	uint32_t uHeight = pTex->height();
+	if ( g_uPreRotation & 1u )
+		std::swap( uWidth, uHeight );
+
+	struct UnrotatedLayer_t
+	{
+		gamescope::OwningRc<CVulkanTexture> pImage;
+		const CVulkanTexture *pLastSrc = nullptr;
+		uint64_t ulLastContentID = 0;
+	};
+	static UnrotatedLayer_t s_Unrotated[ k_nMaxLayers ];
+	auto &slot = s_Unrotated[ uSlot ];
+
+	if ( !slot.pImage || slot.pImage->width() != uWidth || slot.pImage->height() != uHeight || slot.pImage->drmFormat() != pTex->drmFormat() )
+	{
+		CVulkanTexture::createFlags flags;
+		flags.bSampled = true;
+		flags.bTransferDst = true;
+		flags.bTransferSrc = true;
+		slot.pImage = new CVulkanTexture();
+		slot.pLastSrc = nullptr;
+		slot.ulLastContentID = 0;
+		if ( !slot.pImage->BInit( uWidth, uHeight, 1u, pTex->drmFormat(), flags ) )
+		{
+			vk_log.errorf( "failed to allocate a %ux%u image to unrotate a pre-rotated layer", uWidth, uHeight );
+			slot.pImage = nullptr;
+			return nullptr;
+		}
+	}
+	else if ( ulContentID != 0 && slot.pLastSrc == pTex.get() && slot.ulLastContentID == ulContentID )
+	{
+		return slot.pImage.get();
+	}
+
+	auto cmdBuffer = g_device.commandBuffer();
+	cmdBuffer->blitImageRotated( pTex, slot.pImage.get(), ( 4u - g_uPreRotation ) % 4u );
+	g_device.wait( g_device.submit( std::move( cmdBuffer ) ), true );
+	slot.pLastSrc = pTex.get();
+	slot.ulLastContentID = ulContentID;
+	return slot.pImage.get();
+}
+
+// Swaps a frame's pre-rotated client layers for unrotated copies for the composite and puts
+// them back after, since the caller may still scan out or capture the frame it passed in.
+struct UnrotatedFrameScope_t
+{
+	FrameInfo_t *pFrameInfo = nullptr;
+	gamescope::Rc<CVulkanTexture> pOriginal[ k_nMaxLayers ];
+
+	explicit UnrotatedFrameScope_t( FrameInfo_t *pInfo ) : pFrameInfo( pInfo )
+	{
+		for ( int i = 0; i < pFrameInfo->layers.count() && i < k_nMaxLayers; i++ )
+		{
+			FrameInfo_t::Layer_t &layer = pFrameInfo->layers.get( i );
+			if ( !layer.bPreRotated || !layer.tex )
+				continue;
+			gamescope::Rc<CVulkanTexture> pUnrotated = vulkan_unrotate_layer( layer.tex, layer.ulContentID, i );
+			if ( !pUnrotated )
+				continue;
+			pOriginal[ i ] = layer.tex;
+			layer.tex = pUnrotated;
+			layer.bPreRotated = false;
+		}
+	}
+
+	~UnrotatedFrameScope_t()
+	{
+		for ( int i = 0; i < pFrameInfo->layers.count() && i < k_nMaxLayers; i++ )
+		{
+			if ( !pOriginal[ i ] )
+				continue;
+			FrameInfo_t::Layer_t &layer = pFrameInfo->layers.get( i );
+			layer.tex = pOriginal[ i ];
+			layer.bPreRotated = true;
+		}
+	}
+};
