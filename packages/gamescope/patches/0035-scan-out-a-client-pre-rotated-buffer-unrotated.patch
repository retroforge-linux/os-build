+// A buffer the client drew already turned to the panel: its transform is the rotation the
+// display needs (wl_output_transform 90/180/270 matches g_uPreRotation 1/2/3, the convention
+// of Mesa's vk_wsi_wayland_prerotate and of our rotated copy). It is scanned out unrotated and
+// placed as its unrotated self; the composite turns it back if the frame has to composite.
+static bool
+commit_is_pre_rotated( const commit_t *commit, const gamescope::Rc<CVulkanTexture> &tex )
+{
+	return g_uPreRotation != 0 && commit->uBufferTransform == g_uPreRotation &&
+		tex != nullptr && tex == commit->vulkanTex;
+}
