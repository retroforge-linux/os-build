# mesa — built FROM SOURCE off the upstream RELEASE TARBALL via a qforge-owned PKGBUILD,
# NOT fetched from the holo monorepo and NOT a git clone. holo ships an old (25.2.7), all-driver
# mesa; qforge only targets Qualcomm Adreno, so packages/mesa/PKGBUILD builds just the freedreno
# gallium (GL) driver + the freedreno Vulkan driver (Turnip) from the latest mesa release, LLVM/
# rust and every other driver off. build-overlay.sh sees `pkgbuild_local` below and uses that
# checked-in PKGBUILD instead of curl'ing one; makepkg still downloads the tarball named in it.
#
# This is the "local PKGBUILD" counterpart of gamescope/source.pin (which fetches a holo PKGBUILD).
#
# Fields:
#   name           pkgbase (must match the PKGBUILD); also the work/ build-dir name
#   pkgbuild_local path (relative to this dir) to the checked-in PKGBUILD to build
#   pkgrel_suffix  numeric suffix appended to the PKGBUILD's pkgrel (N -> N.<suffix>) so pacman
#                  prefers our build on later upgrades. Integer only (makepkg requires
#                  pkgrel = integer[.integer]).
#   patches        space-separated files under ./patches/, applied `patch -p1` in the mesa source
#                  root (after the first `cd` in prepare()), in the order listed. See
#                  ./patches/README.md for what each one is and when it can be dropped.
#
# Upstream source (informational; the URL + sha also live in the PKGBUILD):
#   url:    https://archive.mesa3d.org/mesa-26.2.4.tar.xz
#   sha256: bce5f7fbebb934373b86c999a064d52fb5065878dc57f287f95346648ec832e9
#
# To bump mesa: edit pkgver (and the tarball sha256) in packages/mesa/PKGBUILD, update the
# url/sha256 lines above, and re-roll any patches under ./patches/ against the new tag.
name: mesa
pkgbuild_local: PKGBUILD
pkgrel_suffix: 1
patches: 0001-add-a830-chip-id.patch 0002-tu-implement-VK_QCOM_rotated_copy_commands.patch 0003-wsi-wayland-sort-surface-formats-by-preference.patch 0004-wsi-add-vkCmdBlitImage2-to-the-dispatch-table.patch 0005-wsi-wayland-support-rotated-preTransform.patch 0006-wsi-wayland-add-optional-pre-rotated-presents.patch 0007-wsi-wayland-keep-the-modifier-on-feedback-changes-wh.patch 0008-gallium-add-rotation-to-pipe_blit_info.patch 0009-util-blitter-support-rotated-blits.patch 0010-freedreno-support-rotated-blits.patch 0011-dri-pass-rotation-through-dri2_blit_image.patch 0012-egl-wayland-add-optional-pre-rotated-presents.patch 0013-wsi-wayland-resend-a-rotated-buffer-transform-with-e.patch
