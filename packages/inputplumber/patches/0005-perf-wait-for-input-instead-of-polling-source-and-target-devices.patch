+    /// Wait until fd (the device) or waker (a command was sent) is readable, or
+    /// IDLE_WAIT_MS has passed.
+    fn wait_for_input(fd: RawFd, waker: &EventFd) {
+        // SAFETY: the device owning fd outlives this call (it is borrowed by the
+        // run loop for as long as the loop runs).
+        let device = unsafe { BorrowedFd::borrow_raw(fd) };
+        let mut fds = [
+            PollFd::new(device, PollFlags::POLLIN),
+            PollFd::new(waker.as_fd(), PollFlags::POLLIN),
+        ];
+        let timeout = PollTimeout::from(IDLE_WAIT_MS);
+        if let Err(e) = poll(&mut fds, timeout) {
+            if e != Errno::EINTR {
+                log::debug!("Failed to wait for input: {e}");
+                thread::sleep(POLL_RATE);
+            }
+            return;
+        }
+        if fds[1]
+            .revents()
+            .is_some_and(|r| r.contains(PollFlags::POLLIN))
+        {
+            let _ = waker.read();
+        }
+    }
