+
+/// A target's [TargetOutputDevice::output_fd], for [AsyncFd]
+struct OutputFd(RawFd);
+
+impl AsRawFd for OutputFd {
+    fn as_raw_fd(&self) -> RawFd {
+        self.0
+    }
+}
+
+/// Whether fd has input to read now.
+fn has_input(fd: RawFd) -> bool {
+    // SAFETY: fd is a target device's, open for as long as the target runs.
+    let fd = unsafe { BorrowedFd::borrow_raw(fd) };
+    let mut fds = [PollFd::new(fd, PollFlags::POLLIN)];
+    matches!(poll(&mut fds, PollTimeout::ZERO), Ok(n) if n > 0)
+}
+
+/// Resolves when fd is readable; never without one.
+async fn output_readable(
+    fd: &Option<AsyncFd<OutputFd>>,
+) -> io::Result<AsyncFdReadyGuard<'_, OutputFd>> {
+    match fd {
+        Some(fd) => fd.readable().await,
+        None => std::future::pending().await,
+    }
 }
 
